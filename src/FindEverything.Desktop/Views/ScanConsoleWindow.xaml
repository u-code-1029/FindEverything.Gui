<ui:FluentWindow
    x:Class="FindEverything.Desktop.Views.ScanConsoleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:FindEverything.Desktop.ViewModels"
    Title="탐색 로그"
    Width="1120"
    Height="680"
    MinWidth="760"
    MinHeight="420"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ShowInTaskbar="False"
    WindowBackdropType="None"
    WindowCornerPreference="Default"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="ConsoleTitleBar"
            Title="탐색 로그 · 실제로 방문한 폴더와 프로필 판정" />

        <Border
            Grid.Row="1"
            Padding="12,8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="8"
                        Height="8"
                        Margin="0,0,8,0"
                        Background="{Binding StatusBrush}"
                        CornerRadius="4" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding StatusText}" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding SessionSummary}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ui:ToggleSwitch
                    Grid.Column="1"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="새 로그 자동 스크롤"
                    IsChecked="{Binding AutoScroll}"
                    OffContent="자동 스크롤 끔"
                    OnContent="자동 스크롤" />
                <ui:Button
                    Grid.Column="2"
                    MinWidth="92"
                    Margin="0,0,8,0"
                    Command="{Binding CopyAllCommand}"
                    Content="전체 복사" />
                <ui:Button
                    Grid.Column="3"
                    MinWidth="92"
                    Appearance="Secondary"
                    Command="{Binding ClearCommand}"
                    Content="로그 지우기" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1E1E1E">
            <ListBox
                x:Name="TraceList"
                Padding="8,6"
                AutomationProperties.Name="방문 폴더 탐색 로그"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="Cascadia Mono,Consolas"
                FontSize="13"
                ItemsSource="{Binding Lines}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,2" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ScanConsoleLineViewModel}">
                        <TextBlock
                            Text="{Binding Text}"
                            TextWrapping="NoWrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#D4D4D4" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Match}">
                                            <Setter Property="Foreground" Value="#89D185" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.NoMatch}">
                                            <Setter Property="Foreground" Value="#9D9D9D" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Pruned}">
                                            <Setter Property="Foreground" Value="#DCDCAA" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Error}">
                                            <Setter Property="Foreground" Value="#F48771" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Lifecycle}">
                                            <Setter Property="Foreground" Value="#75BEFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border
            Grid.Row="3"
            Padding="12,7"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="방문 " />
                        <Run FontWeight="SemiBold" Text="{Binding VisitedCount}" />
                        <Run Text="  ·  일치 " />
                        <Run FontWeight="SemiBold" Text="{Binding MatchedCount}" />
                        <Run Text="  ·  규칙 외 " />
                        <Run FontWeight="SemiBold" Text="{Binding NoMatchCount}" />
                        <Run Text="  ·  변환 오류 " />
                        <Run FontWeight="SemiBold" Text="{Binding InvalidCount}" />
                        <Run Text="  ·  하위 탐색 생략 " />
                        <Run FontWeight="SemiBold" Text="{Binding PrunedCount}" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="MATCH 일치 · NO MATCH 규칙 외 · INVALID 변환 오류 · PRUNE 하위 탐색 중단" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding RetentionSummary}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
