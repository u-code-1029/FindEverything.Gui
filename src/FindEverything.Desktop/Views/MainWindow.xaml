<ui:FluentWindow
    x:Class="FindEverything.Desktop.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="clr-namespace:FindEverything.Desktop.Localization"
    xmlns:pages="clr-namespace:FindEverything.Desktop.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ApplicationTitle}"
    Width="1360"
    Height="860"
    Language="{StaticResource Loc.Culture.XmlLanguage}"
    MinWidth="960"
    MinHeight="640"
    localization:LocalizationScope.IsEnabled="True"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="None"
    WindowCornerPreference="Default"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <ui:NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsFooterSeparatorVisible="True"
            IsPaneToggleVisible="True"
            IsTopSeparatorVisible="False"
            OpenPaneLength="220"
            FrameMargin="0"
            Padding="0"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=AppTitleBar}"
            Transition="FadeInWithSlide">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="파일 찾기"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="files"
                    TargetPageType="{x:Type pages:FilesPage}" />
                <ui:NavigationViewItem
                    x:Name="CatalogNavigationItem"
                    AutomationProperties.Name="구조화 보기"
                    Content="구조화 보기"
                    Icon="{ui:SymbolIcon Symbol=TableSimple24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="catalog"
                    TargetPageType="{x:Type pages:CatalogPage}">
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge
                            x:Name="CatalogScanBadge"
                            AutomationProperties.Name="구조화 보기 스캔 진행 중"
                            AutomationProperties.LiveSetting="Polite"
                            ToolTip="구조화 보기에서 폴더를 스캔하고 있습니다."
                            Visibility="{Binding Catalog.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:InfoBadge.Style>
                                <Style TargetType="{x:Type ui:InfoBadge}">
                                    <Setter Property="Width" Value="16" />
                                    <Setter Property="Height" Value="16" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaneOpen, ElementName=RootNavigation}" Value="False">
                                            <Setter Property="Width" Value="40" />
                                            <Setter Property="Height" Value="40" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:InfoBadge.Style>
                            <ui:InfoBadge.Template>
                                <ControlTemplate TargetType="{x:Type ui:InfoBadge}">
                                    <ui:ProgressRing
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        IsIndeterminate="True"
                                        VerticalAlignment="Center" />
                                </ControlTemplate>
                            </ui:InfoBadge.Template>
                        </ui:InfoBadge>
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="프로필"
                    Icon="{ui:SymbolIcon Symbol=DocumentEdit24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="profiles"
                    TargetPageType="{x:Type pages:ProfilesPage}" />
                <ui:NavigationViewItem
                    Content="프로필 Playground"
                    Icon="{ui:SymbolIcon Symbol=DocumentSearch24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="profile-playground"
                    TargetPageType="{x:Type pages:ProfilePlaygroundPage}" />
                <ui:NavigationViewItem
                    Content="출력 포맷"
                    Icon="{ui:SymbolIcon Symbol=ClipboardTask24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="output-formats"
                    TargetPageType="{x:Type pages:OutputFormatsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="설정"
                    Icon="{ui:SymbolIcon Symbol=Settings24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="settings"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:TitleBar
            x:Name="AppTitleBar"
            Panel.ZIndex="1"
            Title="{Binding ApplicationTitle}">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Margin="0,0,8,0"
                        Padding="2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="6"
                        ToolTip="{Binding LanguageRestartHint}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                MinWidth="38"
                                Height="28"
                                Padding="8,0"
                                AutomationProperties.Name="한국어로 전환"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="ko-KR"
                                Content="KO">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKorean}" Value="True">
                                                <Setter Property="Appearance" Value="Secondary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button
                                MinWidth="38"
                                Height="28"
                                Padding="8,0"
                                AutomationProperties.Name="영어로 전환"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="en-US"
                                Content="EN">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                                <Setter Property="Appearance" Value="Secondary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                    <ui:Button
                        x:Name="ScanConsoleToggleButton"
                        Width="40"
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="0"
                        AutomationProperties.ItemStatus="{Binding ScanConsole.PanelToggleToolTip}"
                        AutomationProperties.Name="{Binding ScanConsole.PanelToggleToolTip}"
                        Command="{Binding ToggleScanConsoleCommand}"
                        Icon="{ui:SymbolIcon Symbol=PanelBottom20}"
                        ToolTip="{Binding ScanConsole.PanelToggleToolTip}">
                        <ui:Button.Style>
                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanConsole.IsPanelOpen}" Value="True">
                                        <Setter Property="Appearance" Value="Secondary" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScanConsole.IsActivityAttentionRequested}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="ScanConsoleAttentionStoryboard">
                                                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1"
                                                        To="0.55"
                                                        Duration="0:0:0.55" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="ScanConsoleAttentionStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:ContentDialogHost
            x:Name="DialogHost"
            Panel.ZIndex="10" />
    </Grid>
</ui:FluentWindow>
