<ui:FluentWindow
    x:Class="FindEverything.Desktop.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="clr-namespace:FindEverything.Desktop.Localization"
    xmlns:pages="clr-namespace:FindEverything.Desktop.Views.Pages"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ApplicationTitle}"
    Width="1360"
    Height="860"
    Language="{StaticResource Loc.Culture.XmlLanguage}"
    MinWidth="760"
    MinHeight="640"
    localization:LocalizationScope.IsEnabled="True"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    SizeChanged="OnWindowSizeChanged"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="None"
    WindowCornerPreference="Default"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <ui:NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsFooterSeparatorVisible="True"
            IsPaneToggleVisible="True"
            IsTopSeparatorVisible="False"
            OpenPaneLength="220"
            FrameMargin="0"
            Padding="0"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=AppTitleBar}"
            Transition="FadeInWithSlide">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    AutomationProperties.Name="{DynamicResource Loc.Home.Nav}"
                    Content="{DynamicResource Loc.Home.Nav}"
                    Icon="{ui:SymbolIcon Symbol=HomeDatabase24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="home"
                    TargetPageType="{x:Type pages:HomePage}"
                    ToolTip="{DynamicResource Loc.Home.Nav}" />
                <ui:NavigationViewItem
                    AutomationProperties.Name="{DynamicResource Loc.Shell.Nav.Files}"
                    Content="{DynamicResource Loc.Shell.Nav.Files}"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="files"
                    TargetPageType="{x:Type pages:FilesPage}"
                    ToolTip="{DynamicResource Loc.Shell.Nav.Files}" />
                <ui:NavigationViewItem
                    x:Name="CatalogNavigationItem"
                    AutomationProperties.Name="{DynamicResource Loc.Shell.Nav.Catalog}"
                    Content="{DynamicResource Loc.Shell.Nav.Catalog}"
                    Icon="{ui:SymbolIcon Symbol=TableSimple24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="catalog"
                    TargetPageType="{x:Type pages:CatalogPage}"
                    ToolTip="{DynamicResource Loc.Shell.Nav.Catalog}">
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge
                            x:Name="CatalogScanBadge"
                            AutomationProperties.Name="{DynamicResource Loc.Shell.Catalog.ScanInProgress.Name}"
                            AutomationProperties.LiveSetting="Polite"
                            ToolTip="{DynamicResource Loc.Shell.Catalog.ScanInProgress.ToolTip}"
                            Visibility="{Binding Catalog.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:InfoBadge.Style>
                                <Style TargetType="{x:Type ui:InfoBadge}">
                                    <Setter Property="Width" Value="16" />
                                    <Setter Property="Height" Value="16" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaneOpen, ElementName=RootNavigation}" Value="False">
                                            <Setter Property="Width" Value="40" />
                                            <Setter Property="Height" Value="40" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:InfoBadge.Style>
                            <ui:InfoBadge.Template>
                                <ControlTemplate TargetType="{x:Type ui:InfoBadge}">
                                    <ui:ProgressRing
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        IsIndeterminate="True"
                                        VerticalAlignment="Center" />
                                </ControlTemplate>
                            </ui:InfoBadge.Template>
                        </ui:InfoBadge>
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    AutomationProperties.Name="{DynamicResource Loc.Shell.Nav.Profiles}"
                    Content="{DynamicResource Loc.Shell.Nav.Profiles}"
                    Icon="{ui:SymbolIcon Symbol=DocumentEdit24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="profiles"
                    TargetPageType="{x:Type pages:ProfilesPage}"
                    ToolTip="{DynamicResource Loc.Shell.Nav.Profiles}" />
                <ui:NavigationViewItem
                    AutomationProperties.Name="{DynamicResource Loc.Shell.Nav.Playground}"
                    Content="{DynamicResource Loc.Shell.Nav.Playground}"
                    Icon="{ui:SymbolIcon Symbol=DocumentSearch24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="profile-playground"
                    TargetPageType="{x:Type pages:ProfilePlaygroundPage}"
                    ToolTip="{DynamicResource Loc.Shell.Nav.Playground}" />
                <ui:NavigationViewItem
                    AutomationProperties.Name="{DynamicResource Loc.Shell.Nav.OutputFormats}"
                    Content="{DynamicResource Loc.Shell.Nav.OutputFormats}"
                    Icon="{ui:SymbolIcon Symbol=ClipboardTask24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="output-formats"
                    TargetPageType="{x:Type pages:OutputFormatsPage}"
                    ToolTip="{DynamicResource Loc.Shell.Nav.OutputFormats}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    AutomationProperties.Name="{DynamicResource Loc.Shell.Nav.Settings}"
                    Content="{DynamicResource Loc.Shell.Nav.Settings}"
                    Icon="{ui:SymbolIcon Symbol=Settings24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="settings"
                    TargetPageType="{x:Type pages:SettingsPage}"
                    ToolTip="{DynamicResource Loc.Shell.Nav.Settings}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <!-- The page-only overlay never reserves layout space. Its null
                     background lets pointer events pass outside the notice. -->
                <Grid x:Name="PageNotificationOverlay">
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" Visibility="Collapsed" />
                    <ui:InfoBar
                        x:Name="OperationInfoBar"
                        Margin="16,0,16,16"
                        MaxWidth="480"
                        HorizontalAlignment="Right"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="{Binding Title}"
                        IsClosable="True"
                        IsOpen="{Binding IsOpen, Mode=TwoWay}"
                        IsVisibleChanged="OnOperationInfoBarVisibilityChanged"
                        Message="{Binding Message}"
                        Severity="{Binding Severity}"
                        SizeChanged="OnOperationInfoBarSizeChanged"
                        Title="{Binding Title}"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:InfoBar.Template>
                            <ControlTemplate TargetType="{x:Type ui:InfoBar}">
                                <Border
                                    Padding="12,8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <ui:TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                FontWeight="SemiBold"
                                                Text="{TemplateBinding Title}"
                                                TextWrapping="Wrap" />
                                            <ui:TextBlock
                                                Margin="0,2,0,0"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{TemplateBinding Message}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:Button
                                            Grid.Column="1"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Appearance="Transparent"
                                            AutomationProperties.Name="{DynamicResource Loc.Workspace.Notifications.Dismiss}"
                                            Command="{Binding DismissCommand}"
                                            Icon="{ui:SymbolIcon Symbol=Dismiss20}"
                                            ToolTip="{DynamicResource Loc.Workspace.Notifications.Dismiss}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ui:InfoBar.Template>
                    </ui:InfoBar>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:TitleBar
            x:Name="AppTitleBar"
            Panel.ZIndex="1"
            Title="{Binding ApplicationTitle}">
            <ui:TitleBar.TrailingContent>
                <StackPanel
                    x:Name="TitleBarActions"
                    MinWidth="124"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <controls:DisplayBadge
                        Margin="0,0,8,0"
                        Padding="2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="6"
                        ToolTip="{Binding LanguageRestartHint}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                MinWidth="36"
                                Height="28"
                                Padding="8,0"
                                AutomationProperties.Name="{DynamicResource Loc.Shell.Language.Korean}"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="ko-KR"
                                Content="KO">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKorean}" Value="True">
                                                <Setter Property="Appearance" Value="Secondary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button
                                MinWidth="36"
                                Height="28"
                                Padding="8,0"
                                AutomationProperties.Name="{DynamicResource Loc.Shell.Language.English}"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="en-US"
                                Content="EN">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                                <Setter Property="Appearance" Value="Secondary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </controls:DisplayBadge>
                    <ui:Button
                        x:Name="ScanConsoleToggleButton"
                        Width="36"
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="0"
                        AutomationProperties.ItemStatus="{Binding ScanConsole.PanelToggleToolTip}"
                        AutomationProperties.Name="{Binding ScanConsole.PanelToggleToolTip}"
                        Command="{Binding ToggleScanConsoleCommand}"
                        Icon="{ui:SymbolIcon Symbol=PanelBottom20}"
                        ToolTip="{Binding ScanConsole.PanelToggleToolTip}">
                        <ui:Button.Style>
                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanConsole.IsPanelOpen}" Value="True">
                                        <Setter Property="Appearance" Value="Secondary" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScanConsole.IsActivityAttentionRequested}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="ScanConsoleAttentionStoryboard">
                                                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1"
                                                        To="0.55"
                                                        Duration="0:0:0.55" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="ScanConsoleAttentionStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:ContentDialogHost
            x:Name="DialogHost"
            Panel.ZIndex="10" />
    </Grid>
</ui:FluentWindow>
