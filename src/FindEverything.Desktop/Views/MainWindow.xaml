<ui:FluentWindow
    x:Class="FindEverything.Desktop.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:FindEverything.Desktop.Views.Pages"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ApplicationTitle}"
    Width="1360"
    Height="860"
    Language="{StaticResource Loc.Culture.XmlLanguage}"
    MinWidth="760"
    MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    SizeChanged="OnWindowSizeChanged"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="None"
    WindowCornerPreference="Default"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <ui:NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsFooterSeparatorVisible="False"
            IsPaneToggleVisible="True"
            IsTopSeparatorVisible="False"
            OpenPaneLength="220"
            FrameMargin="0"
            Padding="0"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=AppTitleBar}"
            Transition="None">
            <ui:NavigationView.Resources>
                <!-- Keep WPF-UI's native navigation template, compact badge
                     alignment, focus treatment and selection indicator. -->
                <Style TargetType="ui:NavigationViewItem" BasedOn="{StaticResource NavigationViewItemDefaultStyle}">
                    <Setter Property="Border.CornerRadius" Value="8" />
                    <Setter Property="Margin" Value="0,2,0,2" />
                </Style>
            </ui:NavigationView.Resources>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItemHeader Text="{DynamicResource Loc.Ux.Shell.Nav.Work}" Visibility="{Binding IsPaneOpen, ElementName=RootNavigation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:NavigationViewItem
                    AutomationProperties.Name="{StaticResource Loc.Home.Nav}"
                    Content="{StaticResource Loc.Home.Nav}"
                    Icon="{ui:SymbolIcon Symbol=HomeDatabase24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="home"
                    TargetPageType="{x:Type pages:HomePage}"
                    ToolTip="{StaticResource Loc.Home.Nav}" />
                <ui:NavigationViewItem
                    AutomationProperties.Name="{StaticResource Loc.Shell.Nav.Files}"
                    Content="{StaticResource Loc.Shell.Nav.Files}"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="files"
                    TargetPageType="{x:Type pages:FilesPage}"
                    ToolTip="{StaticResource Loc.Shell.Nav.Files}">
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge x:Name="FilesScanBadge"
                            AutomationProperties.Name="{DynamicResource Loc.Ux.Shell.Scan.Files}" AutomationProperties.LiveSetting="Polite"
                            ToolTip="{DynamicResource Loc.Ux.Shell.Scan.Files}"
                            Visibility="{Binding Catalog.IsFilesScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:InfoBadge.Style><Style TargetType="ui:InfoBadge"><Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /><Style.Triggers><DataTrigger Binding="{Binding IsPaneOpen, ElementName=RootNavigation}" Value="False"><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /></DataTrigger></Style.Triggers></Style></ui:InfoBadge.Style>
                            <ui:InfoBadge.Template><ControlTemplate TargetType="ui:InfoBadge"><ui:ProgressRing Width="16" Height="16" IsIndeterminate="{Binding Catalog.IsFilesScanning}" HorizontalAlignment="Center" VerticalAlignment="Center" /></ControlTemplate></ui:InfoBadge.Template>
                        </ui:InfoBadge>
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    x:Name="CatalogNavigationItem"
                    AutomationProperties.Name="{StaticResource Loc.Shell.Nav.Catalog}"
                    Content="{StaticResource Loc.Shell.Nav.Catalog}"
                    Icon="{ui:SymbolIcon Symbol=TableSimple24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="catalog"
                    TargetPageType="{x:Type pages:CatalogPage}"
                    ToolTip="{StaticResource Loc.Shell.Nav.Catalog}">
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge
                            x:Name="CatalogScanBadge"
                            AutomationProperties.Name="{StaticResource Loc.Shell.Catalog.ScanInProgress.Name}"
                            AutomationProperties.LiveSetting="Polite"
                            ToolTip="{StaticResource Loc.Shell.Catalog.ScanInProgress.ToolTip}"
                            Visibility="{Binding Catalog.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:InfoBadge.Style>
                                <Style TargetType="{x:Type ui:InfoBadge}">
                                    <Setter Property="Width" Value="16" />
                                    <Setter Property="Height" Value="16" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaneOpen, ElementName=RootNavigation}" Value="False">
                                            <Setter Property="Width" Value="40" />
                                            <Setter Property="Height" Value="40" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:InfoBadge.Style>
                            <ui:InfoBadge.Template>
                                <ControlTemplate TargetType="{x:Type ui:InfoBadge}">
                                    <ui:ProgressRing
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        IsIndeterminate="{Binding Catalog.IsScanning}"
                                        VerticalAlignment="Center" />
                                </ControlTemplate>
                            </ui:InfoBadge.Template>
                        </ui:InfoBadge>
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>
                <ui:NavigationViewItemHeader Text="{DynamicResource Loc.Ux.Shell.Nav.Manage}" Visibility="{Binding IsPaneOpen, ElementName=RootNavigation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:NavigationViewItem
                    AutomationProperties.Name="{StaticResource Loc.Shell.Nav.Profiles}"
                    Content="{StaticResource Loc.Shell.Nav.Profiles}"
                    Icon="{ui:SymbolIcon Symbol=DocumentEdit24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="profiles"
                    TargetPageType="{x:Type pages:ProfilesPage}"
                    ToolTip="{StaticResource Loc.Shell.Nav.Profiles}" />
                <ui:NavigationViewItem
                    AutomationProperties.Name="{StaticResource Loc.Shell.Nav.Playground}"
                    Content="{StaticResource Loc.Shell.Nav.Playground}"
                    Icon="{ui:SymbolIcon Symbol=DocumentSearch24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="profile-playground"
                    TargetPageType="{x:Type pages:ProfilePlaygroundPage}"
                    ToolTip="{StaticResource Loc.Shell.Nav.Playground}" />
                <ui:NavigationViewItem
                    AutomationProperties.Name="{StaticResource Loc.Shell.Nav.OutputFormats}"
                    Content="{StaticResource Loc.Shell.Nav.OutputFormats}"
                    Icon="{ui:SymbolIcon Symbol=ClipboardTask24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="output-formats"
                    TargetPageType="{x:Type pages:OutputFormatsPage}"
                    ToolTip="{StaticResource Loc.Shell.Nav.OutputFormats}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    AutomationProperties.Name="{StaticResource Loc.Shell.Nav.Settings}"
                    Content="{StaticResource Loc.Shell.Nav.Settings}"
                    Icon="{ui:SymbolIcon Symbol=Settings24}"
                    NavigationCacheMode="Required"
                    TargetPageTag="settings"
                    TargetPageType="{x:Type pages:SettingsPage}"
                    ToolTip="{StaticResource Loc.Shell.Nav.Settings}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <!-- The page-only overlay never reserves layout space. Its null
                     background lets pointer events pass outside the notice. -->
                <Grid x:Name="PageNotificationOverlay">
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" Visibility="Collapsed" />
                    <ui:InfoBar
                        x:Name="OperationInfoBar"
                        Margin="16,0,16,16"
                        MaxWidth="480"
                        HorizontalAlignment="Right"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="{Binding Title}"
                        IsClosable="True"
                        IsOpen="{Binding IsOpen, Mode=TwoWay}"
                        IsVisibleChanged="OnOperationInfoBarVisibilityChanged"
                        MouseEnter="OnNoticeInteractionChanged" MouseLeave="OnNoticeInteractionChanged"
                        IsKeyboardFocusWithinChanged="OnNoticeFocusChanged"
                        Message="{Binding Message}"
                        Severity="{Binding Severity}"
                        SizeChanged="OnOperationInfoBarSizeChanged"
                        Title="{Binding Title}"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:InfoBar.Template>
                            <ControlTemplate TargetType="{x:Type ui:InfoBar}">
                                <Border
                                    Padding="16,12"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource SurfaceCornerRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <ui:SymbolIcon Symbol="{Binding SeveritySymbol}" FontSize="16" Margin="0,0,6,0" />
                                                <ui:TextBlock Text="{Binding SeverityName}" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <ui:TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                FontWeight="SemiBold"
                                                Text="{TemplateBinding Title}"
                                                MaxHeight="80"
                                                TextWrapping="Wrap" />
                                            <ui:TextBlock
                                                Margin="0,2,0,0"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{TemplateBinding Message}"
                                                MaxHeight="140"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:Button
                                            Grid.Column="1"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Appearance="Transparent"
                                            AutomationProperties.Name="{StaticResource Loc.Workspace.Notifications.Dismiss}"
                                            Command="{Binding DismissCommand}"
                                            Icon="{ui:SymbolIcon Symbol=Dismiss20}"
                                            ToolTip="{StaticResource Loc.Workspace.Notifications.Dismiss}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ui:InfoBar.Template>
                    </ui:InfoBar>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:TitleBar
            x:Name="AppTitleBar"
            Panel.ZIndex="1"
            Title="{Binding ApplicationTitle}">
            <ui:TitleBar.TrailingContent>
                <StackPanel
                    x:Name="TitleBarActions"
                    MinWidth="124"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0" Padding="8,0" Height="28" Appearance="Transparent"
                        Content="{Binding PendingLanguageLabel}" ToolTip="{Binding PendingLanguageHint}"
                        AutomationProperties.Name="{Binding PendingLanguageHint}"
                        Command="{Binding ApplyPendingLanguageCommand}"
                        Visibility="{Binding HasPendingLanguage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <controls:DisplayBadge
                        Margin="0,0,8,0"
                        Padding="2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8"
                        ToolTip="{Binding LanguageRestartHint}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                MinWidth="36"
                                Height="28"
                                Padding="8,0"
                                AutomationProperties.Name="{StaticResource Loc.Shell.Language.Korean}"
                                AutomationProperties.ItemStatus="{Binding KoreanSelectionState}"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="ko-KR"
                                Content="KO">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKorean}" Value="True">
                                                <Setter Property="Appearance" Value="Secondary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button
                                MinWidth="36"
                                Height="28"
                                Padding="8,0"
                                AutomationProperties.Name="{StaticResource Loc.Shell.Language.English}"
                                AutomationProperties.ItemStatus="{Binding EnglishSelectionState}"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="en-US"
                                Content="EN">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                                <Setter Property="Appearance" Value="Secondary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </controls:DisplayBadge>
                    <ui:Button x:Name="NotificationsButton" Width="36" Height="32" Margin="0,0,8,0" Padding="0"
                        Appearance="Transparent" Icon="{ui:SymbolIcon Symbol=Alert20}" Click="OnNotificationsClick"
                        AutomationProperties.Name="{DynamicResource Loc.Ux.Shell.Notifications.Title}" ToolTip="{DynamicResource Loc.Ux.Shell.Notifications.Title}" />
                    <ui:Button
                        x:Name="ScanConsoleToggleButton"
                        Width="36"
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="0"
                        AutomationProperties.ItemStatus="{Binding ScanConsole.PanelToggleToolTip}"
                        AutomationProperties.Name="{Binding ScanConsole.PanelToggleToolTip}"
                        Command="{Binding ToggleScanConsoleCommand}"
                        Visibility="{Binding IsCatalogPage, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Icon="{ui:SymbolIcon Symbol=PanelBottom20}"
                        ToolTip="{Binding ScanConsole.PanelToggleToolTip}">
                        <ui:Button.Style>
                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanConsole.IsPanelOpen}" Value="True">
                                        <Setter Property="Appearance" Value="Secondary" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScanConsole.IsActivityAttentionRequested}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                        <!-- A static unread state does not distract or override reduced-motion preferences. -->
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:Flyout x:Name="NotificationHistoryFlyout" Width="0" Height="0" MinWidth="0" MinHeight="0" Padding="16" Placement="Bottom"
            DataContext="{Binding Notifications}" PreviewKeyDown="OnNotificationHistoryKeyDown">
            <Grid Width="360" MaxHeight="340">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8"><ui:TextBlock Text="{DynamicResource Loc.Ux.Shell.Notifications.Title}" FontSize="18" FontWeight="SemiBold" />
                    <ui:TextBlock Text="{DynamicResource Loc.Ux.Shell.Notifications.HistoryHelp}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                <ListBox Grid.Row="1" MinHeight="64" MaxHeight="130" ItemsSource="{Binding RecentNotifications}" SelectedItem="{Binding SelectedNotification}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Loc.Ux.Shell.Notifications.Title}">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="{Binding Symbol}" Margin="0,0,8,0" /><ui:TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="290" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <ui:TextBox Grid.Row="2" Margin="0,8,0,8" MaxHeight="120" Text="{Binding SelectedNotification.Details, Mode=OneWay}" IsReadOnly="True" IsTextSelectionEnabled="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ClearButtonEnabled="False"
                    AutomationProperties.Name="{DynamicResource Loc.Ux.Shell.Notifications.Details}" />
                <StackPanel Grid.Row="3"><ui:Button HorizontalAlignment="Right" Command="{Binding CopyNotificationDetailsCommand}" Content="{DynamicResource Loc.Ux.Shell.Notifications.Copy}" />
                    <ui:TextBlock Text="{Binding HistoryStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></StackPanel>
            </Grid>
        </ui:Flyout>

        <ui:ContentDialogHost
            x:Name="DialogHost"
            Panel.ZIndex="10" />
    </Grid>
</ui:FluentWindow>
