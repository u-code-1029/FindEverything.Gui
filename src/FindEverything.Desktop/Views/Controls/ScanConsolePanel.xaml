<UserControl
    x:Class="FindEverything.Desktop.Views.Controls.ScanConsolePanel"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="clr-namespace:FindEverything.Desktop.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:viewModels="clr-namespace:FindEverything.Desktop.ViewModels"
    AutomationProperties.AutomationId="ScanConsolePanel"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    localization:LocalizationScope.IsEnabled="True"
    mc:Ignorable="d">
    <controls:SectionCard Style="{StaticResource FluentCardStyle}" Padding="0"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"><controls:SectionCard.Header>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon
                    Width="20"
                    Height="20"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Symbol="WindowConsole20" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="탐색 로그" />
                <ui:Button
                    Grid.Column="2"
                    MinWidth="64"
                    Padding="10,5"
                    AutomationProperties.Name="탐색 로그 닫기"
                    Appearance="Transparent"
                    Command="{Binding ClosePanelCommand}"
                    Content="닫기"
                    ToolTip="하단 탐색 로그 닫기" />
            </Grid>

            <Grid
                Grid.Row="1"
                Margin="12,8"
                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Ellipse
                            Width="8"
                            Height="8"
                            Margin="0,0,8,0"
                            Fill="{Binding StatusBrush}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding StatusText}" />
                        <TextBlock
                            x:Name="SessionSummaryText"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding SessionSummary}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ui:ToggleSwitch
                        Grid.Column="1"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="새 로그 자동 스크롤"
                        IsChecked="{Binding AutoScroll}"
                        OffContent="자동 스크롤 끔"
                        OnContent="자동 스크롤" />
                    <ui:Button
                        x:Name="CopyAllLogsButton"
                        Grid.Column="2"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Command="{Binding CopyAllCommand}"
                        Icon="{ui:SymbolIcon Symbol=Copy20}"
                        ToolTip="전체 복사"
                        Content="전체 복사" />
                    <ui:Button
                        Grid.Column="3"
                        x:Name="SaveScanLogButton"
                        MinWidth="112"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="{DynamicResource Loc.Scan.Save.Help}"
                        Command="{Binding SaveLogCommand}"
                        Content="로그 저장"
                        Icon="{ui:SymbolIcon Symbol=Save16}"
                        ToolTip="{DynamicResource Loc.Scan.Save.Help}" />
                    <ui:Button
                        x:Name="ClearLogsButton"
                        Grid.Column="4"
                        MinWidth="92"
                        Appearance="Secondary"
                        Command="{Binding ClearCommand}"
                        Icon="{ui:SymbolIcon Symbol=Delete20}"
                        ToolTip="로그 지우기"
                        Content="로그 지우기" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Background="#1E1E1E">
                <ListBox
                    x:Name="TraceList"
                    Padding="8,6"
                    AutomationProperties.Name="방문 폴더 탐색 로그"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Cascadia Mono,Consolas"
                    FontSize="13"
                    ItemsSource="{Binding Lines}"
                    PreviewMouseRightButtonDown="OnTraceListPreviewMouseRightButtonDown"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem
                                AutomationProperties.Name="선택한 로그 메시지 전체 복사"
                                Command="{Binding CopySelectedMessageCommand}"
                                Header="메시지 전체 복사" />
                            <MenuItem
                                AutomationProperties.Name="선택한 로그 경로만 복사"
                                Command="{Binding CopySelectedPathCommand}"
                                Header="경로만 복사" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ScanConsoleLineViewModel}">
                            <TextBlock Text="{Binding Text}" TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#D4D4D4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Match}">
                                                <Setter Property="Foreground" Value="#89D185" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.NoMatch}">
                                                <Setter Property="Foreground" Value="#9D9D9D" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Pruned}">
                                                <Setter Property="Foreground" Value="#DCDCAA" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Error}">
                                                <Setter Property="Foreground" Value="#F48771" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Warning}">
                                                <Setter Property="Foreground" Value="#D7BA7D" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Lifecycle}">
                                                <Setter Property="Foreground" Value="#75BEFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid
                Grid.Row="3"
                Margin="12,7"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                            <Run Text="방문 " />
                            <Run FontWeight="SemiBold" Text="{Binding VisitedCount}" />
                            <Run Text="  ·  일치 " />
                            <Run FontWeight="SemiBold" Text="{Binding MatchedCount}" />
                            <Run Text="  ·  규칙 외 " />
                            <Run FontWeight="SemiBold" Text="{Binding NoMatchCount}" />
                            <Run Text="  ·  변환 오류 " />
                            <Run FontWeight="SemiBold" Text="{Binding InvalidCount}" />
                            <Run Text="  ·  하위 탐색 생략 " />
                            <Run FontWeight="SemiBold" Text="{Binding PrunedCount}" />
                        </TextBlock>
                        <TextBlock
                            x:Name="LogLegendText"
                            Margin="0,3,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="MATCH 일치 · NO MATCH 규칙 외 · INVALID 변환 오류 · EXCLUDED 이름 규칙 제외 · PRUNE 하위 탐색 중단" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Top"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding RetentionSummary}" />
                </Grid>
            </Grid>
        </Grid>
    </controls:SectionCard.Header></controls:SectionCard>
</UserControl>
