<UserControl
    x:Class="FindEverything.Desktop.Views.Controls.ScanConsolePanel"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:viewModels="clr-namespace:FindEverything.Desktop.ViewModels"
    AutomationProperties.AutomationId="ScanConsolePanel"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <controls:SectionCard Style="{StaticResource FluentCardStyle}" Padding="0"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"><controls:SectionCard.Header>
        <Grid x:Name="ScanConsoleLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Grid Margin="12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon
                    Width="20"
                    Height="20"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Symbol="WindowConsole20" />
                <Grid Grid.Column="1" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                        Text="{StaticResource Loc.View.ScanConsolePanel.Text.ScanLog}" />
                        <ui:TextBlock
                            x:Name="SessionSummaryText"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding SessionSummary}"
                            TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SessionSummary}" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ToggleSwitch
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{StaticResource Loc.View.ScanConsolePanel.Name.AutomaticallyScrollToNewLogEntries}"
                        IsChecked="{Binding AutoScroll}"
                        OffContent="{StaticResource Loc.View.ScanConsolePanel.OffContent.AutoScrollOff}"
                        OnContent="{StaticResource Loc.View.ScanConsolePanel.OnContent.AutoScroll}" />
                    <ui:Button
                        x:Name="CopyAllLogsButton"
                        MinWidth="84" Height="32" Padding="8,4" Margin="0,0,4,0"
                        AutomationProperties.Name="{StaticResource Loc.Scan.CopyAll}"
                        Command="{Binding CopyAllCommand}"
                        Icon="{ui:SymbolIcon Symbol=Copy20}"
                        ToolTip="{StaticResource Loc.Scan.CopyAll}"
                        Content="{StaticResource Loc.Scan.CopyAll}" />
                    <ui:Button
                        x:Name="SaveScanLogButton"
                        MinWidth="84" Height="32" Padding="8,4" Margin="0,0,4,0"
                        AutomationProperties.Name="{StaticResource Loc.View.ScanConsolePanel.Content.SaveLog}"
                        Command="{Binding SaveLogCommand}"
                        Content="{StaticResource Loc.View.ScanConsolePanel.Content.SaveLog}"
                        Icon="{ui:SymbolIcon Symbol=Save16}"
                        ToolTip="{StaticResource Loc.Scan.Save.Help}" />
                    <ui:Button
                        x:Name="ClearLogsButton"
                        MinWidth="84" Height="32" Padding="8,4" Margin="0,0,4,0"
                        AutomationProperties.Name="{StaticResource Loc.Scan.Clear}"
                        Appearance="Secondary"
                        Command="{Binding ClearCommand}"
                        Icon="{ui:SymbolIcon Symbol=Delete20}"
                        ToolTip="{StaticResource Loc.Scan.Clear}"
                        Content="{StaticResource Loc.Scan.Clear}" />
                    <ui:Button Width="32" Height="32" MinWidth="0" Padding="0" Appearance="Transparent"
                        Icon="{ui:SymbolIcon Symbol=Dismiss16}"
                        AutomationProperties.Name="{StaticResource Loc.View.ScanConsolePanel.Name.CloseScanLog}"
                        Command="{Binding ClosePanelCommand}" ToolTip="{StaticResource Loc.Scan.Panel.Close}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Background="#1E1E1E">
                <ListBox
                    x:Name="TraceList"
                    Padding="8,6"
                    AutomationProperties.Name="{StaticResource Loc.View.ScanConsolePanel.Name.VisitedFolderScanLog}"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Cascadia Mono,Consolas"
                    FontSize="13"
                    ItemsSource="{Binding Lines}"
                    PreviewMouseRightButtonDown="OnTraceListPreviewMouseRightButtonDown"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <ui:MenuItem
                                AutomationProperties.Name="{StaticResource Loc.View.ScanConsolePanel.Name.CopyTheCompleteSelectedLogMessage}"
                                Command="{Binding CopySelectedMessageCommand}"
                                InputGestureText="Ctrl+C"
                                Header="{StaticResource Loc.View.ScanConsolePanel.Header.CopyFullMessage}" />
                            <ui:MenuItem
                                AutomationProperties.Name="{StaticResource Loc.View.ScanConsolePanel.Name.CopyOnlyTheSelectedLogPath}"
                                Command="{Binding CopySelectedPathCommand}"
                                InputGestureText="Ctrl+Shift+C"
                                Header="{StaticResource Loc.View.ScanConsolePanel.Header.CopyPathOnly}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ScanConsoleLineViewModel}">
                            <ui:TextBlock Text="{Binding Text}" TextWrapping="NoWrap">
                                <ui:TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#D4D4D4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Match}">
                                                <Setter Property="Foreground" Value="#89D185" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.NoMatch}">
                                                <Setter Property="Foreground" Value="#9D9D9D" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Pruned}">
                                                <Setter Property="Foreground" Value="#DCDCAA" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Error}">
                                                <Setter Property="Foreground" Value="#F48771" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Warning}">
                                                <Setter Property="Foreground" Value="#D7BA7D" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:ScanConsoleLineTone.Lifecycle}">
                                                <Setter Property="Foreground" Value="#75BEFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:TextBlock.Style>
                            </ui:TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid
                Grid.Row="2"
                Margin="12,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding StatusBrush}" />
                        <ui:TextBlock MaxWidth="120" Text="{Binding StatusText}" ToolTip="{Binding StatusText}"
                            TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                        <ui:TextBlock Grid.Column="1" x:Name="LogCountersText" VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                            <ui:TextBlock.ToolTip>
                                <StackPanel MaxWidth="520">
                                    <ui:TextBlock Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ToolTip}}" TextWrapping="Wrap" />
                                    <ui:TextBlock x:Name="LogLegendText" Margin="0,4,0,0" TextWrapping="Wrap"
                                        Text="{StaticResource Loc.View.ScanConsolePanel.Text.MATCHMatchedNOMATCHOutsideRulesINVALIDConversion}" />
                                </StackPanel>
                            </ui:TextBlock.ToolTip>
                            <Run Text="{StaticResource Loc.View.ScanConsolePanel.Text.Visited}" />
                            <Run FontWeight="SemiBold" Text="{Binding VisitedCount}" />
                            <Run Text="{StaticResource Loc.View.ScanConsolePanel.Text.Matched}" />
                            <Run FontWeight="SemiBold" Text="{Binding MatchedCount}" />
                            <Run Text="{StaticResource Loc.View.ScanConsolePanel.Text.NoMatch}" />
                            <Run FontWeight="SemiBold" Text="{Binding NoMatchCount}" />
                            <Run Text="{StaticResource Loc.View.ScanConsolePanel.Text.Invalid}" />
                            <Run FontWeight="SemiBold" Text="{Binding InvalidCount}" />
                            <Run Text="{StaticResource Loc.View.ScanConsolePanel.Text.Pruned}" />
                            <Run FontWeight="SemiBold" Text="{Binding PrunedCount}" />
                        </ui:TextBlock>
                    <ui:TextBlock
                        Grid.Column="2"
                        Margin="12,0,0,0" MaxWidth="210"
                        VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding RetentionSummary}" ToolTip="{Binding RetentionSummary}" />
            </Grid>
        </Grid>
    </controls:SectionCard.Header></controls:SectionCard>
</UserControl>
