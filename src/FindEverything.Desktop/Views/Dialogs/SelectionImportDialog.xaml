<ui:FluentWindow x:Class="FindEverything.Desktop.Views.Dialogs.SelectionImportDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="{DynamicResource Loc.SelectionImport.Open}" Width="860" Height="760" MinWidth="640" MinHeight="560"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True"
 SnapsToDevicePixels="True" UseLayoutRounding="True" WindowBackdropType="None">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="{DynamicResource Loc.SelectionImport.Open}" ShowMaximize="False" ShowMinimize="False"/>
  <ui:DynamicScrollViewer Grid.Row="1" Margin="24,8,16,0" Padding="0,0,8,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <ui:TextBlock Text="{DynamicResource Loc.SelectionImport.Explanation}" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <ui:CardControl Style="{StaticResource FluentSectionCardStyle}" Padding="16" Margin="0,0,0,12">
     <ui:CardControl.Header>
     <StackPanel>
      <ui:TextBlock Text="{DynamicResource Loc.SelectionImport.Rule}" Margin="0,0,0,8"/>
      <ComboBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch"/>
      <ui:TextBlock Text="{Binding MappingDescription}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
     </ui:CardControl.Header>
    </ui:CardControl>
    <ui:CardControl Style="{StaticResource FluentSectionCardStyle}" Padding="16" Margin="0,0,0,12">
     <ui:CardControl.Header>
     <StackPanel>
      <WrapPanel Margin="0,0,0,8">
       <ui:Button Content="{DynamicResource Loc.SelectionImport.Paste}" Command="{Binding PasteCommand}" Margin="0,0,8,0"/>
       <ui:Button Content="{DynamicResource Loc.SelectionImport.OpenFile}" Command="{Binding OpenFileCommand}"/>
      </WrapPanel>
      <ui:TextBlock Text="{Binding SourceDescription}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <ui:TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" MaxLength="16777216" AcceptsReturn="True" TextWrapping="NoWrap" Height="128" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PlaceholderText="{DynamicResource Loc.SelectionImport.Input.Placeholder}"/>
      <Grid Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Visibility="{Binding HasSheets, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ui:TextBlock Text="{DynamicResource Loc.SelectionImport.Sheet}" Margin="0,0,0,8"/>
        <ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" HorizontalAlignment="Stretch"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <ui:TextBlock Text="{DynamicResource Loc.SelectionImport.Table}" Margin="0,0,0,8"/>
        <ui:TextBox Text="{Binding TableNumber, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
       </StackPanel>
      </Grid>
     </StackPanel>
     </ui:CardControl.Header>
    </ui:CardControl>
    <ui:CardControl Style="{StaticResource FluentSectionCardStyle}" Padding="16" Margin="0,0,0,12">
     <ui:CardControl.Header>
     <StackPanel>
      <WrapPanel Margin="0,0,0,8">
       <ui:Button Content="{DynamicResource Loc.SelectionImport.Preview}" Command="{Binding PreviewCommand}" Appearance="Primary" Margin="0,0,8,0"/>
       <ui:Button Content="{DynamicResource Loc.Common.Cancel}" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      </WrapPanel>
      <ui:TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      <ui:ListView ItemsSource="{Binding PreviewRows}" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
       <ui:ListView.ItemTemplate><DataTemplate><ui:TextBlock Text="{Binding}" Padding="8,4"/></DataTemplate></ui:ListView.ItemTemplate>
      </ui:ListView>
      <ui:TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
     </ui:CardControl.Header>
    </ui:CardControl>
   </StackPanel>
  </ui:DynamicScrollViewer>
  <Grid Grid.Row="2" Margin="24,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ui:TextBlock Text="{DynamicResource Loc.SelectionImport.Apply.Help}" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <ui:Button Content="{DynamicResource Loc.Common.Close}" Command="{Binding CloseCommand}" Margin="0,0,8,0"/>
    <ui:Button Content="{DynamicResource Loc.SelectionImport.Apply}" Command="{Binding ApplyCommand}" Appearance="Primary"/>
   </StackPanel>
  </Grid>
 </Grid>
</ui:FluentWindow>
