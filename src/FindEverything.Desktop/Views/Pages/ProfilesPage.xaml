                                                                        <DataTrigger Binding="{Binding IsDateTime}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="날짜가 나뉘어 있는 방식" />
                                                            <ComboBox
                                                                AutomationProperties.Name="날짜 소스 구성"
                                                                DisplayMemberPath="DisplayName"
                                                                ItemsSource="{Binding DataContext.DateSourcePresetChoices, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                SelectedValue="{Binding DateSourcePreset, UpdateSourceTrigger=PropertyChanged}"
                                                                SelectedValuePath="Value" />

                                                            <TextBlock
                                                                Margin="0,12,0,4"
                                                                Style="{StaticResource FieldLabelStyle}"
                                                                Text="경로 속 날짜 모양" />
                                                            <ComboBox
                                                                AutomationProperties.HelpText="경로에 표시된 날짜와 같은 예시를 선택합니다. 선택한 형식은 프로필의 날짜 입력 형식으로 저장됩니다."
