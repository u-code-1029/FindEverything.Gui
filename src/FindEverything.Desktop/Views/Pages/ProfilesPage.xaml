                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,8,8" Orientation="Horizontal">
                                                            <TextBlock
                                                                Margin="0,0,4,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="18"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding Prefix}" />
