                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="경로 규칙과 일치한 각 폴더의 바로 아래 파일 중 이름 정규식과 일치하는 첫 번째 파일을 읽어 문자열 컬럼으로 만듭니다. 하위 폴더는 검색하지 않습니다."
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:Button
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
