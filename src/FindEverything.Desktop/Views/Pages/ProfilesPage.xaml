                                Margin="0,8,0,0"
                                IsIndeterminate="True"
                                Visibility="{Binding IsEditorBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        </controls:SectionCard.Header>
                    </controls:SectionCard>
                </Grid>
            </ui:TabViewItem>

            <ui:TabViewItem Header="{DynamicResource Loc.View.Profiles.Header.LoadStatus}">
                <!-- Inspection booleans are getter-only. Grid IsReadOnly does not
                     override the CheckBox IsChecked default TwoWay binding. -->
                <ui:DynamicScrollViewer
                    x:Name="ProfileLoadStatusScrollViewer"
                    Style="{StaticResource FluentGutteredScrollViewerStyle}">
                    <StackPanel Margin="0,8,0,24">
                        <StackPanel>
                            <controls:SectionCard x:Name="LoadedProfilesCard" Style="{StaticResource EditorSectionStyle}">
                                <controls:SectionCard.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.ProfileLoadStatus}" AutomationProperties.HeadingLevel="Level2" />
                                    <ui:TextBlock
                                        Grid.Row="1"
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{DynamicResource Loc.View.Profiles.Text.SelectAProfileAvailableToTheApp}" TextWrapping="Wrap" />
                                    <ui:DataGrid
                                        Grid.Row="2"
                                        MinHeight="280"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        HeadersVisibility="Column"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding Profiles}"
                                        PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        SelectedItem="{Binding SelectedProfile}"
                                        SelectionMode="Single"
                                        Style="{StaticResource FluentDataGridStyle}">
                                        <ui:DataGrid.Columns>
                                            <DataGridTextColumn Width="*" Binding="{Binding DisplayName}" Header="{DynamicResource Loc.View.Profiles.Header.DisplayName}" MinWidth="140" />
                                            <DataGridTextColumn Width="90" Binding="{Binding Kind}" Header="{DynamicResource Loc.View.Profiles.Header.DefinitionType}" />
                                        </ui:DataGrid.Columns>
                                    </ui:DataGrid>
                                </Grid>
                                </controls:SectionCard.Header>
                            </controls:SectionCard>

                            <StackPanel>
                                <controls:SectionCard Style="{StaticResource EditorSectionStyle}">
                                    <controls:SectionCard.Header>
                                    <StackPanel>
                                        <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.SelectedProfile}" />
                                        <ui:TextBlock
                                            Margin="0,4,0,12"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding SelectedProfile.Id, StringFormat={StaticResource Loc.Profiles.ProfileIdFormat}}"
                                            TextTrimming="CharacterEllipsis" />
                                        <WrapPanel>
                                            <StackPanel MinWidth="120" Margin="0,0,16,8">
                                                <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Loc.View.Profiles.Text.Version}" />
                                                <ui:TextBlock Text="{Binding SelectedProfile.Version}" />
                                            </StackPanel>
                                            <StackPanel MinWidth="120" Margin="0,0,16,8">
                                                <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Loc.View.Profiles.Text.SearchTarget}" />
                                                <ui:TextBlock Text="{Binding SelectedProfile.CandidateKind}" />
                                            </StackPanel>
                                            <StackPanel MinWidth="100" Margin="0,0,16,8">
                                                <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Loc.View.Profiles.Text.ColumnCount}" />
                                                <ui:TextBlock Text="{Binding SelectedProfile.FieldCount}" />
                                            </StackPanel>
                                            <StackPanel MinWidth="120" Margin="0,0,0,8">
                                                <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Loc.View.Profiles.Text.FolderExclusionRules}" />
                                                <ui:TextBlock Text="{Binding SelectedProfile.ExcludedDirectoryRuleCount}" />
                                            </StackPanel>
                                            <StackPanel MinWidth="120" Margin="16,0,0,8">
                                                <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Loc.View.Profiles.Text.TextFileValues}" />
                                                <ui:TextBlock Text="{Binding SelectedProfile.TextFileFieldCount}" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                    </controls:SectionCard.Header>
                                </controls:SectionCard>

                                <controls:SectionCard Style="{StaticResource EditorSectionStyle}">
                                    <controls:SectionCard.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.ResultColumns}" />
                                        <ui:DataGrid
                                            Grid.Row="1"
                                            Margin="0,12,0,0"
                                            MinHeight="160"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding Fields}"
                                            x:Name="ProfileFieldsInspectionGrid"
                                            PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            Style="{StaticResource FluentDataGridStyle}">
                                            <ui:DataGrid.Columns>
                                                <DataGridTextColumn Width="50" Binding="{Binding Order}" Header="#" />
                                                <DataGridTextColumn Width="1.4*" Binding="{Binding Header}" Header="{DynamicResource Loc.View.Profiles.Header.DisplayName}" MinWidth="110" />
                                                <DataGridTextColumn Width="1.2*" Binding="{Binding FieldId}" Header="Field ID" MinWidth="100" />
                                                <DataGridTextColumn Width="110" Binding="{Binding Source}" Header="{DynamicResource Loc.View.Profiles.Header.ValueSource}" />
                                                <DataGridTextColumn Width="1.8*" Binding="{Binding CaptureGroups}" Header="{DynamicResource Loc.View.Profiles.Header.RegularExpressionGroupsCombineOrder}" MinWidth="160" />
                                                <DataGridTextColumn Width="90" Binding="{Binding Kind}" Header="{DynamicResource Loc.View.Profiles.Header.ValueType}" />
                                                <DataGridCheckBoxColumn Width="60" Binding="{Binding Required, Mode=OneWay}" Header="{DynamicResource Loc.View.Profiles.Header.Required}" />
                                                <DataGridCheckBoxColumn Width="75" Binding="{Binding IsNullable, Mode=OneWay}" Header="Nullable" />
                                                <DataGridTextColumn Width="100" Binding="{Binding ParseFormat}" Header="{DynamicResource Loc.View.Profiles.Header.InputFormat}" />
                                                <DataGridTextColumn Width="100" Binding="{Binding DisplayFormat}" Header="{DynamicResource Loc.View.Profiles.Text.DisplayFormat}" />
                                                <DataGridTextColumn Width="90" Binding="{Binding ValueMappings}" Header="{DynamicResource Loc.View.Profiles.Header.ValueMappings}" />
                                            </ui:DataGrid.Columns>
                                        </ui:DataGrid>
                                    </Grid>
                                    </controls:SectionCard.Header>
                                </controls:SectionCard>

                                <controls:SectionCard Style="{StaticResource EditorSectionStyle}">
                                    <controls:SectionCard.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.TextFileValues}" />
                                            <ui:TextBlock
                                                Margin="0,4,0,0"
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{DynamicResource Loc.View.Profiles.Text.TheseColumnsCompareNamesAndReadFile}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:DataGrid
                                            Grid.Row="1"
                                            Margin="0,12,0,0"
                                            MinHeight="120"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding TextFileFields}"
                                            x:Name="ProfileTextFileFieldsInspectionGrid"
                                            PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            Style="{StaticResource FluentDataGridStyle}">
                                            <ui:DataGrid.Columns>
                                                <DataGridTextColumn Width="50" Binding="{Binding Order}" Header="#" />
                                                <DataGridTextColumn Width="1.2*" Binding="{Binding Header}" Header="{DynamicResource Loc.View.Profiles.Header.DisplayName}" MinWidth="110" />
                                                <DataGridTextColumn Width="1.1*" Binding="{Binding FieldId}" Header="Field ID" MinWidth="100" />
                                                <DataGridTextColumn Width="2.2*" Binding="{Binding FileNamePattern}" Header="{DynamicResource Loc.View.Profiles.Header.FileNameRegularExpression}" MinWidth="180" />
                                                <DataGridTextColumn Width="100" Binding="{Binding MatchMode}" Header="{DynamicResource Loc.View.Profiles.Header.Matching}" />
                                                <DataGridCheckBoxColumn Width="60" Binding="{Binding Required, Mode=OneWay}" Header="{DynamicResource Loc.View.Profiles.Header.Required}" />
                                                <DataGridCheckBoxColumn Width="100" Binding="{Binding IgnoreCase, Mode=OneWay}" Header="{DynamicResource Loc.View.Profiles.Content.IgnoreCase}" />
                                                <DataGridTextColumn Width="95" Binding="{Binding MaxBytes}" Header="{DynamicResource Loc.View.Profiles.Header.MaximumBytes}" />
                                                <DataGridTextColumn Width="85" Binding="{Binding TimeoutMilliseconds}" Header="{DynamicResource Loc.View.Profiles.Header.LimitMs259}" />
                                            </ui:DataGrid.Columns>
                                        </ui:DataGrid>
                                    </Grid>
                                    </controls:SectionCard.Header>
                                </controls:SectionCard>

                                <controls:SectionCard Style="{StaticResource EditorSectionStyle}">
                                    <controls:SectionCard.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.PathRules}" />
                                        <ui:DataGrid
                                            Grid.Row="1"
                                            Margin="0,12,0,0"
                                            MinHeight="160"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding Rules}"
                                            x:Name="ProfileRulesInspectionGrid"
                                            PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            Style="{StaticResource FluentDataGridStyle}">
                                            <ui:DataGrid.Columns>
                                                <DataGridTextColumn Width="50" Binding="{Binding Order}" Header="#" />
                                                <DataGridTextColumn Width="110" Binding="{Binding Id}" Header="{DynamicResource Loc.View.Profiles.Header.RuleID}" />
                                                <DataGridTextColumn Width="90" Binding="{Binding MatchMode}" Header="{DynamicResource Loc.View.Profiles.Header.Matching}" />
                                                <DataGridCheckBoxColumn Width="110" Binding="{Binding IgnoreCase, Mode=OneWay}" Header="{DynamicResource Loc.View.Profiles.Content.IgnoreCase}" />
                                                <DataGridTextColumn Width="90" Binding="{Binding TimeoutMilliseconds}" Header="{DynamicResource Loc.View.Profiles.Header.LimitMs}" />
                                                <DataGridTextColumn Width="3*" Binding="{Binding Pattern}" Header="{DynamicResource Loc.View.Profiles.Header.RegularExpressionPattern261}" MinWidth="240" />
                                                <DataGridTextColumn Width="1.6*" Binding="{Binding StopTraversalGroups}" Header="{DynamicResource Loc.View.Profiles.Header.DescendantTraversalStopGroups}" MinWidth="160" />
                                            </ui:DataGrid.Columns>
                                        </ui:DataGrid>
                                    </Grid>
                                    </controls:SectionCard.Header>
                                </controls:SectionCard>

                                <controls:SectionCard Margin="0" Style="{StaticResource FluentCardStyle}">
                                    <controls:SectionCard.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.ExcludedFolderNameRules}" />
                                            <ui:TextBlock
                                                Margin="0,4,0,0"
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{DynamicResource Loc.View.Profiles.Text.AppliedOnlyToTheCurrentFolderS}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:DataGrid
                                            Grid.Row="1"
                                            Margin="0,12,0,0"
                                            MinHeight="120"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding ExcludedDirectoryNameRules}"
                                            x:Name="ProfileExclusionsInspectionGrid"
                                            PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            Style="{StaticResource FluentDataGridStyle}">
                                            <ui:DataGrid.Columns>
                                                <DataGridTextColumn Width="50" Binding="{Binding Order}" Header="#" />
                                                <DataGridTextColumn Width="120" Binding="{Binding Id}" Header="{DynamicResource Loc.View.Profiles.Header.RuleID}" />
                                                <DataGridTextColumn Width="130" Binding="{Binding MatchMode}" Header="{DynamicResource Loc.View.Profiles.Header.FolderNameMatching}" />
                                                <DataGridCheckBoxColumn Width="110" Binding="{Binding IgnoreCase, Mode=OneWay}" Header="{DynamicResource Loc.View.Profiles.Content.IgnoreCase}" />
                                                <DataGridTextColumn Width="90" Binding="{Binding TimeoutMilliseconds}" Header="{DynamicResource Loc.View.Profiles.Header.LimitMs}" />
                                                <DataGridTextColumn Width="3*" Binding="{Binding Pattern}" Header="{DynamicResource Loc.View.Profiles.Header.RegularExpressionPattern261}" MinWidth="240" />
                                            </ui:DataGrid.Columns>
                                        </ui:DataGrid>
                                    </Grid>
                                    </controls:SectionCard.Header>
                                </controls:SectionCard>
                            </StackPanel>
                        </StackPanel>

                        <controls:SectionCard x:Name="ProfileDiagnosticsCard" Margin="0,16,0,0" Style="{StaticResource FluentCardStyle}">
                            <controls:SectionCard.Header>
                            <ui:CardExpander Header="{DynamicResource Loc.View.Profiles.Header.AdvancedPlugInAndDeclarativeProfileDiagnostics}">
                                <ui:DataGrid
                                    Margin="0,12,0,0"
                                    MinHeight="160"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding Reports}"
                                    PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    Style="{StaticResource FluentDataGridStyle}">
                                    <ui:DataGrid.Columns>
                                        <DataGridTextColumn Width="100" Binding="{Binding StatusText}" Header="{DynamicResource Loc.View.Profiles.Header.LoadStatus}" />
                                        <DataGridTextColumn Width="1.5*" Binding="{Binding DisplayName}" Header="{DynamicResource Loc.View.Profiles.Header.DisplayName}" />
                                        <DataGridTextColumn Width="1.4*" Binding="{Binding ProfileId}" Header="{DynamicResource Loc.View.Profiles.AutomationName.ProfileID}" />
                                        <DataGridTextColumn Width="3*" Binding="{Binding Diagnostics}" Header="{DynamicResource Loc.View.Profiles.Header.ValidationAndDiagnosticMessages}" />
                                        <DataGridTextColumn Width="2.5*" Binding="{Binding SourceDirectory}" Header="{DynamicResource Loc.View.Profiles.Header.SourceFolder}" />
                                    </ui:DataGrid.Columns>
                                </ui:DataGrid>
                            </ui:CardExpander>
                            </controls:SectionCard.Header>
                        </controls:SectionCard>
                    </StackPanel>
                </ui:DynamicScrollViewer>
            </ui:TabViewItem>
        </ui:TabView>
    </controls:WorkspacePageFrame>
</Page>
