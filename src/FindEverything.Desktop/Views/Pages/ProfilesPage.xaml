                                                            <CheckBox
                                                                Content="대소문자 무시"
                                                                IsChecked="{Binding IgnoreCase, UpdateSourceTrigger=PropertyChanged}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="최대 16개, 필드당 기본 262,144바이트(256 KiB), 최대 4,194,304바이트(4 MiB)입니다. 선택 파일이 제한을 넘거나 읽을 수 없으면 해당 항목의 검증 오류로 표시됩니다."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border IsEnabled="{Binding IsEditorReady}" Style="{StaticResource GuidedEditorSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="2. 실제 경로에서 결과 값 고르기" />
                                    <TextBlock
                                        Margin="0,4,0,16"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="정규식을 몰라도 괜찮습니다. 실제 경로를 분석한 뒤 폴더 조각을 버튼으로 골라 결과 값에 연결하세요."
                                        TextWrapping="Wrap" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="① 실제 경로 붙여넣기" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="드라이브 또는 UNC를 포함한 실제 전체 폴더 경로를 사용하세요."
                                        TextWrapping="Wrap" />
                                    <ui:TextBox
                                        Margin="0,4,0,8"
