                            <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{StaticResource Loc.View.Profiles.Text.MatchMode}" />
                            <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}"
                                AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.FolderNameExclusionMatchMode}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding DataContext.MatchModeChoices, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                SelectedValue="{Binding MatchMode, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Value" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{StaticResource Loc.View.Profiles.Text.TimeoutMs}" />
                            <ui:TextBox
                                AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.FolderExclusionRegularExpressionTimeout}"
                                Text="{Binding TimeoutMillisecondsText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox
                            Grid.Column="3"
                            Margin="16,24,0,0"
                            VerticalAlignment="Top"
                            Content="{StaticResource Loc.View.Profiles.Content.IgnoreCase}"
                            IsChecked="{Binding IgnoreCase, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <ui:TextBlock
                        Margin="0,10,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding MatchModeDisplayName}"
                        TextWrapping="Wrap" />
                </StackPanel>
                </controls:SectionCard.Header>
            </controls:SectionCard>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Item.ScanOptions.3">
            <controls:SectionCard Style="{StaticResource EditorSectionStyle}" IsEnabled="{Binding IsEditorReady}"><controls:SectionCard.Header><StackPanel>
            <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{StaticResource Loc.View.Profiles.Text.WithoutExclusionRulesEveryFolderIsVisited}"
                                        TextWrapping="Wrap" />
            </StackPanel></controls:SectionCard.Header></controls:SectionCard>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Item.ScanOptions.4">
            <controls:SectionCard Style="{StaticResource EditorSectionStyle}" IsEnabled="{Binding IsEditorReady}">
                <controls:SectionCard.Header><StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{StaticResource Loc.Profiles.Features.Depth.Title}" />
                    <ui:TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="{StaticResource Loc.Profiles.Features.Depth.Help}" />
                    <ui:TextBox Text="{Binding DraftMaxScanDepthText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{StaticResource Loc.Profiles.Features.Depth.Help}" />
                    <ui:TextBlock Margin="0,8,0,0" Text="{Binding ScanDepthValidationMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </StackPanel></controls:SectionCard.Header>
            </controls:SectionCard>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Item.Review.1">
            <controls:SectionCard
                x:Name="ProfileReviewPanel"
                IsEnabled="{Binding IsEditorReady}"
                Style="{StaticResource EditorSectionStyle}">
                <controls:SectionCard.Header>
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{StaticResource Loc.Ux.Authoring.ReviewTitle}" />
                    <ui:TextBlock
                        Margin="0,4,0,16"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="{StaticResource Loc.View.Profiles.Text.ReviewYourSettingsThenValidateAndSave}"
                        TextWrapping="Wrap" />

                    <UniformGrid Columns="2" Rows="2">
                        <controls:SectionCard Margin="0,0,8,8" Style="{StaticResource FieldCardStyle}">
                            <controls:SectionCard.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.Shell.Nav.Profiles}" />
                                <ui:TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding DraftDisplayName}" />
                                <ui:TextBlock Margin="0,2,0,0" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DraftId}" />
                            </StackPanel>
                            </controls:SectionCard.Header>
                        </controls:SectionCard>
                        <controls:SectionCard Margin="8,0,0,8" Style="{StaticResource FieldCardStyle}">
                            <controls:SectionCard.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.View.Profiles.Text.EditingMode225}" />
                                <ui:TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding EditorModeDisplay}" />
                                <ui:TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{StaticResource Loc.View.Profiles.Text.PathRulesAndResultColumns}" />
                            </StackPanel>
                            </controls:SectionCard.Header>
                        </controls:SectionCard>
                        <controls:SectionCard Margin="0,8,8,0" Style="{StaticResource FieldCardStyle}">
                            <controls:SectionCard.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.View.Profiles.Text.StructuredResults}" />
                                <ui:TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding DraftFields.Count, StringFormat={StaticResource Loc.Profiles.PathColumnCountFormat}}" />
                                <ui:TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DraftTextFileFields.Count, StringFormat={StaticResource Loc.Profiles.TextFileColumnCountFormat}}" />
                                <ui:TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DraftUserInputFields.Count, StringFormat={StaticResource Loc.Profiles.UserInputColumnCountFormat}}" />
                            </StackPanel>
                            </controls:SectionCard.Header>
                        </controls:SectionCard>
                        <controls:SectionCard Margin="8,8,0,0" Style="{StaticResource FieldCardStyle}">
                            <controls:SectionCard.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.View.Profiles.Text.ScanBehavior}" />
                                <ui:TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding DraftRules.Count, StringFormat={StaticResource Loc.Profiles.PathRuleCountFormat}}" />
                                <ui:TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DraftExcludedDirectoryNameRules.Count, StringFormat={StaticResource Loc.Profiles.ExclusionRuleCountFormat}}" />
                            </StackPanel>
                            </controls:SectionCard.Header>
                        </controls:SectionCard>
                    </UniformGrid>

                    <ui:InfoBar
                        Margin="0,16,0,0"
                        AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.ProfileSaveAndPlaygroundGuidance}"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{StaticResource Loc.Ux.Authoring.ReviewHelp}"
                        Severity="Informational"
                        Title="{StaticResource Loc.View.Profiles.Title.TestTheSavedVersionWithAReal}" />
                </StackPanel>
                </controls:SectionCard.Header>
            </controls:SectionCard>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Profile">
            <controls:ProfileEditorList Loaded="OnEditorStepContentLoaded" IsEnabled="{Binding IsEditorReady}"
                Style="{StaticResource ProfileEditorVirtualListStyle}">
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.ValidationIssues}" Id="ValidationIssues" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.Profile.1}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.Profile.2}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.Profile.3}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.Profile.EntryPathsHeader}" Id="EntryPathSettings" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.Profile.EntryPath}" Id="EntryPaths" IsCollection="True" ItemsSource="{Binding DraftEntryPaths}" />
            </controls:ProfileEditorList>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.PathGuided">
            <controls:ProfileEditorList Loaded="OnEditorStepContentLoaded" IsEnabled="{Binding IsEditorReady}"
                Style="{StaticResource ProfileEditorVirtualListStyle}">
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.ValidationIssues}" Id="ValidationIssues" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.PathGuided.1}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.PathGuided.2}" Id="AssignmentPicker" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.PathGuided.3}" IsCollection="True" ItemsSource="{Binding DraftFields}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.PathGuided.4}" />
            </controls:ProfileEditorList>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.PathExpert">
            <controls:ProfileEditorList Loaded="OnEditorStepContentLoaded" IsEnabled="{Binding IsEditorReady}"
                Style="{StaticResource ProfileEditorVirtualListStyle}">
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.ValidationIssues}" Id="ValidationIssues" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.PathExpert.1}" Id="ExpertColumns" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.PathExpert.2}" IsCollection="True" ItemsSource="{Binding DraftFields}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.PathExpert.3}" Id="ExpertRules" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.PathExpert.4}" IsCollection="True" ItemsSource="{Binding DraftRules}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.PathExpert.5}" />
            </controls:ProfileEditorList>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.DataSources">
            <controls:ProfileEditorList Loaded="OnEditorStepContentLoaded" IsEnabled="{Binding IsEditorReady}"
                Style="{StaticResource ProfileEditorVirtualListStyle}">
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.ValidationIssues}" Id="ValidationIssues" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.DataSources.1}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.DataSources.2}" IsCollection="True" ItemsSource="{Binding DraftFields}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.DataSources.3}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.DataSources.4}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.DataSources.5}" IsCollection="True" ItemsSource="{Binding DraftTextFileFields}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.DataSources.6}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.DataSources.7}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.DataSources.8}" IsCollection="True" ItemsSource="{Binding DraftChildDirectoryFields}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.DataSources.9}" Id="UserInputFields" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.DataSources.10}" IsCollection="True" ItemsSource="{Binding DraftUserInputFields}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.DataSources.11}" />
            </controls:ProfileEditorList>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.SelectionRules">
            <controls:ProfileEditorList Loaded="OnEditorStepContentLoaded" IsEnabled="{Binding IsEditorReady}"
                Style="{StaticResource ProfileEditorVirtualListStyle}">
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.ValidationIssues}" Id="ValidationIssues" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.SelectionRules.1}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.SelectionRules.2}" IsCollection="True" ItemsSource="{Binding DraftSelectionRules}" />
            </controls:ProfileEditorList>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.ScanOptions">
            <controls:ProfileEditorList Loaded="OnEditorStepContentLoaded" IsEnabled="{Binding IsEditorReady}"
                Style="{StaticResource ProfileEditorVirtualListStyle}">
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.ValidationIssues}" Id="ValidationIssues" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.ScanOptions.1}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.ScanOptions.2}" IsCollection="True" ItemsSource="{Binding DraftExcludedDirectoryNameRules}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.ScanOptions.3}" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.ScanOptions.4}" />
            </controls:ProfileEditorList>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Review">
            <controls:ProfileEditorList Loaded="OnEditorStepContentLoaded" IsEnabled="{Binding IsEditorReady}"
                Style="{StaticResource ProfileEditorVirtualListStyle}">
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.ValidationIssues}" Id="ValidationIssues" />
                <controls:ProfileEditorSection Template="{StaticResource ProfileEditor.Item.Review.1}" />
            </controls:ProfileEditorList>
        </DataTemplate>
    </Page.Resources>

    <controls:WorkspacePageFrame x:Name="ProfilePageLayout" SizeChanged="OnProfileWorkspaceSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TabView
            x:Name="ProfilesTabControl"
            Grid.Row="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <ui:TabViewItem>
                <ui:TabViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="{StaticResource Loc.View.Profiles.Header.EditProfile}" VerticalAlignment="Center" ToolTip="{StaticResource Loc.Workspace.Profiles.Description}" />
                        <controls:WorkspaceTransferPanel x:Name="ProfilesWorkspaceTransferPanel" Margin="12,0,0,0" DataContext="{Binding WorkspaceTransfer}" ShowProfileExport="True" ShowPackageExport="False" ShowSourceSelector="False"
                            Profile="{Binding DataContext.ExportProfileCandidate, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </StackPanel>
                </ui:TabViewItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:SectionCard
                        x:Name="ProfileEditorStepRail"
                        Grid.Row="0"
                        Margin="0,8,0,0"
                        Padding="4"
                        AutomationProperties.ItemStatus="{Binding EditorStepStatus}"
                        ToolTip="{Binding NumericValidationMessage}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.ProfileSetupSteps}"
                        IsEnabled="{Binding IsEditorReady}"
                        Style="{StaticResource WorkspaceToolbarCardStyle}">
                        <controls:SectionCard.Header>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <UniformGrid x:Name="ProfileStepButtons" Columns="3" Rows="1">
                            <RadioButton
                                Style="{StaticResource ProfileStepChoiceStyle}"
                                AutomationProperties.HelpText="{StaticResource Loc.View.Profiles.AutomationHelpText.ChooseAProfileAndSetItsBasic}"
                                AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.Step1ProfileInformation}"
                                Command="{Binding GoToEditorStepCommand}"
                                CommandParameter="{x:Static viewModels:ProfileEditorStep.Profile}"
                                Content="{StaticResource Loc.Ux.Authoring.Step.Info}"
                                GroupName="ProfileEditorSteps"
                                IsChecked="{Binding IsProfileStep, Mode=OneWay}" />
                            <RadioButton
                                Style="{StaticResource ProfileStepChoiceStyle}"
                                AutomationProperties.HelpText="{StaticResource Loc.View.Profiles.AutomationHelpText.DefineResultColumnsFromARealPath}"
                                AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.Step2PathAndColumns}"
                                Command="{Binding GoToEditorStepCommand}"
                                CommandParameter="{x:Static viewModels:ProfileEditorStep.PathAndFields}"
                                Content="{StaticResource Loc.Ux.Authoring.Step.Path}"
                                GroupName="ProfileEditorSteps"
                                IsChecked="{Binding IsPathAndFieldsStep, Mode=OneWay}" />
                            <RadioButton
                                Style="{StaticResource ProfileStepChoiceStyle}"
                                AutomationProperties.HelpText="{StaticResource Loc.View.Profiles.AutomationHelpText.ValidateAndSaveTheProfileThenContinue}"
                                AutomationProperties.Name="{StaticResource Loc.Ux.Authoring.Step.Review}"
                                Command="{Binding GoToEditorStepCommand}"
                                CommandParameter="{x:Static viewModels:ProfileEditorStep.Review}"
                                Content="{StaticResource Loc.Ux.Authoring.Step.Review}"
                                GroupName="ProfileEditorSteps"
                                IsChecked="{Binding IsReviewStep, Mode=OneWay}" />
                        </UniformGrid>
                        <ui:Button x:Name="OptionalProfileStepsButton" Grid.Column="1" Margin="4" Padding="10,8" VerticalAlignment="Center"
                            Content="{Binding OptionalStepsButtonText}" Icon="{ui:SymbolIcon Symbol=ChevronDown16}"
                            AutomationProperties.ItemStatus="{Binding OptionalStepsSummary}" ToolTip="{Binding OptionalStepsSummary}" Click="OnOptionalStepsClick">
                            <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsOptionalEditorStep}" Value="True"><Setter Property="Appearance" Value="Primary" /></DataTrigger></Style.Triggers>
                            </Style></ui:Button.Style>
                            <ui:Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <ui:MenuItem Command="{Binding GoToEditorStepCommand}" CommandParameter="{x:Static viewModels:ProfileEditorStep.DataSources}" IsCheckable="True" IsChecked="{Binding IsDataSourcesStep, Mode=OneWay}" AutomationProperties.Name="{StaticResource Loc.Ux.Authoring.Optional.Data}" AutomationProperties.HelpText="{Binding OptionalDataSummary}">
                                        <ui:MenuItem.Header><StackPanel MaxWidth="360">
                                            <ui:TextBlock Text="{StaticResource Loc.Ux.Authoring.Optional.Data}" FontWeight="SemiBold" />
                                            <ui:TextBlock Margin="0,4,0,0" Text="{Binding OptionalDataSummary}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel></ui:MenuItem.Header>
                                    </ui:MenuItem>
                                    <ui:MenuItem Command="{Binding GoToEditorStepCommand}" CommandParameter="{x:Static viewModels:ProfileEditorStep.SelectionRules}" IsCheckable="True" IsChecked="{Binding IsSelectionRulesStep, Mode=OneWay}" AutomationProperties.Name="{StaticResource Loc.Ux.Authoring.Optional.Selection}" AutomationProperties.HelpText="{Binding OptionalSelectionSummary}">
                                        <ui:MenuItem.Header><StackPanel MaxWidth="360">
                                            <ui:TextBlock Text="{StaticResource Loc.Ux.Authoring.Optional.Selection}" FontWeight="SemiBold" />
                                            <ui:TextBlock Margin="0,4,0,0" Text="{Binding OptionalSelectionSummary}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel></ui:MenuItem.Header>
                                    </ui:MenuItem>
                                    <ui:MenuItem Command="{Binding GoToEditorStepCommand}" CommandParameter="{x:Static viewModels:ProfileEditorStep.ScanOptions}" IsCheckable="True" IsChecked="{Binding IsScanOptionsStep, Mode=OneWay}" AutomationProperties.Name="{StaticResource Loc.Ux.Authoring.Optional.Scan}" AutomationProperties.HelpText="{Binding OptionalScanSummary}">
                                        <ui:MenuItem.Header><StackPanel MaxWidth="360">
                                            <ui:TextBlock Text="{StaticResource Loc.Ux.Authoring.Optional.Scan}" FontWeight="SemiBold" />
                                            <ui:TextBlock Margin="0,4,0,0" Text="{Binding OptionalScanSummary}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel></ui:MenuItem.Header>
                                    </ui:MenuItem>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                        <ui:TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="12,0,12,8" Text="{Binding CurrentStepTitle}" FontWeight="SemiBold"
                            Visibility="{Binding IsOptionalEditorStep, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                        </controls:SectionCard.Header>
                    </controls:SectionCard>

                    <Grid x:Name="ProfileEditorViewport" Grid.Row="1" Margin="0,12,0,0">
                        <ContentControl x:Name="ProfileEditorStepHost" Content="{Binding}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False" IsTabStop="False">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ProfileEditor.Profile}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPathAndFieldsStep}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ProfileEditor.PathGuided}" /></DataTrigger>
                                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsPathAndFieldsStep}" Value="True" /><Condition Binding="{Binding IsExpertMode}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="ContentTemplate" Value="{StaticResource ProfileEditor.PathExpert}" /></MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsDataSourcesStep}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ProfileEditor.DataSources}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelectionRulesStep}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ProfileEditor.SelectionRules}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsScanOptionsStep}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ProfileEditor.ScanOptions}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsReviewStep}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ProfileEditor.Review}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </Grid>

                    <controls:SectionCard
                        x:Name="EditorFooter"
                        controls:FloatingNotificationChrome.IsBottomChrome="True"
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Style="{StaticResource WorkspaceActionCardStyle}">
                        <controls:SectionCard.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button
                                    x:Name="PreviousProfileStepButton"
                                    MinWidth="88"
                                    Margin="0,0,12,0"
                                    AutomationProperties.HelpText="{StaticResource Loc.View.Profiles.AutomationHelpText.GoToThePreviousProfileConfigurationStep}"
                                    AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.PreviousStep}"
                                    Command="{Binding PreviousEditorStepCommand}"
                                    Content="{StaticResource Loc.View.Profiles.Content.Back}"
                                    Icon="{ui:SymbolIcon Symbol=ArrowLeft20}" />
                                <ui:TextBlock
                                    x:Name="EditorFooterStatusText"
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding EditorStatusMessage}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding EditorStatusMessage}" />
                                <ui:Button
                                    x:Name="NextProfileStepButton"
                                    Grid.Column="2"
                                    MinWidth="104"
                                    Appearance="Primary"
                                    AutomationProperties.HelpText="{StaticResource Loc.View.Profiles.AutomationHelpText.GoToTheNextProfileConfigurationStep}"
                                    AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.NextStep}"
                                    Command="{Binding NextEditorStepCommand}"
                                    Content="{StaticResource Loc.View.Profiles.Content.Next}"
                                    Icon="{ui:SymbolIcon Symbol=ArrowRight20}">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReviewStep}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsReviewStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ui:Button
                                        Width="36"
                                        Padding="0"
                                        Margin="0,0,8,0"
                                        Appearance="Transparent"
                                        Command="{Binding ValidateDraftCommand}"
                                        AutomationProperties.Name="{StaticResource Loc.View.Profiles.Content.Validate}"
                                        ToolTip="{StaticResource Loc.Ux.Authoring.Validate.Help}"
                                        Icon="{ui:SymbolIcon Symbol=CheckmarkCircle20}" />
                                    <ui:Button
                                        MinWidth="120"
                                        Command="{Binding SaveDraftCommand}"
                                        Content="{StaticResource Loc.Common.Save}"
                                        ToolTip="{StaticResource Loc.Ux.Authoring.Save.Help}"
                                        Icon="{ui:SymbolIcon Symbol=Save16}" />
                                    <ui:Button
                                        MinWidth="120"
                                        Margin="8,0,0,0"
                                        Appearance="Primary"
                                        AutomationProperties.HelpText="{StaticResource Loc.Ux.Authoring.SaveAndTest.Help}"
                                        AutomationProperties.Name="{StaticResource Loc.Ux.Authoring.SaveAndTest}"
                                        Command="{Binding SaveAndTestCommand}"
                                        Content="{StaticResource Loc.Ux.Authoring.SaveAndTest}"
                                        Icon="{ui:SymbolIcon Symbol=DocumentSearch20}" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar
                                Grid.Row="1"
                                Height="3"
                                Margin="0,8,0,0"
                                IsIndeterminate="True"
                                Visibility="{Binding IsEditorBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        </controls:SectionCard.Header>
                    </controls:SectionCard>
                </Grid>
            </ui:TabViewItem>

            <ui:TabViewItem Header="{StaticResource Loc.View.Profiles.Header.LoadStatus}">
                <!-- Inspection booleans are getter-only. Grid IsReadOnly does not
                     override the CheckBox IsChecked default TwoWay binding. -->
                <ui:DynamicScrollViewer
                    x:Name="ProfileLoadStatusScrollViewer"
                    Style="{StaticResource FluentGutteredScrollViewerStyle}">
                    <StackPanel Margin="0,8,0,24">
                        <StackPanel>
                            <controls:SectionCard x:Name="LoadedProfilesCard" Style="{StaticResource EditorSectionStyle}">
                                <controls:SectionCard.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{StaticResource Loc.View.Profiles.Text.ProfileLoadStatus}" AutomationProperties.HeadingLevel="Level2" />
                                    <ui:TextBlock
                                        Grid.Row="1"
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{StaticResource Loc.View.Profiles.Text.SelectAProfileAvailableToTheApp}" TextWrapping="Wrap" />
                                    <ui:DataGrid
                                        Grid.Row="2"
                                        MinHeight="280"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        HeadersVisibility="Column"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding Profiles}"
                                        PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        SelectedItem="{Binding SelectedProfile}"
                                        SelectionMode="Single"
                                        Style="{StaticResource FluentDataGridStyle}">
                                        <ui:DataGrid.Columns>
                                            <DataGridTextColumn Width="*" Binding="{Binding DisplayName}" Header="{StaticResource Loc.View.Profiles.Header.DisplayName}" MinWidth="140" />
