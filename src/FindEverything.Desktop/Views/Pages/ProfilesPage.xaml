                                                                Padding="8"
                                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                                <StackPanel>
                                                                    <ui:Button
                                                                        AutomationProperties.Name="폴더명 전체 선택"
                                                                        Command="{Binding DataContext.AssignPathChoiceCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                        CommandParameter="{Binding WholeChoice}"
                                                                        Content="{Binding WholeChoice.DisplayName}" />
