<Page
    x:Class="FindEverything.Desktop.Views.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="프로필"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <TabControl Margin="24,0,24,24">
        <TabItem Header="GUI 프로필 편집기">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="8,20,8,32" MaxWidth="1240" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:InfoBar
                        Grid.Row="0"
                        Margin="0,0,0,16"
                        IsClosable="False"
                        IsOpen="True"
                        Message="코드나 DLL 없이 폴더 경로의 정보를 추출하는 프로필을 만듭니다. 위에서부터 기본 정보, 결과 컬럼, 경로 규칙을 정의한 뒤 예제 경로로 시험하세요."
                        Severity="Informational"
                        Title="선언형 프로필 만들기" />

                    <GroupBox Grid.Row="1" Margin="0,0,0,16" Padding="16" Header="내 프로필">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                MinWidth="300"
                                Margin="0,0,8,0"
                                VerticalContentAlignment="Center"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding EditableProfiles}"
                                SelectedItem="{Binding SelectedEditableProfile}" />
                            <ui:Button
                                Grid.Column="1"
                                MinWidth="104"
                                Margin="0,0,8,0"
                                Command="{Binding LoadDraftCommand}"
                                Content="선택 항목 열기" />
                            <ui:Button
                                Grid.Column="2"
                                MinWidth="104"
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Command="{Binding NewDraftCommand}"
                                Content="새로 만들기" />
                            <ui:Button
                                Grid.Column="3"
                                MinWidth="112"
                                Command="{Binding OpenUserProfilesFolderCommand}"
                                Content="프로필 폴더 열기" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Margin="0,0,0,16" Padding="16" Header="1. 기본 정보" IsEnabled="{Binding IsEditorReady}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="표시 이름 *" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="화면에 보이는 이름" />
                            </StackPanel>
                            <ui:TextBox
                                Grid.Column="1"
                                Margin="8,4"
                                ClearButtonEnabled="True"
                                PlaceholderText="예: 프로젝트 폴더"
                                Text="{Binding DraftDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="프로필 ID *" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="소문자 영문/숫자로 시작 · 점과 하이픈 허용 · 최대 64자" />
                            </StackPanel>
                            <ui:TextBox
                                Grid.Column="4"
                                Margin="8,4"
                                ClearButtonEnabled="True"
                                IsEnabled="{Binding CanEditDraftId}"
                                PlaceholderText="예: my-projects"
                                Text="{Binding DraftId, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="규칙에 넣을 경로" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Relative: 선택한 루트 기준 / Full: 전체 경로" />
                            </StackPanel>
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="8,12,8,4"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding PathInputChoices}"
                                SelectedItem="{Binding SelectedPathInput}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Margin="0,0,0,16" Padding="16" Header="2. 결과 컬럼" IsEnabled="{Binding IsEditorReady}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Margin="0,0,0,10"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="정규식의 이름 있는 그룹을 결과 컬럼에 연결합니다. 필수 컬럼이 비어 있거나 값 변환에 실패하면 해당 경로는 '규칙 위반'으로 표시됩니다."
                                TextWrapping="Wrap" />
                            <DataGrid
                                Grid.Row="1"
                                MinHeight="150"
                                MaxHeight="300"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                HeadersVisibility="Column"
                                ItemsSource="{Binding DraftFields}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="1.3*" Binding="{Binding Header, UpdateSourceTrigger=PropertyChanged}" Header="표시 이름 (선택)" />
                                    <DataGridTextColumn Width="1.2*" Binding="{Binding FieldId, UpdateSourceTrigger=PropertyChanged}" Header="Field ID *" />
                                    <DataGridTextColumn Width="1.2*" Binding="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" Header="정규식 그룹 *" />
                                    <DataGridTemplateColumn Width="120" Header="값 타입">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="6,0" VerticalAlignment="Center" Text="{Binding KindDisplayName}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox
                                                    DisplayMemberPath="DisplayName"
                                                    ItemsSource="{Binding DataContext.FieldKindChoices, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    SelectedValue="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                    SelectedValuePath="Value" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Width="70" Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}" Header="필수" />
                                    <DataGridTextColumn Width="1.1*" Binding="{Binding ParseFormat, UpdateSourceTrigger=PropertyChanged}" Header="입력 형식" />
                                    <DataGridTextColumn Width="1.1*" Binding="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged}" Header="표시 형식" />
                                    <DataGridTemplateColumn Width="124" Header="순서 / 삭제">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <ui:Button
                                                        Width="32"
                                                        Margin="0,0,3,0"
                                                        Padding="0"
                                                        Command="{Binding DataContext.MoveFieldUpCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↑"
                                                        ToolTip="위로 이동" />
                                                    <ui:Button
                                                        Width="32"
                                                        Margin="0,0,3,0"
                                                        Padding="0"
                                                        Command="{Binding DataContext.MoveFieldDownCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↓"
                                                        ToolTip="아래로 이동" />
                                                    <ui:Button
                                                        Width="48"
                                                        Padding="0"
                                                        Appearance="Caution"
                                                        Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="삭제" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                <ui:Button
                                    Width="112"
                                    Margin="0,0,16,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding AddFieldCommand}"
                                    Content="+ 컬럼 추가"
                                    DockPanel.Dock="Left" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Field ID는 소문자 영문/숫자로 시작하며 점·밑줄·하이픈을 쓸 수 있습니다. 표시 이름을 비우면 Field ID가 사용됩니다. 날짜 입력 형식 예: yyyyMMdd · 숫자/날짜 표시 형식 예: N2, yyyy-MM-dd"
                                    TextWrapping="Wrap" />
                            </DockPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="4" Margin="0,0,0,16" Padding="16" Header="3. 경로 규칙" IsEnabled="{Binding IsEditorReady}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Margin="0,0,0,10"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="예: Clients\\(?&lt;client&gt;[^\\]+)\\Projects\\(?&lt;project&gt;[^\\]+) — 그룹 이름은 위 컬럼의 '정규식 그룹'과 같아야 합니다. 규칙은 위에서부터 시험합니다."
                                TextWrapping="Wrap" />
                            <DataGrid
                                Grid.Row="1"
                                MinHeight="150"
                                MaxHeight="300"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                HeadersVisibility="Column"
                                ItemsSource="{Binding DraftRules}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="1.1*" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Header="규칙 ID (선택)" />
                                    <DataGridTemplateColumn Width="100" Header="매칭">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="6,0" VerticalAlignment="Center" Text="{Binding MatchModeDisplayName}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox
                                                    DisplayMemberPath="DisplayName"
                                                    ItemsSource="{Binding DataContext.MatchModeChoices, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    SelectedValue="{Binding MatchMode, UpdateSourceTrigger=PropertyChanged}"
                                                    SelectedValuePath="Value" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Width="110" Binding="{Binding IgnoreCase, UpdateSourceTrigger=PropertyChanged}" Header="대소문자 무시" />
                                    <DataGridTextColumn Width="100" Binding="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" Header="제한 (ms)" />
                                    <DataGridTextColumn Width="3*" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Header="정규식 Pattern *" />
                                    <DataGridTemplateColumn Width="124" Header="순서 / 삭제">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <ui:Button
                                                        Width="32"
                                                        Margin="0,0,3,0"
                                                        Padding="0"
                                                        Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↑"
                                                        ToolTip="위로 이동" />
                                                    <ui:Button
                                                        Width="32"
                                                        Margin="0,0,3,0"
                                                        Padding="0"
                                                        Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↓"
                                                        ToolTip="아래로 이동" />
                                                    <ui:Button
                                                        Width="48"
                                                        Padding="0"
                                                        Appearance="Caution"
                                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="삭제" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                <ui:Button
                                    Width="112"
                                    Margin="0,0,16,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding AddRuleCommand}"
                                    Content="+ 규칙 추가"
                                    DockPanel.Dock="Left" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Full은 경로 전체가 일치해야 하고 Partial은 경로 일부만 일치해도 됩니다. 제한 시간은 1~10,000ms 범위입니다."
                                    TextWrapping="Wrap" />
                            </DockPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="5" Margin="0,0,0,16" Padding="16" Header="4. 예제 경로로 시험" IsEnabled="{Binding IsEditorReady}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ui:TextBox
                                Margin="0,0,8,0"
                                ClearButtonEnabled="True"
                                PlaceholderText="실제 폴더 경로 또는 상대 경로를 붙여 넣으세요"
                                Text="{Binding SamplePath, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="1"
                                MinWidth="112"
                                Appearance="Primary"
                                Command="{Binding TestDraftCommand}"
                                Content="경로 시험" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,8"
                                FontWeight="SemiBold"
                                Text="{Binding TestSummary}"
                                TextWrapping="Wrap" />
                            <DataGrid
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                MaxHeight="240"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding TestRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="1.2*" Binding="{Binding FieldName}" Header="컬럼" />
                                    <DataGridTextColumn Width="2*" Binding="{Binding Value}" Header="추출된 값" />
                                    <DataGridTextColumn Width="1.2*" Binding="{Binding Status}" Header="상태" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:InfoBar
                            Margin="0,0,16,0"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{Binding EditorStatusMessage}"
                            Severity="{Binding EditorStatusSeverity}"
                            Title="검증 및 저장" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <ui:Button
                                MinWidth="96"
                                Margin="0,0,8,0"
                                Command="{Binding ValidateDraftCommand}"
                                Content="검증" />
                            <ui:Button
                                MinWidth="120"
                                Appearance="Primary"
                                Command="{Binding SaveDraftCommand}"
                                Content="검증 후 저장" />
                        </StackPanel>
                        <ProgressBar
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Height="3"
                            Margin="0,8,0,0"
                            IsIndeterminate="True"
                            Visibility="{Binding IsEditorBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="로드 결과">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="8,20,8,32" MaxWidth="1240" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:InfoBar
                        Grid.Row="0"
                        Margin="0,0,0,16"
                        IsClosable="False"
                        IsOpen="True"
                        Message="앱 시작 시 발견된 프로필의 실제 해석 결과입니다. 프로필을 선택하면 아래에서 컬럼과 규칙을 확인할 수 있습니다. Disabled 항목은 진단 메시지에서 원인을 확인하세요."
                        Severity="Informational"
                        Title="프로필 로드 상태" />

                    <GroupBox Grid.Row="1" Margin="0,0,0,16" Padding="12" Header="로드된 프로필">
                        <DataGrid
                            MinHeight="150"
                            MaxHeight="260"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile}"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="2*" Binding="{Binding DisplayName}" Header="표시 이름" />
                                <DataGridTextColumn Width="2*" Binding="{Binding Id}" Header="프로필 ID" />
                                <DataGridTextColumn Width="110" Binding="{Binding Kind}" Header="정의 방식" />
                                <DataGridTextColumn Width="90" Binding="{Binding Version}" Header="버전" />
                                <DataGridTextColumn Width="100" Binding="{Binding CandidateKind}" Header="검색 대상" />
                                <DataGridTextColumn Width="110" Binding="{Binding PathInput}" Header="규칙 경로" />
                                <DataGridTextColumn Width="70" Binding="{Binding FieldCount}" Header="컬럼 수" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Margin="0,0,0,16" Padding="12" Header="선택한 프로필의 결과 컬럼">
                        <DataGrid
                            MinHeight="150"
                            MaxHeight="260"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Fields}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="60" Binding="{Binding Order}" Header="순서" />
                                <DataGridTextColumn Width="1.4*" Binding="{Binding Header}" Header="표시 이름" />
                                <DataGridTextColumn Width="1.2*" Binding="{Binding FieldId}" Header="Field ID" />
                                <DataGridTextColumn Width="1.2*" Binding="{Binding GroupName}" Header="정규식 그룹" />
                                <DataGridTextColumn Width="100" Binding="{Binding Kind}" Header="값 타입" />
                                <DataGridCheckBoxColumn Width="60" Binding="{Binding Required}" Header="필수" />
                                <DataGridCheckBoxColumn Width="80" Binding="{Binding IsNullable}" Header="Nullable" />
                                <DataGridTextColumn Width="1.1*" Binding="{Binding ParseFormat}" Header="입력 형식" />
                                <DataGridTextColumn Width="1.1*" Binding="{Binding DisplayFormat}" Header="표시 형식" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Margin="0,0,0,16" Padding="12" Header="선택한 프로필의 경로 규칙">
                        <DataGrid
                            MinHeight="150"
                            MaxHeight="260"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Rules}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="60" Binding="{Binding Order}" Header="순서" />
                                <DataGridTextColumn Width="1.2*" Binding="{Binding Id}" Header="규칙 ID" />
                                <DataGridTextColumn Width="90" Binding="{Binding MatchMode}" Header="매칭" />
                                <DataGridCheckBoxColumn Width="110" Binding="{Binding IgnoreCase}" Header="대소문자 무시" />
                                <DataGridTextColumn Width="100" Binding="{Binding TimeoutMilliseconds}" Header="제한 (ms)" />
                                <DataGridTextColumn Width="3*" Binding="{Binding Pattern}" Header="정규식 Pattern" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="4" Padding="12" Header="플러그인 및 선언형 프로필 진단">
                        <DataGrid
                            MinHeight="150"
                            MaxHeight="280"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Reports}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="100" Binding="{Binding StatusText}" Header="로드 상태" />
                                <DataGridTextColumn Width="1.5*" Binding="{Binding DisplayName}" Header="표시 이름" />
                                <DataGridTextColumn Width="1.4*" Binding="{Binding ProfileId}" Header="프로필 ID" />
                                <DataGridTextColumn Width="3*" Binding="{Binding Diagnostics}" Header="검증 및 진단 메시지" />
                                <DataGridTextColumn Width="2.5*" Binding="{Binding SourceDirectory}" Header="원본 폴더" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Page>
