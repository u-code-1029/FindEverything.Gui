                                        PlaceholderText="예: C:\Archive\고객사\프로젝트\2026\Rev-3"
                                        Text="{Binding SamplePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Margin="0,0,0,20"
                                        HorizontalAlignment="Left"
                                        Command="{Binding BuildTemplateFromSampleCommand}"
                                        Content="경로 분석"
                                        Icon="{ui:SymbolIcon Symbol=ArrowDown20}" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="② 결과 값과 경로 조각 연결하기" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="먼저 아래 결과 값 카드에서 연결할 항목을 누른 다음, 폴더명 전체 또는 _, -, 공백으로 나뉜 세부 조각 버튼을 누르세요."
                                        TextWrapping="Wrap" />

                                    <Border
                                        x:Name="AssignmentPickerPanel"
