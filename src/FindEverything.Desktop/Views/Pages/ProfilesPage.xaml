                                                        <RadioButton
                                                            Margin="0,12,0,0"
                                                            AutomationProperties.Name="탐색 중단 기준 필드"
                                                            Command="{Binding DataContext.SelectTerminalFieldCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                            CommandParameter="{Binding}"
                                                            Content="이 값까지 찾으면 하위 폴더 건너뛰기"
                                                            GroupName="GuidedTerminalField"
                                                            IsChecked="{Binding IsTerminalField, Mode=OneWay}" />

                                                        <Expander
                                                            Margin="0,12,0,0"
                                                            HorizontalContentAlignment="Stretch"
                                                            Header="고급 표시 설정">
                                                            <StackPanel Margin="0,8,0,0">
                                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="이 값의 내부 키" />
                                                                <TextBlock Margin="0,2,0,12" FontFamily="Consolas" Text="{Binding FieldId}" />
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="표시 형식" />
                                                                <ui:TextBox
                                                                    Margin="0,4,0,0"
                                                                    PlaceholderText="예: yyyy-MM-dd 또는 N2"
                                                                    Text="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ui:Button
                                        Margin="0,0,0,12"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ClearTerminalFieldCommand}"
                                        Content="하위 폴더를 계속 탐색" />

                                    <ui:InfoBar
                                        Margin="0,4,0,0"
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{Binding TemplateStatusMessage}"
                                        Severity="{Binding TemplateStatusSeverity}"
                                        Title="경로 규칙 확인" />

                                    <Expander
                                        Margin="0,12,0,0"
                                        HorizontalContentAlignment="Stretch"
                                        Header="전문가용: 만들어진 정규식 보기">
                                        <TextBox
                                            Margin="0,8,0,0"
                                            Padding="8"
                                            FontFamily="Consolas"
                                            IsReadOnly="True"
                                            Text="{Binding GeneratedPatternPreview}"
                                            TextWrapping="Wrap" />
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border IsEnabled="{Binding IsEditorReady}" Style="{StaticResource ExpertEditorSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="2. 전문가 규칙 편집" />
                                    <TextBlock
                                        Margin="0,4,0,16"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="결과 컬럼과 정규식을 직접 연결합니다. 경로 규칙은 최대 64개, pattern은 규칙당 최대 4,096자이며 폴더 제외·텍스트 파일 이름 규칙까지 합친 제한 시간은 프로필당 10,000ms 이하여야 합니다."
                                        TextWrapping="Wrap" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="결과 컬럼" />
                                    <DataGrid
                                        Margin="0,4,0,8"
                                        MinHeight="160"
                                        HorizontalAlignment="Stretch"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        HeadersVisibility="Column"
                                        ItemsSource="{Binding DraftFields}"
                                        PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="1.3*" Binding="{Binding Header, UpdateSourceTrigger=PropertyChanged}" Header="표시 이름" MinWidth="120" />
                                            <DataGridTextColumn Width="1.2*" Binding="{Binding FieldId, UpdateSourceTrigger=PropertyChanged}" Header="Field ID *" MinWidth="110" />
                                            <DataGridTextColumn Width="1.1*" Binding="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" Header="단일 그룹" MinWidth="100" />
                                            <DataGridTextColumn Width="1.8*" Binding="{Binding GroupNamesText, UpdateSourceTrigger=PropertyChanged}" Header="조합 그룹 (쉼표 순서)" MinWidth="170" />
                                            <DataGridTemplateColumn Width="120" Header="값 타입">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="6,0" VerticalAlignment="Center" Text="{Binding KindDisplayName}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox
                                                            DisplayMemberPath="DisplayName"
                                                            ItemsSource="{Binding DataContext.FieldKindChoices, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                            SelectedValue="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                            SelectedValuePath="Value" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridCheckBoxColumn Width="70" Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}" Header="필수" />
                                            <DataGridTextColumn Width="110" Binding="{Binding ParseFormat, UpdateSourceTrigger=PropertyChanged}" Header="입력 형식" />
                                            <DataGridTextColumn Width="110" Binding="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged}" Header="표시 형식" />
                                            <DataGridTemplateColumn Width="118" Header="순서 / 삭제">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                            <ui:Button
                                                                Margin="0,0,4,0"
                                                                AutomationProperties.Name="전문가 결과 컬럼 위로 이동"
                                                                Command="{Binding DataContext.MoveFieldUpCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                CommandParameter="{Binding}"
                                                                Icon="{ui:SymbolIcon Symbol=ArrowUp12}"
                                                                Style="{StaticResource IconOnlyButtonStyle}"
                                                                ToolTip="위로 이동" />
                                                            <ui:Button
                                                                Margin="0,0,4,0"
                                                                AutomationProperties.Name="전문가 결과 컬럼 아래로 이동"
                                                                Command="{Binding DataContext.MoveFieldDownCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                CommandParameter="{Binding}"
                                                                Icon="{ui:SymbolIcon Symbol=ArrowDown12}"
                                                                Style="{StaticResource IconOnlyButtonStyle}"
                                                                ToolTip="아래로 이동" />
                                                            <ui:Button
                                                                Appearance="Caution"
                                                                AutomationProperties.Name="전문가 결과 컬럼 삭제"
                                                                Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                CommandParameter="{Binding}"
                                                                Icon="{ui:SymbolIcon Symbol=Delete12}"
                                                                Style="{StaticResource IconOnlyButtonStyle}"
                                                                ToolTip="삭제" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <ui:Button
                                        Margin="0,0,0,20"
                                        HorizontalAlignment="Left"
                                        Command="{Binding AddFieldCommand}"
                                        Content="컬럼 추가"
                                        Icon="{ui:SymbolIcon Symbol=AddSquare20}" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="정규식 규칙" />
                                    <DataGrid
                                        Margin="0,4,0,8"
                                        MinHeight="160"
                                        HorizontalAlignment="Stretch"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        HeadersVisibility="Column"
                                        ItemsSource="{Binding DraftRules}"
                                        PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="120" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Header="규칙 ID" />
                                            <DataGridTemplateColumn Width="110" Header="매칭">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="6,0" VerticalAlignment="Center" Text="{Binding MatchModeDisplayName}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox
                                                            DisplayMemberPath="DisplayName"
                                                            ItemsSource="{Binding DataContext.MatchModeChoices, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                            SelectedValue="{Binding MatchMode, UpdateSourceTrigger=PropertyChanged}"
                                                            SelectedValuePath="Value" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridCheckBoxColumn Width="110" Binding="{Binding IgnoreCase, UpdateSourceTrigger=PropertyChanged}" Header="대소문자 무시" />
                                            <DataGridTextColumn Width="100" Binding="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" Header="제한 (ms)" />
                                            <DataGridTextColumn Width="3*" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Header="정규식 Pattern *" MinWidth="240" />
                                            <DataGridTextColumn Width="1.8*" Binding="{Binding StopTraversalGroupsText, UpdateSourceTrigger=PropertyChanged}" Header="탐색 중단 그룹 (쉼표 순서)" MinWidth="180" />
                                            <DataGridTemplateColumn Width="118" Header="순서 / 삭제">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                            <ui:Button
                                                                Margin="0,0,4,0"
                                                                AutomationProperties.Name="전문가 정규식 규칙 위로 이동"
                                                                Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                CommandParameter="{Binding}"
                                                                Icon="{ui:SymbolIcon Symbol=ArrowUp12}"
                                                                Style="{StaticResource IconOnlyButtonStyle}"
                                                                ToolTip="위로 이동" />
                                                            <ui:Button
                                                                Margin="0,0,4,0"
                                                                AutomationProperties.Name="전문가 정규식 규칙 아래로 이동"
                                                                Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                CommandParameter="{Binding}"
                                                                Icon="{ui:SymbolIcon Symbol=ArrowDown12}"
                                                                Style="{StaticResource IconOnlyButtonStyle}"
                                                                ToolTip="아래로 이동" />
                                                            <ui:Button
                                                                Appearance="Caution"
                                                                AutomationProperties.Name="전문가 정규식 규칙 삭제"
                                                                Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                CommandParameter="{Binding}"
                                                                Icon="{ui:SymbolIcon Symbol=Delete12}"
                                                                Style="{StaticResource IconOnlyButtonStyle}"
                                                                ToolTip="삭제" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <ui:Button
                                        HorizontalAlignment="Left"
                                        Command="{Binding AddRuleCommand}"
                                        Content="규칙 추가"
                                        Icon="{ui:SymbolIcon Symbol=AddSquare20}" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="ProfileReviewPanel"
                                IsEnabled="{Binding IsEditorReady}"
                                Style="{StaticResource EditorSectionStyle}"
                                Visibility="{Binding IsReviewStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="4. 검토하고 저장하기" />
                                    <TextBlock
                                        Margin="0,4,0,16"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="설정한 내용을 확인한 뒤 검증하고 저장하세요. 실제 경로 테스트는 저장 후 별도 Playground에서 현재 앱에 적용된 프로필로 실행합니다."
                                        TextWrapping="Wrap" />

                                    <UniformGrid Columns="2" Rows="2">
                                        <Border Margin="0,0,8,8" Style="{StaticResource FieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="프로필" />
                                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding DraftDisplayName}" />
                                                <TextBlock Margin="0,2,0,0" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DraftId}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="8,0,0,8" Style="{StaticResource FieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="편집 방식" />
                                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding EditorModeDisplay}" />
                                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="경로 규칙과 결과 컬럼" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,8,8,0" Style="{StaticResource FieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="구조화된 결과" />
                                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding DraftFields.Count, StringFormat={StaticResource Loc.Profiles.PathColumnCountFormat}}" />
                                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DraftTextFileFields.Count, StringFormat={StaticResource Loc.Profiles.TextFileColumnCountFormat}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="8,8,0,0" Style="{StaticResource FieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="탐색 동작" />
                                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding DraftRules.Count, StringFormat={StaticResource Loc.Profiles.PathRuleCountFormat}}" />
                                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DraftExcludedDirectoryNameRules.Count, StringFormat={StaticResource Loc.Profiles.ExclusionRuleCountFormat}}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <ui:InfoBar
                                        Margin="0,16,0,0"
                                        AutomationProperties.Name="프로필 저장과 Playground 안내"
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="아래에서 검증 오류를 확인한 뒤 저장하세요. 저장이 완료되면 ‘Playground에서 테스트’ 버튼이 활성화됩니다. 수정 후에는 다시 저장해야 최신 내용으로 테스트할 수 있습니다."
                                        Severity="Informational"
                                        Title="저장된 버전을 실제 경로에서 테스트" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        x:Name="EditorFooter"
                        Grid.Row="2"
                        Margin="8,12,8,8"
                        Style="{StaticResource FluentToolbarSurfaceStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button
                                    x:Name="PreviousProfileStepButton"
                                    MinWidth="88"
                                    Margin="0,0,12,0"
                                    AutomationProperties.HelpText="이전 프로필 설정 단계로 이동합니다."
                                    AutomationProperties.Name="이전 단계"
                                    Command="{Binding PreviousEditorStepCommand}"
                                    Content="이전"
                                    Icon="{ui:SymbolIcon Symbol=ArrowLeft20}" />
                                <TextBlock
                                    x:Name="EditorFooterStatusText"
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding EditorStatusMessage}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding EditorStatusMessage}" />
                                <ui:Button
                                    x:Name="NextProfileStepButton"
                                    Grid.Column="2"
                                    MinWidth="104"
                                    Appearance="Primary"
                                    AutomationProperties.HelpText="다음 프로필 설정 단계로 이동합니다."
                                    AutomationProperties.Name="다음 단계"
                                    Command="{Binding NextEditorStepCommand}"
                                    Content="다음"
                                    Icon="{ui:SymbolIcon Symbol=ArrowRight20}">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReviewStep}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsReviewStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ui:Button
                                        MinWidth="96"
                                        Margin="0,0,8,0"
                                        Command="{Binding ValidateDraftCommand}"
                                        Content="검증"
                                        Icon="{ui:SymbolIcon Symbol=CheckmarkCircle20}" />
                                    <ui:Button
                                        MinWidth="120"
                                        Appearance="Primary"
                                        Command="{Binding SaveDraftCommand}"
                                        Content="검증 후 저장"
                                        Icon="{ui:SymbolIcon Symbol=Save16}" />
                                    <ui:Button
                                        MinWidth="160"
                                        Margin="8,0,0,0"
                                        AutomationProperties.HelpText="마지막으로 저장되어 현재 앱에 적용된 프로필을 Playground에서 엽니다. 저장하지 않은 변경 사항이 있으면 비활성화됩니다."
                                        AutomationProperties.Name="저장된 프로필을 Playground에서 테스트"
                                        Command="{Binding OpenSavedProfileInPlaygroundCommand}"
                                        Content="Playground에서 테스트"
                                        Icon="{ui:SymbolIcon Symbol=DocumentSearch20}" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar
                                Grid.Row="1"
                                Height="3"
                                Margin="0,8,0,0"
                                IsIndeterminate="True"
                                Visibility="{Binding IsEditorBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="로드 상태">
                <ScrollViewer
                    x:Name="ProfileLoadStatusScrollViewer"
                    Style="{StaticResource FluentGutteredScrollViewerStyle}">
                    <StackPanel Margin="8,16,0,24">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="프로필 로드 상태" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource PageSubtitleTextStyle}"
                                Text="앱에서 사용할 수 있는 프로필을 선택하면 해석된 컬럼과 경로 규칙을 확인할 수 있습니다." />
                        </StackPanel>

                        <StackPanel>
                            <Border Margin="0,0,0,16" Style="{StaticResource FluentSurfaceStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="로드된 프로필" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="상세 내용을 볼 프로필을 선택하세요." />
                                    <DataGrid
                                        Grid.Row="2"
                                        MinHeight="280"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        HeadersVisibility="Column"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding Profiles}"
                                        PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        SelectedItem="{Binding SelectedProfile}"
                                        SelectionMode="Single"
                                        Style="{StaticResource FluentDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="*" Binding="{Binding DisplayName}" Header="표시 이름" MinWidth="140" />
                                            <DataGridTextColumn Width="90" Binding="{Binding Kind}" Header="정의 방식" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <StackPanel>
                                <Border Style="{StaticResource EditorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="선택한 프로필" />
                                        <TextBlock
                                            Margin="0,4,0,12"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding SelectedProfile.Id, StringFormat={StaticResource Loc.Profiles.ProfileIdFormat}}"
                                            TextTrimming="CharacterEllipsis" />
                                        <WrapPanel>
                                            <StackPanel MinWidth="120" Margin="0,0,16,8">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="버전" />
                                                <TextBlock Text="{Binding SelectedProfile.Version}" />
                                            </StackPanel>
                                            <StackPanel MinWidth="120" Margin="0,0,16,8">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="검색 대상" />
                                                <TextBlock Text="{Binding SelectedProfile.CandidateKind}" />
                                            </StackPanel>
                                            <StackPanel MinWidth="100" Margin="0,0,16,8">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="컬럼 수" />
                                                <TextBlock Text="{Binding SelectedProfile.FieldCount}" />
                                            </StackPanel>
                                            <StackPanel MinWidth="120" Margin="0,0,0,8">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="폴더 제외 규칙" />
                                                <TextBlock Text="{Binding SelectedProfile.ExcludedDirectoryRuleCount}" />
                                            </StackPanel>
                                            <StackPanel MinWidth="120" Margin="16,0,0,8">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="텍스트 파일 값" />
                                                <TextBlock Text="{Binding SelectedProfile.TextFileFieldCount}" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource EditorSectionStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="결과 컬럼" />
                                        <DataGrid
                                            Grid.Row="1"
                                            Margin="0,12,0,0"
                                            MinHeight="160"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding Fields}"
                                            PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            Style="{StaticResource FluentDataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="50" Binding="{Binding Order}" Header="#" />
                                                <DataGridTextColumn Width="1.4*" Binding="{Binding Header}" Header="표시 이름" MinWidth="110" />
                                                <DataGridTextColumn Width="1.2*" Binding="{Binding FieldId}" Header="Field ID" MinWidth="100" />
                                                <DataGridTextColumn Width="110" Binding="{Binding Source}" Header="값 출처" />
                                                <DataGridTextColumn Width="1.8*" Binding="{Binding CaptureGroups}" Header="정규식 그룹 (결합 순서)" MinWidth="160" />
                                                <DataGridTextColumn Width="90" Binding="{Binding Kind}" Header="값 타입" />
                                                <DataGridCheckBoxColumn Width="60" Binding="{Binding Required}" Header="필수" />
                                                <DataGridCheckBoxColumn Width="75" Binding="{Binding IsNullable}" Header="Nullable" />
                                                <DataGridTextColumn Width="100" Binding="{Binding ParseFormat}" Header="입력 형식" />
                                                <DataGridTextColumn Width="100" Binding="{Binding DisplayFormat}" Header="표시 형식" />
                                                <DataGridTextColumn Width="90" Binding="{Binding ValueMappings}" Header="값 매핑" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource EditorSectionStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="텍스트 파일 값" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="일치 폴더 바로 아래에서 파일 이름을 비교하고 내용을 읽는 컬럼입니다."
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <DataGrid
                                            Grid.Row="1"
                                            Margin="0,12,0,0"
                                            MinHeight="120"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding TextFileFields}"
                                            PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            Style="{StaticResource FluentDataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="50" Binding="{Binding Order}" Header="#" />
                                                <DataGridTextColumn Width="1.2*" Binding="{Binding Header}" Header="표시 이름" MinWidth="110" />
                                                <DataGridTextColumn Width="1.1*" Binding="{Binding FieldId}" Header="Field ID" MinWidth="100" />
                                                <DataGridTextColumn Width="2.2*" Binding="{Binding FileNamePattern}" Header="파일 이름 정규식" MinWidth="180" />
                                                <DataGridTextColumn Width="100" Binding="{Binding MatchMode}" Header="매칭" />
                                                <DataGridCheckBoxColumn Width="60" Binding="{Binding Required}" Header="필수" />
                                                <DataGridCheckBoxColumn Width="100" Binding="{Binding IgnoreCase}" Header="대소문자 무시" />
                                                <DataGridTextColumn Width="95" Binding="{Binding MaxBytes}" Header="최대 bytes" />
                                                <DataGridTextColumn Width="85" Binding="{Binding TimeoutMilliseconds}" Header="제한 ms" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource EditorSectionStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="경로 규칙" />
                                        <DataGrid
                                            Grid.Row="1"
                                            Margin="0,12,0,0"
                                            MinHeight="160"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding Rules}"
                                            PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            Style="{StaticResource FluentDataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="50" Binding="{Binding Order}" Header="#" />
                                                <DataGridTextColumn Width="110" Binding="{Binding Id}" Header="규칙 ID" />
                                                <DataGridTextColumn Width="90" Binding="{Binding MatchMode}" Header="매칭" />
                                                <DataGridCheckBoxColumn Width="110" Binding="{Binding IgnoreCase}" Header="대소문자 무시" />
                                                <DataGridTextColumn Width="90" Binding="{Binding TimeoutMilliseconds}" Header="제한 (ms)" />
                                                <DataGridTextColumn Width="3*" Binding="{Binding Pattern}" Header="정규식 Pattern" MinWidth="240" />
                                                <DataGridTextColumn Width="1.6*" Binding="{Binding StopTraversalGroups}" Header="하위 탐색 중단 그룹" MinWidth="160" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Margin="0" Style="{StaticResource FluentSurfaceStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="탐색 제외 폴더 이름 규칙" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="바로 스캔에서 현재 폴더의 마지막 이름에만 적용됩니다."
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <DataGrid
                                            Grid.Row="1"
                                            Margin="0,12,0,0"
                                            MinHeight="120"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding ExcludedDirectoryNameRules}"
                                            PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            Style="{StaticResource FluentDataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="50" Binding="{Binding Order}" Header="#" />
                                                <DataGridTextColumn Width="120" Binding="{Binding Id}" Header="규칙 ID" />
                                                <DataGridTextColumn Width="130" Binding="{Binding MatchMode}" Header="폴더 이름 매칭" />
                                                <DataGridCheckBoxColumn Width="110" Binding="{Binding IgnoreCase}" Header="대소문자 무시" />
                                                <DataGridTextColumn Width="90" Binding="{Binding TimeoutMilliseconds}" Header="제한 (ms)" />
                                                <DataGridTextColumn Width="3*" Binding="{Binding Pattern}" Header="정규식 Pattern" MinWidth="240" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Expander Margin="0,16,0,0" Header="고급: 플러그인 및 선언형 프로필 진단">
                            <Border Margin="0,8,0,0" Style="{StaticResource FluentSurfaceStyle}">
                                <DataGrid
                                    MinHeight="160"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding Reports}"
                                    PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    Style="{StaticResource FluentDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="100" Binding="{Binding StatusText}" Header="로드 상태" />
                                        <DataGridTextColumn Width="1.5*" Binding="{Binding DisplayName}" Header="표시 이름" />
                                        <DataGridTextColumn Width="1.4*" Binding="{Binding ProfileId}" Header="프로필 ID" />
                                        <DataGridTextColumn Width="3*" Binding="{Binding Diagnostics}" Header="검증 및 진단 메시지" />
                                        <DataGridTextColumn Width="2.5*" Binding="{Binding SourceDirectory}" Header="원본 폴더" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
