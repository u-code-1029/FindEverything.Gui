<Page
    x:Class="FindEverything.Desktop.Views.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="clr-namespace:FindEverything.Desktop.Localization"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:FindEverything.Desktop.ViewModels"
    Title="{DynamicResource Loc.Shell.Nav.Profiles}"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    localization:LocalizationScope.IsEnabled="True"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="ColumnWidthChoiceTemplate">
            <ComboBox MinWidth="120" HorizontalAlignment="Stretch"
                AutomationProperties.Name="{DynamicResource Loc.Profiles.ColumnWidth.Label}"
                ToolTip="{DynamicResource Loc.Profiles.ColumnWidth.Help}"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding DataContext.ColumnWidthChoices, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                SelectedValue="{Binding WidthPreset, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="Value" />
        </DataTemplate>
        <DataTemplate x:Key="ColumnWidthEditorTemplate">
            <StackPanel Margin="0,12,0,0">
                <ui:TextBlock Margin="0,0,0,4" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Loc.Profiles.ColumnWidth.Label}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ColumnWidthChoiceTemplate}" HorizontalContentAlignment="Stretch" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="EditorSectionStyle" BasedOn="{StaticResource FluentCardStyle}" TargetType="ui:CardControl">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style
            x:Key="IconOnlyButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="GuidedEditorSectionStyle" BasedOn="{StaticResource EditorSectionStyle}" TargetType="ui:CardControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGuidedMode}" Value="True" />
                        <Condition Binding="{Binding IsPathAndFieldsStep}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExpertEditorSectionStyle" BasedOn="{StaticResource EditorSectionStyle}" TargetType="ui:CardControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsExpertMode}" Value="True" />
                        <Condition Binding="{Binding IsPathAndFieldsStep}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="GuidedModeChoiceStyle"
            BasedOn="{StaticResource {x:Type RadioButton}}"
            TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Inset editors belong to their section card; avoid repeating the full outer-card treatment. -->
        <Style x:Key="FieldCardStyle" BasedOn="{StaticResource FluentCardStyle}" TargetType="ui:CardControl">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <controls:WorkspacePageFrame x:Name="ProfilePageLayout" SizeChanged="OnProfileWorkspaceSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <controls:PageHeader Title="{DynamicResource Loc.Shell.Nav.Profiles}" Description="{DynamicResource Loc.Workspace.Profiles.Description}">
            <controls:WorkspaceTransferPanel x:Name="ProfilesWorkspaceTransferPanel" DataContext="{Binding WorkspaceTransfer}" ShowProfileExport="True" ShowPackageExport="False" ShowSourceSelector="False"
                Profile="{Binding DataContext.ExportProfileCandidate, RelativeSource={RelativeSource AncestorType=Page}}"/>
            </controls:PageHeader>
        </StackPanel>

        <ui:TabView
            x:Name="ProfilesTabControl"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <ui:TabViewItem Header="{DynamicResource Loc.View.Profiles.Header.EditProfile}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:SectionCard
                        x:Name="ProfileEditorStepRail"
                        Grid.Row="0"
                        Margin="0,4,0,0"
                        Padding="12"
                        AutomationProperties.ItemStatus="{Binding EditorStepStatus}"
                        ToolTip="{Binding NumericValidationMessage}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.ProfileSetupSteps}"
                        IsEnabled="{Binding IsEditorReady}"
                        Style="{StaticResource FluentToolbarCardStyle}">
                        <controls:SectionCard.Header>
                        <UniformGrid x:Name="ProfileStepButtons" Columns="4">
                            <RadioButton
                                Margin="0,0,8,0"
                                Padding="10,8"
                                AutomationProperties.HelpText="{DynamicResource Loc.View.Profiles.AutomationHelpText.ChooseAProfileAndSetItsBasic}"
                                AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.Step1ProfileInformation}"
                                Command="{Binding GoToEditorStepCommand}"
                                CommandParameter="{x:Static viewModels:ProfileEditorStep.Profile}"
                                Content="{DynamicResource Loc.View.Profiles.Content.1ProfileInformation}"
                                GroupName="ProfileEditorSteps"
                                IsChecked="{Binding IsProfileStep, Mode=OneWay}" />
                            <RadioButton
                                Margin="0,0,8,0"
                                Padding="10,8"
                                AutomationProperties.HelpText="{DynamicResource Loc.View.Profiles.AutomationHelpText.DefineResultColumnsFromARealPath}"
                                AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.Step2PathAndColumns}"
                                Command="{Binding GoToEditorStepCommand}"
                                CommandParameter="{x:Static viewModels:ProfileEditorStep.PathAndFields}"
                                Content="{DynamicResource Loc.View.Profiles.Content.2PathAndColumns}"
                                GroupName="ProfileEditorSteps"
                                IsChecked="{Binding IsPathAndFieldsStep, Mode=OneWay}" />
                            <RadioButton
                                Margin="0,0,8,0"
                                Padding="10,8"
                                AutomationProperties.HelpText="{DynamicResource Loc.View.Profiles.AutomationHelpText.ConfigureExcludedFoldersAndValuesReadFrom}"
                                AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.Step3ScanOptions}"
                                Command="{Binding GoToEditorStepCommand}"
                                CommandParameter="{x:Static viewModels:ProfileEditorStep.ScanOptions}"
                                Content="{DynamicResource Loc.View.Profiles.Content.3ScanOptions}"
                                GroupName="ProfileEditorSteps"
                                IsChecked="{Binding IsScanOptionsStep, Mode=OneWay}" />
                            <RadioButton
                                Padding="10,8"
                                AutomationProperties.HelpText="{DynamicResource Loc.View.Profiles.AutomationHelpText.ValidateAndSaveTheProfileThenContinue}"
                                AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.Step4ReviewAndSave}"
                                Command="{Binding GoToEditorStepCommand}"
                                CommandParameter="{x:Static viewModels:ProfileEditorStep.Review}"
                                Content="{DynamicResource Loc.View.Profiles.Content.4ReviewAndSave}"
                                GroupName="ProfileEditorSteps"
                                IsChecked="{Binding IsReviewStep, Mode=OneWay}" />
                        </UniformGrid>
                        </controls:SectionCard.Header>
                    </controls:SectionCard>

                    <ui:DynamicScrollViewer
                        x:Name="ProfileEditorScrollViewer"
                        Grid.Row="1"
                        Style="{StaticResource FluentGutteredScrollViewerStyle}">
                        <StackPanel Margin="0,8,0,0"><ui:TextBlock Margin="0,0,0,8" Text="{Binding NumericValidationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding HasNumericValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite" />
                            <controls:SectionCard
                                Style="{StaticResource EditorSectionStyle}"
                                Visibility="{Binding IsProfileStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <controls:SectionCard.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.MyProfiles}" />
                                    <ui:TextBlock
                                        Grid.Row="1"
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{DynamicResource Loc.View.Profiles.Text.SelectAnExistingProfileToEditOr}" />

                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ui:TextBlock
                                            x:Name="EditableProfileLabel"
                                            Style="{StaticResource FieldLabelStyle}"
                                            Text="{DynamicResource Loc.View.Profiles.AutomationName.ProfileToEdit}" />
                                        <ComboBox
                                            x:Name="EditableProfileComboBox"
                                            Grid.Row="1"
                                            AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.ProfileToEdit}"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding EditableProfiles}"
                                            SelectedItem="{Binding SelectedEditableProfile}" />
                                        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                            <ui:Button
                                                MinWidth="112"
                                                Margin="0,0,8,8"
                                                Command="{Binding LoadDraftCommand}"
                                                Content="{DynamicResource Loc.View.Profiles.Content.OpenSelectedProfile}"
                                                Icon="{ui:SymbolIcon Symbol=DocumentEdit20}" />
                                            <ui:Button
                                                MinWidth="112"
                                                Margin="0,0,8,8"
                                                Command="{Binding NewDraftCommand}"
                                                Content="{DynamicResource Loc.View.Profiles.Content.NewProfile}"
                                                Icon="{ui:SymbolIcon Symbol=AddSquare20}" />
                                            <ui:Button
                                                MinWidth="120"
                                                Margin="0,0,0,8"
                                                Command="{Binding OpenUserProfilesFolderCommand}"
                                                Content="{DynamicResource Loc.View.Profiles.Content.OpenProfilesFolder}"
                                                Icon="{ui:SymbolIcon Symbol=FolderOpen20}" />
                                        </WrapPanel>
                                    </Grid>
                                </Grid>
                                </controls:SectionCard.Header>
                            </controls:SectionCard>

                            <controls:SectionCard
                                IsEnabled="{Binding IsEditorReady}"
                                Style="{StaticResource EditorSectionStyle}"
                                Visibility="{Binding IsScanOptionsStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <controls:SectionCard.Header>
                                <StackPanel>
                                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.DisplayValueMappings}" />
                                    <ui:TextBlock
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{DynamicResource Loc.View.Profiles.Text.ShowShortCodesFromThePathAs}"
                                        TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding DraftFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:SectionCard
                                                    Style="{StaticResource FieldCardStyle}"
                                                    Visibility="{Binding ShowValueMappingEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <controls:SectionCard.Header>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <ui:TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Header}" />
                                                                <ui:TextBlock
                                                                    Margin="0,4,0,0"
                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                    Text="{Binding ValueMappingDescription}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <controls:DisplayBadge
                                                                Grid.Column="1"
                                                                Margin="12,0,0,0"
                                                                Padding="8,4"
                                                                VerticalAlignment="Top"
                                                                Visibility="{Binding HasAliasGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <ui:TextBlock FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Text="alias" />
                                                            </controls:DisplayBadge>
                                                        </Grid>

                                                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding ValueMappings}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <ui:TextBox
                                                                            AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.MappingOriginalValue}"
                                                                            PlaceholderText="{DynamicResource Loc.View.Profiles.PlaceholderText.OriginalValueExampleA}"
                                                                            Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <ui:SymbolIcon
                                                                            Grid.Column="1"
                                                                            Margin="10,0"
                                                                            VerticalAlignment="Center"
                                                                            Symbol="ArrowRight16" />
                                                                        <ui:TextBox
                                                                            Grid.Column="2"
                                                                            AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.MappingDisplayValue}"
                                                                            PlaceholderText="{DynamicResource Loc.View.Profiles.PlaceholderText.DisplayValueExampleAlexKim}"
                                                                            Text="{Binding Display, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <ui:Button
                                                                            Grid.Column="3"
                                                                            Width="34"
                                                                            Height="32"
                                                                            Margin="8,0,0,0"
                                                                            Appearance="Caution"
                                                                            AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.DeleteValueMapping}"
                                                                            Command="{Binding DataContext.RemoveValueMappingCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{ui:SymbolIcon Symbol=Delete12}"
                                                                            Style="{StaticResource IconOnlyButtonStyle}"
                                                                            ToolTip="{DynamicResource Loc.View.Profiles.ToolTip.DeleteMapping}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ui:Button
                                                            HorizontalAlignment="Left"
                                                            AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.AddValueMapping}"
                                                            Command="{Binding AddValueMappingCommand}"
                                                            Content="{DynamicResource Loc.View.Profiles.Content.AddOriginalDisplayValue}"
                                                            Icon="{ui:SymbolIcon Symbol=AddSquare20}" />
                                                    </StackPanel>
                                                    </controls:SectionCard.Header>
                                                </controls:SectionCard>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{DynamicResource Loc.View.Profiles.Text.OnlyTextFieldsCanBeMappedOriginal}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                </controls:SectionCard.Header>
                            </controls:SectionCard>

                            <controls:SectionCard
                                IsEnabled="{Binding IsEditorReady}"
                                Style="{StaticResource EditorSectionStyle}"
                                Visibility="{Binding IsProfileStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <controls:SectionCard.Header>
                                <StackPanel>
                                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.EditingMode}" />
                                    <ui:TextBlock
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{DynamicResource Loc.View.Profiles.Text.IfYouAreNewToRegularExpressions}"
                                        TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <RadioButton
                                            AutomationProperties.Name="{DynamicResource Loc.Profiles.EditorMode.Guided}"
                                            Command="{Binding UseGuidedModeCommand}"
                                            Content="{DynamicResource Loc.View.Profiles.Content.BeginnerPickValuesFromAPath}"
                                            GroupName="ProfileEditorMode"
                                            IsEnabled="{Binding CanUseGuidedMode}"
                                            IsChecked="{Binding IsGuidedMode, Mode=OneWay}"
                                            Style="{StaticResource GuidedModeChoiceStyle}" />
                                        <RadioButton
                                            AutomationProperties.Name="{DynamicResource Loc.Profiles.EditorMode.Expert}"
                                            Command="{Binding UseExpertModeCommand}"
                                            Content="{DynamicResource Loc.View.Profiles.Content.ExpertEnterRegularExpressions}"
                                            GroupName="ProfileEditorMode"
                                            IsChecked="{Binding IsExpertMode, Mode=OneWay}"
                                            Style="{StaticResource GuidedModeChoiceStyle}" />
                                    </WrapPanel>
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{DynamicResource Loc.View.Profiles.Text.IfTheReturnToBeginnerButtonIs}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                </controls:SectionCard.Header>
                            </controls:SectionCard>

                            <controls:SectionCard
                                IsEnabled="{Binding IsEditorReady}"
                                Style="{StaticResource EditorSectionStyle}"
                                Visibility="{Binding IsProfileStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <controls:SectionCard.Header>
                                <StackPanel>
                                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.1BasicInformation}" />
                                    <ui:TextBlock
                                        Margin="0,4,0,16"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{DynamicResource Loc.View.Profiles.Text.ChooseAListDisplayNameAndA}" />

                                    <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Loc.View.Profiles.Text.DisplayName}" />
                                    <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.TheNameUsersSeeInTheProfile}" />
                                    <ui:TextBox
                                        Margin="0,4,0,12"
                                        AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.ProfileDisplayName}"
                                        ClearButtonEnabled="True"
                                        PlaceholderText="{DynamicResource Loc.View.Profiles.PlaceholderText.ExampleProjectFolders}"
                                        Text="{Binding DraftDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                    <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Loc.View.Profiles.Text.ProfileID}" />
                                    <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.StartWithALowercaseLetterOrNumber}" />
                                    <ui:TextBox
                                        Margin="0,4,0,12"
                                        AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.ProfileID}"
                                        ClearButtonEnabled="True"
                                        IsEnabled="{Binding CanEditDraftId}"
                                        PlaceholderText="{DynamicResource Loc.View.Profiles.PlaceholderText.ExampleMyProjects}"
                                        Text="{Binding DraftId, UpdateSourceTrigger=PropertyChanged}" />

                                    <ui:InfoBar
                                        Margin="0,4,0,0"
                                        AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.AbsolutePathInputGuidance}"
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="규칙과 테스트에는 절대 경로만 전달됩니다. 매핑된 네트워크 드라이브는 실제 UNC 경로로 자동 변환됩니다."
                                        Severity="Informational"
                                        Title="{DynamicResource Loc.View.Profiles.Title.AlwaysUseAbsolutePaths}" />
                                </StackPanel>
                                </controls:SectionCard.Header>
                            </controls:SectionCard>

                            <controls:SectionCard
                                IsEnabled="{Binding IsEditorReady}"
                                Style="{StaticResource EditorSectionStyle}"
                                Visibility="{Binding IsScanOptionsStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <controls:SectionCard.Header>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.Profiles.Text.ScanOptimizationFinalFolderNamesToExclude}" />
                                            <ui:TextBlock
                                                x:Name="DirectoryExclusionScopeDescription"
                                                Margin="0,4,0,0"
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{DynamicResource Loc.View.Profiles.Text.TheFinalFolderNameLeafIsThe}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:Button
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.AddFolderNameExclusionRule}"
                                            Command="{Binding AddDirectoryExclusionRuleCommand}"
                                            Content="{DynamicResource Loc.View.Profiles.Content.AddRule}"
                                            Icon="{ui:SymbolIcon Symbol=AddSquare20}" />
                                    </Grid>

                                    <controls:SectionCard
                                        Margin="0,12,0,12"
                                        Padding="12"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6" Style="{StaticResource FluentCardStyle}">
                                        <controls:SectionCard.Header>
                                        <StackPanel AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.FolderNameExclusionRuleScope}">
                                            <ui:TextBlock TextWrapping="Wrap">
                                                <Run FontWeight="SemiBold" Text="{DynamicResource Loc.View.Profiles.Text.InputExample}" />
                                                <Run FontFamily="Consolas" Text="C:\abc\def\name" />
                                                <Run Text="{DynamicResource Loc.View.Profiles.Text.ValuePassedToTheRegularExpression}" />
                                                <Run FontFamily="Consolas" FontWeight="SemiBold" Text="name" />
                                                <Run Text="{DynamicResource Loc.View.Profiles.Text.Label}" />
                                            </ui:TextBlock>
                                            <ui:TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                                <Run FontFamily="Consolas" Text="Full + name" />
                                                <Run Text="{DynamicResource Loc.View.Profiles.Text.MatchesOnlyWhenTheEntireFinalFolder}" />
                                                <Run FontFamily="Consolas" Text="name" />
                                                <Run Text="{DynamicResource Loc.View.Profiles.Text.AMatchRemovesThatFolderFromResult}" />
                                            </ui:TextBlock>
                                        </StackPanel>
                                        </controls:SectionCard.Header>
                                    </controls:SectionCard>

                                    <ItemsControl ItemsSource="{Binding DraftExcludedDirectoryNameRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:SectionCard Style="{StaticResource FieldCardStyle}">
                                                    <controls:SectionCard.Header>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Loc.View.Profiles.Text.RuleID}" />
                                                                <ui:TextBox
                                                                    AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.FolderExclusionRuleID}"
                                                                    PlaceholderText="{DynamicResource Loc.View.Profiles.PlaceholderText.ExampleSkipCache}"
                                                                    Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Loc.View.Profiles.Text.FolderNameRegularExpression}" />
                                                                <ui:TextBox
                                                                    AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.ExcludedFolderNameRegularExpression}"
                                                                    PlaceholderText="{DynamicResource Loc.View.Profiles.PlaceholderText.ExampleNameOrTempCache}"
                                                                    Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <ui:Button
                                                                Grid.Column="3"
                                                                Width="34"
                                                                Height="32"
                                                                Margin="10,24,0,0"
                                                                VerticalAlignment="Top"
                                                                Appearance="Caution"
                                                                AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.DeleteFolderNameExclusionRule}"
                                                                Command="{Binding DataContext.RemoveDirectoryExclusionRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                CommandParameter="{Binding}"
                                                                Icon="{ui:SymbolIcon Symbol=Delete12}"
                                                                Style="{StaticResource IconOnlyButtonStyle}"
                                                                ToolTip="{DynamicResource Loc.View.Profiles.ToolTip.DeleteRule}" />
                                                        </Grid>

                                                        <Grid Margin="0,12,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="160" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Loc.View.Profiles.Text.MatchMode}" />
                                                                <ComboBox
                                                                    AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.FolderNameExclusionMatchMode}"
                                                                    DisplayMemberPath="DisplayName"
                                                                    ItemsSource="{Binding DataContext.MatchModeChoices, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                    SelectedValue="{Binding MatchMode, UpdateSourceTrigger=PropertyChanged}"
                                                                    SelectedValuePath="Value" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Loc.View.Profiles.Text.TimeoutMs}" />
                                                                <ui:TextBox
                                                                    AutomationProperties.Name="{DynamicResource Loc.View.Profiles.AutomationName.FolderExclusionRegularExpressionTimeout}"
                                                                    Text="{Binding TimeoutMillisecondsText, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <CheckBox
                                                                Grid.Column="3"
