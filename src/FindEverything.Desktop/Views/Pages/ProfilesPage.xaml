<Page
    x:Class="FindEverything.Desktop.Views.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="clr-namespace:FindEverything.Desktop.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:FindEverything.Desktop.ViewModels"
    Title="프로필"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    localization:LocalizationScope.IsEnabled="True"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="EditorSectionStyle" BasedOn="{StaticResource FluentSurfaceStyle}" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style
            x:Key="IconOnlyButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="GuidedEditorSectionStyle" BasedOn="{StaticResource EditorSectionStyle}" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGuidedMode}" Value="True" />
                        <Condition Binding="{Binding IsPathAndFieldsStep}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExpertEditorSectionStyle" BasedOn="{StaticResource EditorSectionStyle}" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsExpertMode}" Value="True" />
                        <Condition Binding="{Binding IsPathAndFieldsStep}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="GuidedModeChoiceStyle"
            BasedOn="{StaticResource {x:Type RadioButton}}"
            TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,20,0,16">
            <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleTextStyle}" Text="프로필" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource PageSubtitleTextStyle}"
                Text="네 단계로 경로와 결과 구조를 정의하고 저장합니다. 실제 경로 테스트는 저장 후 Playground에서 진행합니다." />
        </StackPanel>

        <TabControl
            x:Name="ProfilesTabControl"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <TabItem Header="프로필 편집">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="ProfileEditorStepRail"
                        Grid.Row="0"
                        Margin="8,12,8,0"
                        Padding="12"
                        AutomationProperties.ItemStatus="{Binding EditorStepStatus}"
                        AutomationProperties.Name="프로필 설정 단계"
                        IsEnabled="{Binding IsEditorReady}"
                        Style="{StaticResource FluentToolbarSurfaceStyle}">
                        <UniformGrid Columns="4">
                            <RadioButton
                                Margin="0,0,8,0"
                                Padding="10,8"
                                AutomationProperties.HelpText="프로필 선택과 기본 정보를 설정합니다."
                                AutomationProperties.Name="1단계 프로필 정보"
                                Command="{Binding GoToEditorStepCommand}"
                                CommandParameter="{x:Static viewModels:ProfileEditorStep.Profile}"
                                Content="1  프로필 정보"
                                GroupName="ProfileEditorSteps"
                                IsChecked="{Binding IsProfileStep, Mode=OneWay}" />
                            <RadioButton
                                Margin="0,0,8,0"
                                Padding="10,8"
                                AutomationProperties.HelpText="실제 경로 또는 정규식으로 결과 컬럼을 정의합니다."
                                AutomationProperties.Name="2단계 경로와 컬럼"
                                Command="{Binding GoToEditorStepCommand}"
                                CommandParameter="{x:Static viewModels:ProfileEditorStep.PathAndFields}"
                                Content="2  경로와 컬럼"
                                GroupName="ProfileEditorSteps"
                                IsChecked="{Binding IsPathAndFieldsStep, Mode=OneWay}" />
                            <RadioButton
                                Margin="0,0,8,0"
                                Padding="10,8"
                                AutomationProperties.HelpText="제외 폴더와 텍스트 파일 값을 설정합니다."
                                AutomationProperties.Name="3단계 탐색 옵션"
                                Command="{Binding GoToEditorStepCommand}"
                                CommandParameter="{x:Static viewModels:ProfileEditorStep.ScanOptions}"
                                Content="3  탐색 옵션"
                                GroupName="ProfileEditorSteps"
                                IsChecked="{Binding IsScanOptionsStep, Mode=OneWay}" />
                            <RadioButton
                                Padding="10,8"
                                AutomationProperties.HelpText="프로필을 검증하고 저장한 뒤 Playground로 이동합니다."
                                AutomationProperties.Name="4단계 검토와 저장"
                                Command="{Binding GoToEditorStepCommand}"
                                CommandParameter="{x:Static viewModels:ProfileEditorStep.Review}"
                                Content="4  검토와 저장"
                                GroupName="ProfileEditorSteps"
                                IsChecked="{Binding IsReviewStep, Mode=OneWay}" />
                        </UniformGrid>
                    </Border>

                    <ScrollViewer
                        x:Name="ProfileEditorScrollViewer"
                        Grid.Row="1"
                        Style="{StaticResource FluentGutteredScrollViewerStyle}">
                        <StackPanel Margin="8,16,0,0">
                            <Border
                                Style="{StaticResource EditorSectionStyle}"
                                Visibility="{Binding IsProfileStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="내 프로필" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="기존 프로필을 선택해 수정하거나 새 프로필을 만드세요." />

                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ComboBox
                                            AutomationProperties.Name="편집할 프로필"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding EditableProfiles}"
                                            SelectedItem="{Binding SelectedEditableProfile}" />
                                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                            <ui:Button
                                                MinWidth="112"
                                                Margin="0,0,8,8"
                                                Command="{Binding LoadDraftCommand}"
                                                Content="선택 항목 열기"
                                                Icon="{ui:SymbolIcon Symbol=DocumentEdit20}" />
                                            <ui:Button
                                                MinWidth="112"
                                                Margin="0,0,8,8"
                                                Command="{Binding NewDraftCommand}"
                                                Content="새로 만들기"
                                                Icon="{ui:SymbolIcon Symbol=AddSquare20}" />
                                            <ui:Button
                                                MinWidth="120"
                                                Margin="0,0,0,8"
                                                Command="{Binding OpenUserProfilesFolderCommand}"
                                                Content="프로필 폴더 열기"
                                                Icon="{ui:SymbolIcon Symbol=FolderOpen20}" />
                                        </WrapPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border
                                IsEnabled="{Binding IsEditorReady}"
                                Style="{StaticResource EditorSectionStyle}"
                                Visibility="{Binding IsScanOptionsStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="표시 값 매핑" />
                                    <TextBlock
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="경로에서 읽은 짧은 코드를 사람이 읽기 쉬운 이름으로 보여줍니다. 실제 모델과 원본 값은 바꾸지 않습니다."
                                        TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding DraftFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Style="{StaticResource FieldCardStyle}"
                                                    Visibility="{Binding ShowValueMappingEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Header}" />
                                                                <TextBlock
                                                                    Margin="0,3,0,0"
                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                    Text="{Binding ValueMappingDescription}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Border
                                                                Grid.Column="1"
                                                                Margin="12,0,0,0"
                                                                Padding="8,3"
                                                                VerticalAlignment="Top"
                                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                CornerRadius="10"
                                                                Visibility="{Binding HasAliasGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Text="alias" />
                                                            </Border>
                                                        </Grid>

                                                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding ValueMappings}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <ui:TextBox
                                                                            AutomationProperties.Name="매핑 원본 값"
                                                                            PlaceholderText="원본 값 (예: A)"
                                                                            Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <ui:SymbolIcon
                                                                            Grid.Column="1"
                                                                            Margin="10,0"
                                                                            VerticalAlignment="Center"
                                                                            Symbol="ArrowRight16" />
                                                                        <ui:TextBox
                                                                            Grid.Column="2"
                                                                            AutomationProperties.Name="매핑 표시 값"
                                                                            PlaceholderText="표시 값 (예: 홍길동)"
                                                                            Text="{Binding Display, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <ui:Button
                                                                            Grid.Column="3"
                                                                            Width="34"
                                                                            Height="32"
                                                                            Margin="8,0,0,0"
                                                                            Appearance="Caution"
                                                                            AutomationProperties.Name="값 매핑 삭제"
                                                                            Command="{Binding DataContext.RemoveValueMappingCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{ui:SymbolIcon Symbol=Delete12}"
                                                                            Style="{StaticResource IconOnlyButtonStyle}"
                                                                            ToolTip="매핑 삭제" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ui:Button
                                                            HorizontalAlignment="Left"
                                                            AutomationProperties.Name="값 매핑 추가"
                                                            Command="{Binding AddValueMappingCommand}"
                                                            Content="원본 → 표시 값 추가"
                                                            Icon="{ui:SymbolIcon Symbol=AddSquare20}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="텍스트 필드만 매핑할 수 있으며 원본 값은 대소문자를 구분해 정확히 비교합니다. 구조화 보기에서 언제든 원본 값으로 전환할 수 있습니다."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                IsEnabled="{Binding IsEditorReady}"
                                Style="{StaticResource EditorSectionStyle}"
                                Visibility="{Binding IsProfileStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="편집 방법" />
                                    <TextBlock
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="처음이라면 실제 경로에서 값을 고르는 초보자 모드를 사용하세요. 기존 정규식은 전문가 모드에서 그대로 유지됩니다."
                                        TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <RadioButton
                                            AutomationProperties.Name="초보자 모드"
                                            Command="{Binding UseGuidedModeCommand}"
                                            Content="초보자 · 경로에서 값 고르기"
                                            GroupName="ProfileEditorMode"
                                            IsEnabled="{Binding CanUseGuidedMode}"
                                            IsChecked="{Binding IsGuidedMode, Mode=OneWay}"
                                            Style="{StaticResource GuidedModeChoiceStyle}" />
                                        <RadioButton
                                            AutomationProperties.Name="전문가 모드"
                                            Command="{Binding UseExpertModeCommand}"
                                            Content="전문가 · 정규식 직접 입력"
                                            GroupName="ProfileEditorMode"
                                            IsChecked="{Binding IsExpertMode, Mode=OneWay}"
                                            Style="{StaticResource GuidedModeChoiceStyle}" />
                                    </WrapPanel>
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="초보자 모드로 돌아가기 버튼이 비활성화되면, 현재 전문가 규칙을 단순한 경로 템플릿으로 손실 없이 바꿀 수 없다는 뜻입니다."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                IsEnabled="{Binding IsEditorReady}"
                                Style="{StaticResource EditorSectionStyle}"
                                Visibility="{Binding IsProfileStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="1. 기본 정보" />
                                    <TextBlock
                                        Margin="0,4,0,16"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="목록에 표시할 이름과 프로필을 식별할 ID를 정합니다." />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="표시 이름 *" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="사용자가 프로필 목록에서 보게 되는 이름입니다." />
                                    <ui:TextBox
                                        Margin="0,4,0,12"
                                        AutomationProperties.Name="프로필 표시 이름"
                                        ClearButtonEnabled="True"
                                        PlaceholderText="예: 프로젝트 폴더"
                                        Text="{Binding DraftDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="프로필 ID *" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="소문자 영문 또는 숫자로 시작하고 점과 하이픈을 사용할 수 있습니다. 최대 64자입니다." />
                                    <ui:TextBox
                                        Margin="0,4,0,12"
                                        AutomationProperties.Name="프로필 ID"
                                        ClearButtonEnabled="True"
                                        IsEnabled="{Binding CanEditDraftId}"
                                        PlaceholderText="예: my-projects"
                                        Text="{Binding DraftId, UpdateSourceTrigger=PropertyChanged}" />

                                    <ui:InfoBar
                                        Margin="0,4,0,0"
                                        AutomationProperties.Name="절대 경로 입력 안내"
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="규칙과 테스트에는 절대 경로만 전달됩니다. 매핑된 네트워크 드라이브는 실제 UNC 경로로 자동 변환됩니다."
                                        Severity="Informational"
                                        Title="항상 절대 경로 사용" />
                                </StackPanel>
                            </Border>

                            <Border
                                IsEnabled="{Binding IsEditorReady}"
                                Style="{StaticResource EditorSectionStyle}"
                                Visibility="{Binding IsScanOptionsStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="탐색 최적화 · 제외할 마지막 폴더 이름" />
                                            <TextBlock
                                                x:Name="DirectoryExclusionScopeDescription"
                                                Margin="0,4,0,0"
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="마지막 폴더 이름(leaf)은 절대경로에서 마지막 경로 구분자(\ 또는 /) 뒤에 있는 이름입니다. 이 제외 규칙에는 절대경로 전체가 아니라 그 이름 하나만 전달되며, 드라이브·UNC 주소와 상위 폴더는 비교하지 않습니다."
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:Button
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="폴더 이름 제외 규칙 추가"
                                            Command="{Binding AddDirectoryExclusionRuleCommand}"
                                            Content="규칙 추가"
                                            Icon="{ui:SymbolIcon Symbol=AddSquare20}" />
                                    </Grid>

                                    <Border
                                        Margin="0,12,0,12"
                                        Padding="12"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <StackPanel AutomationProperties.Name="폴더 이름 제외 규칙 적용 범위 안내">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run FontWeight="SemiBold" Text="입력 예시: " />
                                                <Run FontFamily="Consolas" Text="C:\abc\def\name" />
                                                <Run Text=" → 정규식에 전달되는 값은 " />
                                                <Run FontFamily="Consolas" FontWeight="SemiBold" Text="name" />
                                                <Run Text="입니다." />
                                            </TextBlock>
                                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                                <Run FontFamily="Consolas" Text="Full + name" />
                                                <Run Text="이면 마지막 폴더 이름 전체가 정확히 " />
                                                <Run FontFamily="Consolas" Text="name" />
                                                <Run Text="일 때만 제외합니다. 일치하면 그 폴더 자체를 결과 후보에서 제외하고 하위 폴더로 들어가지 않지만, 같은 상위 경로의 다른 형제 폴더는 계속 탐색합니다." />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding DraftExcludedDirectoryNameRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource FieldCardStyle}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="규칙 ID *" />
                                                                <ui:TextBox
                                                                    AutomationProperties.Name="폴더 제외 규칙 ID"
                                                                    PlaceholderText="예: skip-cache"
                                                                    Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="폴더 이름 정규식 *" />
                                                                <ui:TextBox
                                                                    AutomationProperties.Name="제외할 폴더 이름 정규식"
                                                                    PlaceholderText="예: name 또는 temp|cache"
                                                                    Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <ui:Button
                                                                Grid.Column="3"
                                                                Width="34"
                                                                Height="32"
                                                                Margin="10,22,0,0"
                                                                VerticalAlignment="Top"
                                                                Appearance="Caution"
                                                                AutomationProperties.Name="폴더 이름 제외 규칙 삭제"
                                                                Command="{Binding DataContext.RemoveDirectoryExclusionRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                CommandParameter="{Binding}"
                                                                Icon="{ui:SymbolIcon Symbol=Delete12}"
                                                                Style="{StaticResource IconOnlyButtonStyle}"
                                                                ToolTip="규칙 삭제" />
                                                        </Grid>

                                                        <Grid Margin="0,12,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="160" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="비교 방식" />
                                                                <ComboBox
                                                                    AutomationProperties.Name="폴더 이름 제외 비교 방식"
                                                                    DisplayMemberPath="DisplayName"
                                                                    ItemsSource="{Binding DataContext.MatchModeChoices, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                    SelectedValue="{Binding MatchMode, UpdateSourceTrigger=PropertyChanged}"
                                                                    SelectedValuePath="Value" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="시간 제한 (ms)" />
                                                                <ui:TextBox
                                                                    AutomationProperties.Name="폴더 제외 정규식 시간 제한"
                                                                    Text="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <CheckBox
                                                                Grid.Column="3"
                                                                Margin="16,25,0,0"
                                                                VerticalAlignment="Top"
                                                                Content="대소문자 무시"
                                                                IsChecked="{Binding IgnoreCase, UpdateSourceTrigger=PropertyChanged}" />
                                                        </Grid>
                                                        <TextBlock
