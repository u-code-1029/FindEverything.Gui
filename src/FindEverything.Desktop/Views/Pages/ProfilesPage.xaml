                                        IsOpen="True"
                                        Message="정규식에는 전체 경로가 아닌 파일 이름만 전달됩니다. 여러 파일이 맞으면 파일 이름을 대소문자 무시 오름차순으로 정렬해 첫 파일을 사용합니다. UTF-8을 기본으로 읽고 BOM이 있으면 해당 인코딩을 감지합니다."
                                        Severity="Informational"
                                        Title="바로 아래의 첫 일치 파일" />

                                    <ItemsControl ItemsSource="{Binding DraftTextFileFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource FieldCardStyle}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="표시 이름 *" />
                                                                <ui:TextBox
                                                                    AutomationProperties.Name="텍스트 파일 필드 표시 이름"
                                                                    PlaceholderText="예: 설명"
                                                                    Text="{Binding Header, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Field ID *" />
                                                                <ui:TextBox
                                                                    AutomationProperties.Name="텍스트 파일 Field ID"
                                                                    PlaceholderText="예: description"
                                                                    Text="{Binding FieldId, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <ui:Button
                                                                Grid.Column="3"
                                                                Width="34"
                                                                Height="32"
                                                                Margin="10,22,0,0"
                                                                VerticalAlignment="Top"
                                                                Appearance="Caution"
                                                                AutomationProperties.Name="텍스트 파일 필드 삭제"
                                                                Command="{Binding DataContext.RemoveTextFileFieldCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                CommandParameter="{Binding}"
                                                                Icon="{ui:SymbolIcon Symbol=Delete12}"
                                                                Style="{StaticResource IconOnlyButtonStyle}"
                                                                ToolTip="파일 값 삭제" />
                                                        </Grid>

                                                        <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabelStyle}" Text="파일 이름 정규식 *" />
                                                        <ui:TextBox
                                                            AutomationProperties.Name="텍스트 파일 이름 정규식"
                                                            PlaceholderText="예: ^metadata\.txt$ 또는 ^info-\d+\.txt$"
                                                            Text="{Binding FileNamePattern, UpdateSourceTrigger=PropertyChanged}" />

                                                        <Grid Margin="0,12,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="파일 이름 비교" />
                                                                <ComboBox
                                                                    AutomationProperties.Name="텍스트 파일 이름 비교 방식"
                                                                    DisplayMemberPath="DisplayName"
                                                                    ItemsSource="{Binding DataContext.MatchModeChoices, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                    SelectedValue="{Binding MatchMode, UpdateSourceTrigger=PropertyChanged}"
                                                                    SelectedValuePath="Value" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="읽기 제한 (bytes)" />
                                                                <ui:TextBox
                                                                    AutomationProperties.Name="텍스트 파일 읽기 바이트 제한"
                                                                    Text="{Binding MaxBytes, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="시간 제한 (ms)" />
                                                                <ui:TextBox
                                                                    AutomationProperties.Name="텍스트 파일 정규식 시간 제한"
                                                                    Text="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="6">
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="컬럼 순서" />
                                                                <ui:TextBox
                                                                    AutomationProperties.Name="텍스트 파일 컬럼 순서"
                                                                    Text="{Binding Order, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <WrapPanel Margin="0,12,0,0">
                                                            <CheckBox
                                                                Margin="0,0,20,0"
                                                                Content="필수 파일"
                                                                IsChecked="{Binding Required, UpdateSourceTrigger=PropertyChanged}"
