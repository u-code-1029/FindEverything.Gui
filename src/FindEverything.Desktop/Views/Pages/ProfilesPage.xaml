                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <ui:Button
                                                                                    MinWidth="52"
                                                                                    Margin="0,0,4,4"
                                                                                    AutomationProperties.Name="폴더명 세부 조각 선택"
                                                                                    Appearance="Secondary"
                                                                                    Command="{Binding DataContext.AssignPathChoiceCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Content="{Binding DisplayName}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock
                                        Margin="0,4,0,4"
