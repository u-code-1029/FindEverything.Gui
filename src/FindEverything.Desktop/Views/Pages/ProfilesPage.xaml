<Page
    x:Class="FindEverything.Desktop.Views.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:FindEverything.Desktop.ViewModels"
    Title="{StaticResource Loc.Shell.Nav.Profiles}"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="ColumnWidthChoiceTemplate">
            <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}" HorizontalAlignment="Stretch"
                AutomationProperties.Name="{StaticResource Loc.Profiles.ColumnWidth.Label}"
                ToolTip="{StaticResource Loc.Profiles.ColumnWidth.Help}"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding DataContext.ColumnWidthChoices, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                SelectedValue="{Binding WidthPreset, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="Value" />
        </DataTemplate>
        <DataTemplate x:Key="ColumnWidthEditorTemplate">
            <StackPanel Margin="0,12,0,0">
                <ui:TextBlock Margin="0,0,0,4" FontSize="14" FontWeight="SemiBold" Text="{StaticResource Loc.Profiles.ColumnWidth.Label}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ColumnWidthChoiceTemplate}" HorizontalContentAlignment="Stretch" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="EditorSectionStyle" BasedOn="{StaticResource FluentCardStyle}" TargetType="ui:CardControl">
            <Setter Property="Margin" Value="{StaticResource SectionGap}" />
        </Style>
        <Style
            x:Key="IconOnlyButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style
            x:Key="GuidedModeChoiceStyle"
            BasedOn="{StaticResource {x:Type RadioButton}}"
            TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Keep radio semantics and arrow-key navigation while presenting the
             setup steps as a small, theme-aware segmented navigation rail. -->
        <Style x:Key="ProfileStepChoiceStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.HelpText)}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Padding="{TemplateBinding Padding}" CornerRadius="8"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </Style.Triggers>
        </Style>
        <!-- Inset editors belong to their section card; avoid repeating the full outer-card treatment. -->
        <Style x:Key="FieldCardStyle" BasedOn="{StaticResource FluentCardStyle}" TargetType="ui:CardControl">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="ProfileEditorVirtualListStyle" TargetType="controls:ProfileEditorList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="VirtualizingPanel.CacheLength" Value="0.5" />
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value><DataTemplate>
                    <controls:ProfileEditorEntryPresenter Entry="{Binding}" Focusable="False" />
                </DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value><Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                </Style></Setter.Value>
            </Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:ProfileEditorList">
                <ScrollViewer x:Name="PART_ScrollViewer" CanContentScroll="True"
                    Style="{StaticResource FluentGutteredScrollViewerStyle}" Focusable="False" IsTabStop="False">
                    <ItemsPresenter />
                </ScrollViewer>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="ProfileEditor.ValidationIssues">
            <controls:SectionCard x:Name="ProfileValidationIssuesCard"
                Margin="0,0,0,16" Style="{StaticResource FluentCardStyle}"
                Visibility="{Binding HasValidationIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SectionCard.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{StaticResource Loc.Profiles.Validation.IssuesTitle}"
                            FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            AutomationProperties.LiveSetting="Polite" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ValidationIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ProfileValidationIssueViewModel}">
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Margin="0,4,16,4" VerticalAlignment="Center"
                                            Text="{Binding Message}" TextWrapping="Wrap"
                                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                            ToolTip="{Binding Code}" />
                                        <ui:Button Grid.Column="1" Padding="12,8" VerticalAlignment="Center"
                                            Content="{Binding NavigationText}"
                                            Icon="{ui:SymbolIcon Symbol=ArrowRight16}"
                                            ToolTip="{StaticResource Loc.Profiles.Validation.GoToStepHelp}"
                                            Command="{Binding DataContext.GoToEditorStepCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                            CommandParameter="{Binding Step}"
                                            IsEnabled="{Binding DataContext.IsEditorReady, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </controls:SectionCard.Header>
            </controls:SectionCard>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Item.Profile.1">
            <controls:SectionCard
                Style="{StaticResource EditorSectionStyle}">
                <controls:SectionCard.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{StaticResource Loc.View.Profiles.Text.MyProfiles}" />
                    <ui:TextBlock
                        Grid.Row="1"
                        Margin="0,4,0,12"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="{StaticResource Loc.View.Profiles.Text.SelectAnExistingProfileToEditOr}" />

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            x:Name="EditableProfileLabel"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="{StaticResource Loc.View.Profiles.AutomationName.ProfileToEdit}" />
                        <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}"
                            x:Name="EditableProfileComboBox"
                            Grid.Row="1"
                            AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.ProfileToEdit}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding EditableProfiles}"
                            SelectedItem="{Binding SelectedEditableProfile}" />
                        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                            <ui:Button
                                MinWidth="112"
                                Margin="0,0,8,8"
                                Command="{Binding LoadDraftCommand}"
                                Content="{StaticResource Loc.View.Profiles.Content.OpenSelectedProfile}"
                                Icon="{ui:SymbolIcon Symbol=DocumentEdit20}" />
                            <ui:Button
                                MinWidth="112"
                                Margin="0,0,8,8"
                                Command="{Binding NewDraftCommand}"
                                Content="{StaticResource Loc.View.Profiles.Content.NewProfile}"
                                Icon="{ui:SymbolIcon Symbol=AddSquare20}" />
                            <ui:Button
                                MinWidth="120"
                                Margin="0,0,0,8"
                                Command="{Binding OpenUserProfilesFolderCommand}"
                                Content="{StaticResource Loc.View.Profiles.Content.OpenProfilesFolder}"
                                Icon="{ui:SymbolIcon Symbol=FolderOpen20}" />
                        </WrapPanel>
                    </Grid>
                </Grid>
                </controls:SectionCard.Header>
            </controls:SectionCard>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Item.Profile.2">
            <controls:SectionCard
                IsEnabled="{Binding IsEditorReady}"
                Style="{StaticResource EditorSectionStyle}">
                <controls:SectionCard.Header>
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{StaticResource Loc.Ux.Authoring.PathMode}" />
                    <ui:TextBlock
                        Margin="0,4,0,12"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="{StaticResource Loc.Ux.Authoring.PathMode.Help}"
                        TextWrapping="Wrap" />
                    <WrapPanel>
                        <RadioButton
                            AutomationProperties.Name="{StaticResource Loc.Profiles.EditorMode.Guided}"
                            Command="{Binding UseGuidedModeCommand}"
                            Content="{StaticResource Loc.View.Profiles.Content.BeginnerPickValuesFromAPath}"
                            GroupName="ProfileEditorMode"
                            IsEnabled="{Binding CanUseGuidedMode}"
                            IsChecked="{Binding IsGuidedMode, Mode=OneWay}"
                            Style="{StaticResource GuidedModeChoiceStyle}" />
                        <RadioButton
                            AutomationProperties.Name="{StaticResource Loc.Profiles.EditorMode.Expert}"
                            Command="{Binding UseExpertModeCommand}"
                            Content="{StaticResource Loc.View.Profiles.Content.ExpertEnterRegularExpressions}"
                            GroupName="ProfileEditorMode"
                            IsChecked="{Binding IsExpertMode, Mode=OneWay}"
                            Style="{StaticResource GuidedModeChoiceStyle}" />
                    </WrapPanel>
                    <ui:TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{StaticResource Loc.View.Profiles.Text.IfTheReturnToBeginnerButtonIs}"
                        TextWrapping="Wrap" />
                </StackPanel>
                </controls:SectionCard.Header>
            </controls:SectionCard>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Item.Profile.3">
            <controls:SectionCard
                IsEnabled="{Binding IsEditorReady}"
                Style="{StaticResource EditorSectionStyle}">
                <controls:SectionCard.Header>
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{StaticResource Loc.View.Profiles.Text.1BasicInformation}" />
                    <ui:TextBlock
                        Margin="0,4,0,16"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="{StaticResource Loc.View.Profiles.Text.ChooseAListDisplayNameAndA}" />

                    <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{StaticResource Loc.View.Profiles.Text.DisplayName}" />
                    <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.View.Profiles.Text.TheNameUsersSeeInTheProfile}" />
                    <ui:TextBox
                        Margin="0,4,0,12"
                        AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.ProfileDisplayName}"
                        ClearButtonEnabled="True"
                        PlaceholderText="{StaticResource Loc.View.Profiles.PlaceholderText.ExampleProjectFolders}"
                        Text="{Binding DraftDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{StaticResource Loc.View.Profiles.Text.ProfileID}" />
                    <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.View.Profiles.Text.StartWithALowercaseLetterOrNumber}" />
                    <ui:TextBox
                        Margin="0,4,0,12"
                        AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.ProfileID}"
                        ClearButtonEnabled="True"
                        IsEnabled="{Binding CanEditDraftId}"
                        PlaceholderText="{StaticResource Loc.View.Profiles.PlaceholderText.ExampleMyProjects}"
                        Text="{Binding DraftId, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:InfoBar
                        Margin="0,4,0,0"
                        AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.AbsolutePathInputGuidance}"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{StaticResource Loc.View.ProfilesPage.Message.RulesAndTestsAlwaysReceiveAbsolutePathsMapped}"
                        Severity="Informational"
                        Title="{StaticResource Loc.View.Profiles.Title.AlwaysUseAbsolutePaths}" />
                </StackPanel>
                </controls:SectionCard.Header>
            </controls:SectionCard>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Item.Profile.EntryPathsHeader">
            <controls:SectionCard Style="{StaticResource EditorSectionStyle}">
                <controls:SectionCard.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{StaticResource Loc.Profiles.EntryPaths.Title}" />
                        <ui:TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" Text="{StaticResource Loc.Profiles.EntryPaths.Help}" />
                        <WrapPanel>
                            <ui:Button Margin="0,0,8,8" Command="{Binding BrowseEntryPathCommand}" Content="{StaticResource Loc.Profiles.EntryPaths.Browse}"
                                Icon="{ui:SymbolIcon Symbol=FolderAdd20}" />
                            <ui:Button Margin="0,0,8,8" Command="{Binding AddEntryPathCommand}" Content="{StaticResource Loc.Profiles.EntryPaths.Add}"
                                Icon="{ui:SymbolIcon Symbol=Add20}" />
                            <ui:TextBlock Margin="0,0,0,8" VerticalAlignment="Center" Text="{Binding EntryPathsSummary}" Style="{StaticResource CaptionTextStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </controls:SectionCard.Header>
            </controls:SectionCard>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Item.Profile.EntryPath">
            <controls:SectionCard Style="{StaticResource FieldCardStyle}">
                <controls:SectionCard.Header>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="ProfileEntryPathInput" Margin="0,0,8,0" ClearButtonEnabled="True"
                            Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{StaticResource Loc.Profiles.EntryPaths.Path}"
                            AutomationProperties.Name="{StaticResource Loc.Profiles.EntryPaths.Path}" ToolTip="{Binding Path}" />
                        <ui:Button Grid.Column="1" Margin="0,0,4,0" Style="{StaticResource IconOnlyButtonStyle}"
                            Command="{Binding DataContext.BrowseEntryPathCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                            CommandParameter="{Binding}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}"
                            AutomationProperties.Name="{StaticResource Loc.Profiles.EntryPaths.BrowsePath}" ToolTip="{StaticResource Loc.Profiles.EntryPaths.BrowsePath}" />
                        <ui:Button Grid.Column="2" Style="{StaticResource IconOnlyButtonStyle}"
                            Command="{Binding DataContext.RemoveEntryPathCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                            CommandParameter="{Binding}" Icon="{ui:SymbolIcon Symbol=Delete20}"
                            AutomationProperties.Name="{StaticResource Loc.Profiles.EntryPaths.Remove}" ToolTip="{StaticResource Loc.Profiles.EntryPaths.Remove}" />
                    </Grid>
                </controls:SectionCard.Header>
            </controls:SectionCard>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Item.PathGuided.1">
            <controls:SectionCard Style="{StaticResource EditorSectionStyle}" IsEnabled="{Binding IsEditorReady}"><controls:SectionCard.Header><StackPanel>
            <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="{StaticResource Loc.View.Profiles.Text.PasteARealPath}" />
            <ui:TextBlock
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{StaticResource Loc.View.Profiles.Text.UseACompleteRealFolderPathIncluding}"
                                        TextWrapping="Wrap" />
            <DockPanel Margin="0,8,0,0">
            <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding BuildTemplateFromSampleCommand}"
                Content="{StaticResource Loc.View.Profiles.Content.AnalyzePath}" Icon="{ui:SymbolIcon Symbol=ArrowDown20}" />
            <ui:TextBox
                                        AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.RealPathUsedToBuildTheRule}"
                                        ClearButtonEnabled="True"
                                        PlaceholderText="{StaticResource Loc.View.Profiles.PlaceholderText.ExampleCArchiveClientProject2026Rev}"
                                        Text="{Binding SamplePath, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <ui:CardExpander x:Name="GeneratedPathRuleExpander" Margin="0,8,0,0" IsExpanded="False"
                Header="{StaticResource Loc.Ux.Authoring.GeneratedRule}">
            <ui:TextBox
                                        x:Name="ProfilePathTemplateTextBox"
                                        Margin="0,4,0,20"
                                        AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.BeginnerPathRule}"
                                        ClearButtonEnabled="False"
                                        FontFamily="Consolas"
                                        FontSize="14"
                                        IsReadOnly="True"
                                        PlaceholderText="{StaticResource Loc.View.Profiles.PlaceholderText.PasteARealPathAboveFirst}"
                                        Text="{Binding DraftPathTemplate, Mode=OneWay}" />
            </ui:CardExpander>
            </StackPanel></controls:SectionCard.Header></controls:SectionCard>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Item.PathGuided.2">
            <controls:SectionCard
                x:Name="AssignmentPickerPanel" IsVisibleChanged="OnAssignmentPickerVisibilityChanged"
                Margin="0"
                Padding="12"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="8"
                Visibility="{Binding HasAnalyzedPath, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource FluentCardStyle}">
                <controls:SectionCard.Header>
                <StackPanel>
                    <ui:TextBlock FontWeight="SemiBold" Text="{StaticResource Loc.Ux.Authoring.ConnectTitle}" />
                    <Grid Margin="0,8,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}" x:Name="GuidedFieldPicker" ItemsSource="{Binding DraftFields}" SelectedItem="{Binding SelectedGuidedField}"
                            DisplayMemberPath="Header" AutomationProperties.Name="{StaticResource Loc.Ux.Authoring.SelectField}" />
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding AddFieldCommand}" Content="{StaticResource Loc.View.Profiles.AutomationName.AddResultValue}" Icon="{ui:SymbolIcon Symbol=AddSquare20}" />
                    </Grid>
                    <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.Ux.Authoring.ConnectHelp}" />
                    <ui:TextBlock Margin="0,4,0,8" FontWeight="SemiBold" Text="{Binding SelectedGuidedField.SourceSummary}" TextWrapping="Wrap" />
                    <DockPanel Margin="0,0,0,8">
                        <ui:TextBlock Margin="0,0,12,0" Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.Ux.Authoring.SelectedSample}" />
                        <ui:TextBlock FontFamily="Consolas" Text="{Binding SelectedGuidedField.GuidedSampleInput}" TextWrapping="Wrap" />
                    </DockPanel>
                    <ui:TextBlock FontWeight="SemiBold" Text="{Binding AssignmentPickerTitle}" TextWrapping="Wrap" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding GuidedPathSegments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,8,8" Orientation="Horizontal">
                                    <ui:TextBlock
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Prefix}" />
                                    <controls:SectionCard
                                        Padding="8"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6" Style="{StaticResource FluentCardStyle}">
                                        <controls:SectionCard.Header>
                                        <StackPanel>
                                            <ui:Button
                                                AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.SelectWholeFolderName}"
                                                Command="{Binding DataContext.AssignPathChoiceCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                CommandParameter="{Binding WholeChoice}"
                                                Content="{Binding WholeChoice.DisplayName}" />
                                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding PartChoices}">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPartChoices}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ui:Button
                                                            MinWidth="52"
                                                            Margin="0,0,4,4"
                                                            AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.SelectFolderNameSubsegment}"
                                                            Appearance="Secondary"
                                                            Command="{Binding DataContext.AssignPathChoiceCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        </controls:SectionCard.Header>
                                    </controls:SectionCard>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </controls:SectionCard.Header>
            </controls:SectionCard>
        </DataTemplate>
        <DataTemplate x:Key="ProfileEditor.Item.PathGuided.3">
            <controls:SectionCard Style="{StaticResource FieldCardStyle}">
                <controls:SectionCard.Header>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{Binding Header}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,4,0"
                                AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.MoveResultValueUp}"
                                Command="{Binding DataContext.MoveFieldUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding}"
                                Icon="{ui:SymbolIcon Symbol=ArrowUp12}"
                                Style="{StaticResource IconOnlyButtonStyle}"
                                ToolTip="{StaticResource Loc.View.Profiles.ToolTip.MoveUp}" />
                            <ui:Button
                                Margin="0,0,4,0"
                                AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.MoveResultValueDown}"
                                Command="{Binding DataContext.MoveFieldDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding}"
                                Icon="{ui:SymbolIcon Symbol=ArrowDown12}"
                                Style="{StaticResource IconOnlyButtonStyle}"
                                ToolTip="{StaticResource Loc.View.Profiles.ToolTip.MoveDown}" />
                            <ui:Button
                                Appearance="Caution"
                                AutomationProperties.Name="{StaticResource Loc.View.Profiles.AutomationName.DeleteResultValue}"
                                Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding}"
                                Icon="{ui:SymbolIcon Symbol=Delete12}"
                                Style="{StaticResource IconOnlyButtonStyle}"
                                ToolTip="{StaticResource Loc.Common.Delete}" />
                        </StackPanel>
                    </Grid>

                    <ui:TextBlock Margin="0,12,0,4" Style="{StaticResource FieldLabelStyle}" Text="{StaticResource Loc.View.Profiles.Text.NameShownInTheList}" />
                    <ui:TextBox
