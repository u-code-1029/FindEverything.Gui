<Page
    x:Class="FindEverything.Desktop.Views.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="프로필"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="EditorSectionStyle" BasedOn="{StaticResource FluentSurfaceStyle}" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="ActionableEditorInfoBarStyle" TargetType="ui:InfoBar">
            <Setter Property="IsOpen" Value="False" />
            <Setter Property="IsClosable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EditorStatusSeverity}" Value="{x:Static ui:InfoBarSeverity.Warning}">
                    <Setter Property="IsOpen" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EditorStatusSeverity}" Value="{x:Static ui:InfoBarSeverity.Error}">
                    <Setter Property="IsOpen" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconOnlyButtonStyle" TargetType="ui:Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="GuidedEditorSectionStyle" BasedOn="{StaticResource EditorSectionStyle}" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGuidedMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExpertEditorSectionStyle" BasedOn="{StaticResource EditorSectionStyle}" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GuidedModeChoiceStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,20,0,16">
            <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleTextStyle}" Text="프로필" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource PageSubtitleTextStyle}"
                Text="경로에서 어떤 정보를 읽을지 화면에서 정의하고, 저장 전에 실제 경로로 결과를 확인합니다." />
        </StackPanel>

        <TabControl
            x:Name="ProfilesTabControl"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <TabItem Header="프로필 편집">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer
                        x:Name="ProfileEditorScrollViewer"
                        Grid.Row="0"
                        HorizontalContentAlignment="Stretch"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,16,8,0">
                            <Border Style="{StaticResource EditorSectionStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="내 프로필" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="기존 프로필을 선택해 수정하거나 새 프로필을 만드세요." />

                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ComboBox
                                            AutomationProperties.Name="편집할 프로필"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding EditableProfiles}"
                                            SelectedItem="{Binding SelectedEditableProfile}" />
                                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                            <ui:Button
                                                MinWidth="112"
                                                Margin="0,0,8,8"
                                                Command="{Binding LoadDraftCommand}"
                                                Content="선택 항목 열기"
                                                Icon="{ui:SymbolIcon Symbol=DocumentEdit20}" />
                                            <ui:Button
                                                MinWidth="112"
                                                Margin="0,0,8,8"
                                                Command="{Binding NewDraftCommand}"
                                                Content="새로 만들기"
                                                Icon="{ui:SymbolIcon Symbol=AddSquare20}" />
                                            <ui:Button
                                                MinWidth="120"
                                                Margin="0,0,0,8"
                                                Command="{Binding OpenUserProfilesFolderCommand}"
                                                Content="프로필 폴더 열기"
                                                Icon="{ui:SymbolIcon Symbol=FolderOpen20}" />
                                        </WrapPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border IsEnabled="{Binding IsEditorReady}" Style="{StaticResource EditorSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="편집 방법" />
                                    <TextBlock
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="처음이라면 실제 경로에서 값을 고르는 초보자 모드를 사용하세요. 기존 정규식은 전문가 모드에서 그대로 유지됩니다."
                                        TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <RadioButton
                                            AutomationProperties.Name="초보자 모드"
                                            Command="{Binding UseGuidedModeCommand}"
                                            Content="초보자 · 경로에서 값 고르기"
                                            IsEnabled="{Binding CanUseGuidedMode}"
                                            IsChecked="{Binding IsGuidedMode, Mode=OneWay}"
                                            Style="{StaticResource GuidedModeChoiceStyle}" />
                                        <RadioButton
                                            AutomationProperties.Name="전문가 모드"
                                            Command="{Binding UseExpertModeCommand}"
                                            Content="전문가 · 정규식 직접 입력"
                                            IsChecked="{Binding IsExpertMode, Mode=OneWay}"
                                            Style="{StaticResource GuidedModeChoiceStyle}" />
                                    </WrapPanel>
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="초보자 모드로 돌아가기 버튼이 비활성화되면, 현재 전문가 규칙을 단순한 경로 템플릿으로 손실 없이 바꿀 수 없다는 뜻입니다."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border IsEnabled="{Binding IsEditorReady}" Style="{StaticResource EditorSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="1. 기본 정보" />
                                    <TextBlock
                                        Margin="0,4,0,16"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="목록에 표시할 이름과 프로필을 식별할 ID를 정합니다." />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="표시 이름 *" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="사용자가 프로필 목록에서 보게 되는 이름입니다." />
                                    <ui:TextBox
                                        Margin="0,4,0,12"
                                        AutomationProperties.Name="프로필 표시 이름"
                                        ClearButtonEnabled="True"
                                        PlaceholderText="예: 프로젝트 폴더"
                                        Text="{Binding DraftDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="프로필 ID *" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="소문자 영문 또는 숫자로 시작하고 점과 하이픈을 사용할 수 있습니다. 최대 64자입니다." />
                                    <ui:TextBox
                                        Margin="0,4,0,12"
                                        AutomationProperties.Name="프로필 ID"
                                        ClearButtonEnabled="True"
                                        IsEnabled="{Binding CanEditDraftId}"
                                        PlaceholderText="예: my-projects"
                                        Text="{Binding DraftId, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="규칙에 넣을 경로" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="상대 경로는 선택한 검색 위치를 제외하고, 전체 경로는 드라이브부터 규칙에 전달합니다." />
                                    <ComboBox
                                        Margin="0,4,0,0"
                                        AutomationProperties.Name="규칙 경로 방식"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding PathInputChoices}"
                                        SelectedItem="{Binding SelectedPathInput}" />
                                </StackPanel>
                            </Border>

                            <Border IsEnabled="{Binding IsEditorReady}" Style="{StaticResource GuidedEditorSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="2. 실제 경로에서 결과 값 고르기" />
                                    <TextBlock
                                        Margin="0,4,0,16"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="정규식을 몰라도 괜찮습니다. 실제 경로를 붙여 넣고, 매번 달라지는 글자를 결과 값으로 바꾸면 됩니다."
                                        TextWrapping="Wrap" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="① 실제 경로 붙여넣기" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="위에서 선택한 경로 방식과 같은 형태의 폴더 경로를 사용하세요."
                                        TextWrapping="Wrap" />
                                    <ui:TextBox
                                        Margin="0,4,0,8"
                                        AutomationProperties.Name="규칙을 만들 실제 경로"
                                        ClearButtonEnabled="True"
                                        PlaceholderText="예: 고객사\프로젝트\2026\Rev-3"
                                        Text="{Binding SamplePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Margin="0,0,0,20"
                                        HorizontalAlignment="Left"
                                        Command="{Binding BuildTemplateFromSampleCommand}"
                                        Content="이 경로로 시작"
                                        Icon="{ui:SymbolIcon Symbol=ArrowDown20}" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="② 바뀌는 글자 선택하기" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="아래 경로에서 예를 들어 ‘고객사’를 마우스로 선택한 다음, 해당 결과 값 카드의 파란 버튼을 누르세요."
                                        TextWrapping="Wrap" />
                                    <ui:TextBox
                                        x:Name="ProfilePathTemplateTextBox"
                                        Margin="0,4,0,20"
                                        AutomationProperties.Name="초보자 경로 규칙"
                                        ClearButtonEnabled="False"
                                        FontFamily="Consolas"
                                        FontSize="14"
                                        PlaceholderText="먼저 위에 실제 경로를 붙여 넣으세요."
                                        Text="{Binding DraftPathTemplate, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="③ 보여줄 결과 값 만들기" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="각 카드는 목록의 한 컬럼이 됩니다. 필수 값을 끄면 경로 끝에 없어도 됩니다."
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:Button
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="결과 값 추가"
                                            Command="{Binding AddFieldCommand}"
                                            Content="결과 값 추가"
                                            Icon="{ui:SymbolIcon Symbol=AddSquare20}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding DraftFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource FieldCardStyle}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="15"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding Header}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal">
                                                                <ui:Button
                                                                    Margin="0,0,4,0"
                                                                    AutomationProperties.Name="결과 값 위로 이동"
                                                                    Command="{Binding DataContext.MoveFieldUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                    CommandParameter="{Binding}"
                                                                    Icon="{ui:SymbolIcon Symbol=ArrowUp12}"
                                                                    Style="{StaticResource IconOnlyButtonStyle}"
                                                                    ToolTip="위로 이동" />
                                                                <ui:Button
                                                                    Margin="0,0,4,0"
                                                                    AutomationProperties.Name="결과 값 아래로 이동"
                                                                    Command="{Binding DataContext.MoveFieldDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                    CommandParameter="{Binding}"
                                                                    Icon="{ui:SymbolIcon Symbol=ArrowDown12}"
                                                                    Style="{StaticResource IconOnlyButtonStyle}"
                                                                    ToolTip="아래로 이동" />
                                                                <ui:Button
                                                                    Appearance="Caution"
                                                                    AutomationProperties.Name="결과 값 삭제"
                                                                    Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                    CommandParameter="{Binding}"
                                                                    Icon="{ui:SymbolIcon Symbol=Delete12}"
                                                                    Style="{StaticResource IconOnlyButtonStyle}"
                                                                    ToolTip="삭제" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock Margin="0,12,0,4" Style="{StaticResource FieldLabelStyle}" Text="목록에 보일 이름" />
                                                        <ui:TextBox
                                                            AutomationProperties.Name="결과 값 이름"
                                                            ClearButtonEnabled="True"
                                                            PlaceholderText="예: 고객사"
                                                            Text="{Binding Header, UpdateSourceTrigger=PropertyChanged}" />

                                                        <TextBlock Margin="0,12,0,4" Style="{StaticResource FieldLabelStyle}" Text="값의 종류" />
                                                        <ComboBox
                                                            AutomationProperties.Name="결과 값 종류"
                                                            DisplayMemberPath="DisplayName"
                                                            ItemsSource="{Binding DataContext.FieldKindChoices, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                            SelectedValue="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                            SelectedValuePath="Value" />

                                                        <CheckBox
                                                            Margin="0,12,0,12"
                                                            AutomationProperties.Name="필수 결과 값"
                                                            Content="이 값은 경로에 반드시 있어야 함"
                                                            IsChecked="{Binding Required, UpdateSourceTrigger=PropertyChanged}" />

                                                        <ui:Button
                                                            HorizontalAlignment="Stretch"
                                                            Appearance="Primary"
                                                            AutomationProperties.Name="선택한 경로 부분을 결과 값으로 지정"
                                                            Click="OnInsertTemplateFieldClick"
                                                            Content="{Binding TemplateActionLabel}"
                                                            Icon="{ui:SymbolIcon Symbol=ArrowSwap20}" />

                                                        <Expander
                                                            Margin="0,12,0,0"
                                                            HorizontalContentAlignment="Stretch"
                                                            Header="고급 표시 형식">
                                                            <StackPanel Margin="0,8,0,0">
                                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="이 값의 내부 키" />
                                                                <TextBlock Margin="0,2,0,12" FontFamily="Consolas" Text="{Binding FieldId}" />
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="입력 형식" />
                                                                <ui:TextBox
                                                                    Margin="0,4,0,12"
                                                                    PlaceholderText="날짜 예: yyyyMMdd"
                                                                    Text="{Binding ParseFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="표시 형식" />
                                                                <ui:TextBox
                                                                    Margin="0,4,0,0"
                                                                    PlaceholderText="예: yyyy-MM-dd 또는 N2"
                                                                    Text="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ui:InfoBar
                                        Margin="0,4,0,0"
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{Binding TemplateStatusMessage}"
                                        Severity="{Binding TemplateStatusSeverity}"
                                        Title="경로 규칙 확인" />

                                    <Expander
                                        Margin="0,12,0,0"
                                        HorizontalContentAlignment="Stretch"
                                        Header="전문가용: 만들어진 정규식 보기">
                                        <TextBox
                                            Margin="0,8,0,0"
                                            Padding="8"
                                            FontFamily="Consolas"
                                            IsReadOnly="True"
                                            Text="{Binding GeneratedPatternPreview}"
                                            TextWrapping="Wrap" />
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border IsEnabled="{Binding IsEditorReady}" Style="{StaticResource ExpertEditorSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="2. 전문가 규칙 편집" />
                                    <TextBlock
                                        Margin="0,4,0,16"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="결과 컬럼과 정규식을 직접 연결합니다. 복수 규칙, 부분 일치, 고급 정규식이 필요할 때 사용하세요."
                                        TextWrapping="Wrap" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="결과 컬럼" />
                                    <DataGrid
                                        Margin="0,4,0,8"
                                        MinHeight="160"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        HeadersVisibility="Column"
                                        ItemsSource="{Binding DraftFields}"
                                        PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="1.3*" Binding="{Binding Header, UpdateSourceTrigger=PropertyChanged}" Header="표시 이름" MinWidth="120" />
                                            <DataGridTextColumn Width="1.2*" Binding="{Binding FieldId, UpdateSourceTrigger=PropertyChanged}" Header="Field ID *" MinWidth="110" />
                                            <DataGridTextColumn Width="1.2*" Binding="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" Header="정규식 그룹 *" MinWidth="110" />
                                            <DataGridTemplateColumn Width="120" Header="값 타입">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="6,0" VerticalAlignment="Center" Text="{Binding KindDisplayName}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox
                                                            DisplayMemberPath="DisplayName"
                                                            ItemsSource="{Binding DataContext.FieldKindChoices, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                            SelectedValue="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                            SelectedValuePath="Value" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridCheckBoxColumn Width="70" Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}" Header="필수" />
                                            <DataGridTextColumn Width="110" Binding="{Binding ParseFormat, UpdateSourceTrigger=PropertyChanged}" Header="입력 형식" />
                                            <DataGridTextColumn Width="110" Binding="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged}" Header="표시 형식" />
                                            <DataGridTemplateColumn Width="118" Header="순서 / 삭제">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                            <ui:Button Margin="0,0,4,0" Command="{Binding DataContext.MoveFieldUpCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Symbol=ArrowUp12}" Style="{StaticResource IconOnlyButtonStyle}" ToolTip="위로 이동" />
                                                            <ui:Button Margin="0,0,4,0" Command="{Binding DataContext.MoveFieldDownCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Symbol=ArrowDown12}" Style="{StaticResource IconOnlyButtonStyle}" ToolTip="아래로 이동" />
                                                            <ui:Button Appearance="Caution" Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Symbol=Delete12}" Style="{StaticResource IconOnlyButtonStyle}" ToolTip="삭제" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <ui:Button
                                        Margin="0,0,0,20"
                                        HorizontalAlignment="Left"
                                        Command="{Binding AddFieldCommand}"
                                        Content="컬럼 추가"
                                        Icon="{ui:SymbolIcon Symbol=AddSquare20}" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="정규식 규칙" />
                                    <DataGrid
                                        Margin="0,4,0,8"
                                        MinHeight="160"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        HeadersVisibility="Column"
                                        ItemsSource="{Binding DraftRules}"
                                        PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="120" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Header="규칙 ID" />
                                            <DataGridTemplateColumn Width="110" Header="매칭">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="6,0" VerticalAlignment="Center" Text="{Binding MatchModeDisplayName}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox
                                                            DisplayMemberPath="DisplayName"
                                                            ItemsSource="{Binding DataContext.MatchModeChoices, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                            SelectedValue="{Binding MatchMode, UpdateSourceTrigger=PropertyChanged}"
                                                            SelectedValuePath="Value" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridCheckBoxColumn Width="110" Binding="{Binding IgnoreCase, UpdateSourceTrigger=PropertyChanged}" Header="대소문자 무시" />
                                            <DataGridTextColumn Width="100" Binding="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" Header="제한 (ms)" />
                                            <DataGridTextColumn Width="3*" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Header="정규식 Pattern *" MinWidth="240" />
                                            <DataGridTemplateColumn Width="118" Header="순서 / 삭제">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                            <ui:Button Margin="0,0,4,0" Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Symbol=ArrowUp12}" Style="{StaticResource IconOnlyButtonStyle}" ToolTip="위로 이동" />
                                                            <ui:Button Margin="0,0,4,0" Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Symbol=ArrowDown12}" Style="{StaticResource IconOnlyButtonStyle}" ToolTip="아래로 이동" />
                                                            <ui:Button Appearance="Caution" Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Symbol=Delete12}" Style="{StaticResource IconOnlyButtonStyle}" ToolTip="삭제" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <ui:Button
                                        HorizontalAlignment="Left"
                                        Command="{Binding AddRuleCommand}"
                                        Content="규칙 추가"
                                        Icon="{ui:SymbolIcon Symbol=AddSquare20}" />
                                </StackPanel>
                            </Border>

                            <Border IsEnabled="{Binding IsEditorReady}" Style="{StaticResource EditorSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="3. 실제 경로로 결과 확인" />
                                    <TextBlock
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="저장하기 전에 같은 경로를 시험해 각 값이 예상대로 보이는지 확인하세요."
                                        TextWrapping="Wrap" />
                                    <ui:TextBox
                                        AutomationProperties.Name="시험할 예제 경로"
                                        ClearButtonEnabled="True"
                                        PlaceholderText="실제 폴더 경로 또는 상대 경로"
                                        Text="{Binding SamplePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding TestDraftCommand}"
                                        Content="이 경로로 결과 확인"
                                        Icon="{ui:SymbolIcon Symbol=CheckmarkCircle20}" />
                                    <TextBlock
                                        Margin="0,12,0,8"
                                        FontWeight="SemiBold"
                                        Text="{Binding TestSummary}"
                                        TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding TestRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource FieldCardStyle}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding FieldName}" />
                                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Status}" />
                                                        </Grid>
                                                        <TextBlock Margin="0,6,0,0" FontSize="15" Text="{Binding Value}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        Grid.Row="1"
                        Margin="8,12,8,8"
                        Style="{StaticResource FluentToolbarSurfaceStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:InfoBar
                                Margin="0,0,0,8"
                                Message="{Binding EditorStatusMessage}"
                                Severity="{Binding EditorStatusSeverity}"
                                Style="{StaticResource ActionableEditorInfoBarStyle}"
                                Title="검증이 필요합니다" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding EditorStatusMessage}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button
                                        MinWidth="96"
                                        Margin="0,0,8,0"
                                        Command="{Binding ValidateDraftCommand}"
                                        Content="검증"
                                        Icon="{ui:SymbolIcon Symbol=CheckmarkCircle20}" />
                                    <ui:Button
                                        MinWidth="120"
                                        Appearance="Primary"
                                        Command="{Binding SaveDraftCommand}"
                                        Content="검증 후 저장"
                                        Icon="{ui:SymbolIcon Symbol=Save16}" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar
                                Grid.Row="2"
                                Height="3"
                                Margin="0,8,0,0"
                                IsIndeterminate="True"
                                Visibility="{Binding IsEditorBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="로드 상태">
                <ScrollViewer
                    x:Name="ProfileLoadStatusScrollViewer"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,16,8,24">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="프로필 로드 상태" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource PageSubtitleTextStyle}"
                                Text="앱에서 사용할 수 있는 프로필을 선택하면 해석된 컬럼과 경로 규칙을 확인할 수 있습니다." />
                        </StackPanel>

                        <StackPanel>
                            <Border Margin="0,0,0,16" Style="{StaticResource FluentSurfaceStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="로드된 프로필" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,4,0,12"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="상세 내용을 볼 프로필을 선택하세요." />
                                    <DataGrid
                                        Grid.Row="2"
                                        MinHeight="280"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        HeadersVisibility="Column"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding Profiles}"
                                        PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        SelectedItem="{Binding SelectedProfile}"
                                        SelectionMode="Single"
                                        Style="{StaticResource FluentDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="*" Binding="{Binding DisplayName}" Header="표시 이름" MinWidth="140" />
                                            <DataGridTextColumn Width="90" Binding="{Binding Kind}" Header="정의 방식" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <StackPanel>
                                <Border Style="{StaticResource EditorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="선택한 프로필" />
                                        <TextBlock
                                            Margin="0,4,0,12"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding SelectedProfile.Id, StringFormat='프로필 ID: {0}'}"
                                            TextTrimming="CharacterEllipsis" />
                                        <WrapPanel>
                                            <StackPanel MinWidth="120" Margin="0,0,16,8">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="버전" />
                                                <TextBlock Text="{Binding SelectedProfile.Version}" />
                                            </StackPanel>
                                            <StackPanel MinWidth="120" Margin="0,0,16,8">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="검색 대상" />
                                                <TextBlock Text="{Binding SelectedProfile.CandidateKind}" />
                                            </StackPanel>
                                            <StackPanel MinWidth="120" Margin="0,0,16,8">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="규칙 경로" />
                                                <TextBlock Text="{Binding SelectedProfile.PathInput}" />
                                            </StackPanel>
                                            <StackPanel MinWidth="100" Margin="0,0,0,8">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="컬럼 수" />
                                                <TextBlock Text="{Binding SelectedProfile.FieldCount}" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource EditorSectionStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="결과 컬럼" />
                                        <DataGrid
                                            Grid.Row="1"
                                            Margin="0,12,0,0"
                                            MinHeight="160"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding Fields}"
                                            PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            Style="{StaticResource FluentDataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="50" Binding="{Binding Order}" Header="#" />
                                                <DataGridTextColumn Width="1.4*" Binding="{Binding Header}" Header="표시 이름" MinWidth="110" />
                                                <DataGridTextColumn Width="1.2*" Binding="{Binding FieldId}" Header="Field ID" MinWidth="100" />
                                                <DataGridTextColumn Width="1.2*" Binding="{Binding GroupName}" Header="정규식 그룹" MinWidth="100" />
                                                <DataGridTextColumn Width="90" Binding="{Binding Kind}" Header="값 타입" />
                                                <DataGridCheckBoxColumn Width="60" Binding="{Binding Required}" Header="필수" />
                                                <DataGridCheckBoxColumn Width="75" Binding="{Binding IsNullable}" Header="Nullable" />
                                                <DataGridTextColumn Width="100" Binding="{Binding ParseFormat}" Header="입력 형식" />
                                                <DataGridTextColumn Width="100" Binding="{Binding DisplayFormat}" Header="표시 형식" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Margin="0" Style="{StaticResource FluentSurfaceStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="경로 규칙" />
                                        <DataGrid
                                            Grid.Row="1"
                                            Margin="0,12,0,0"
                                            MinHeight="160"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding Rules}"
                                            PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            Style="{StaticResource FluentDataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="50" Binding="{Binding Order}" Header="#" />
                                                <DataGridTextColumn Width="110" Binding="{Binding Id}" Header="규칙 ID" />
                                                <DataGridTextColumn Width="90" Binding="{Binding MatchMode}" Header="매칭" />
                                                <DataGridCheckBoxColumn Width="110" Binding="{Binding IgnoreCase}" Header="대소문자 무시" />
                                                <DataGridTextColumn Width="90" Binding="{Binding TimeoutMilliseconds}" Header="제한 (ms)" />
                                                <DataGridTextColumn Width="3*" Binding="{Binding Pattern}" Header="정규식 Pattern" MinWidth="240" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Expander Margin="0,16,0,0" Header="고급: 플러그인 및 선언형 프로필 진단">
                            <Border Margin="0,8,0,0" Style="{StaticResource FluentSurfaceStyle}">
                                <DataGrid
                                    MinHeight="160"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding Reports}"
                                    PreviewMouseWheel="OnNestedDataGridPreviewMouseWheel"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    Style="{StaticResource FluentDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="100" Binding="{Binding StatusText}" Header="로드 상태" />
                                        <DataGridTextColumn Width="1.5*" Binding="{Binding DisplayName}" Header="표시 이름" />
                                        <DataGridTextColumn Width="1.4*" Binding="{Binding ProfileId}" Header="프로필 ID" />
                                        <DataGridTextColumn Width="3*" Binding="{Binding Diagnostics}" Header="검증 및 진단 메시지" />
                                        <DataGridTextColumn Width="2.5*" Binding="{Binding SourceDirectory}" Header="원본 폴더" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
