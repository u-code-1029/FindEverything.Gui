                                                            <TextBlock
                                                                Margin="0,4,0,0"
                                                                Style="{StaticResource CaptionTextStyle}"
                                                                Text="{Binding DateFormatHelpText}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>

