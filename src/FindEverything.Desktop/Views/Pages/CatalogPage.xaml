<Page
    x:Class="FindEverything.Desktop.Views.Pages.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FindEverything.Desktop.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="카탈로그"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid Margin="32,0,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock VerticalAlignment="Center" Text="프로필" />
            <ComboBox
                Grid.Column="1"
                Margin="8,4"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding Profiles}"
                SelectedItem="{Binding SelectedProfile}" />

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="검색 루트" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="8,4"
                Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
                Grid.Row="1"
                Grid.Column="2"
                MinWidth="72"
                Margin="4"
                Command="{Binding BrowseRootCommand}"
                Content="찾아보기" />

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="인덱스 DB" />
            <TextBox
                Grid.Row="2"
                Grid.Column="1"
                Margin="8,4"
                Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
                Grid.Row="2"
                Grid.Column="2"
                MinWidth="72"
                Margin="4"
                Command="{Binding BrowseDatabaseCommand}"
                Content="찾아보기" />
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button
                    MinWidth="92"
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Command="{Binding ScanCommand}"
                    Content="인덱싱" />
                <ui:Button
                    MinWidth="92"
                    Margin="0,0,8,0"
                    Command="{Binding LoadCommand}"
                    Content="불러오기" />
                <ui:Button
                    MinWidth="72"
                    Margin="0,0,8,0"
                    Appearance="Caution"
                    Command="{Binding CancelCommand}"
                    Content="취소" />
                <ui:Button
                    MinWidth="112"
                    Command="{Binding OpenSelectedCommand}"
                    Content="선택 폴더 열기" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ui:ProgressRing
                    Width="20"
                    Height="20"
                    Margin="0,0,8,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ProgressMessage}" />
            </StackPanel>
        </DockPanel>

        <ui:InfoBar
            Grid.Row="2"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding IsStatusOpen}"
            Message="{Binding StatusMessage}"
            Severity="{Binding StatusSeverity}"
            Title="{Binding StatusTitle}" />

        <Grid
            Grid.Row="3"
            Margin="0,0,0,12"
            Visibility="{Binding HasLoadedItems, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Text="결과 필터" />
            <ui:TextBox
                Grid.Column="1"
                MinWidth="280"
                Margin="12,0"
                AutomationProperties.Name="모든 결과 컬럼 필터"
                ClearButtonEnabled="True"
                PlaceholderText="모든 컬럼과 폴더 경로에서 검색"
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            <TextBlock
                Grid.Column="2"
                MinWidth="110"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding FilterSummary}"
                TextAlignment="Right" />
        </Grid>

        <DataGrid
            x:Name="ResultsGrid"
            Grid.Row="4"
            behaviors:DynamicProfileGrid.Fields="{Binding Fields}"
            behaviors:DynamicProfileGrid.ProfileId="{Binding SelectedProfile.Id}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            IsReadOnly="True"
            ItemsSource="{Binding Items}"
            MouseDoubleClick="OnResultsGridMouseDoubleClick"
            SelectedItem="{Binding SelectedItem}"
            SelectionMode="Single"
            SelectionUnit="FullRow" />
    </Grid>
</Page>
