<Page
    x:Class="FindEverything.Desktop.Views.Pages.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FindEverything.Desktop.Behaviors"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{StaticResource Loc.Home.Catalog.Title}"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnPageLoaded"
    KeyDown="OnWorkspacePaneKeyDown"
    PreviewKeyDown="OnPagePreviewKeyDown"
    ScrollViewer.CanContentScroll="False"
    Unloaded="OnPageUnloaded"
    mc:Ignorable="d">
    <Grid x:Name="CatalogPageLayout" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <controls:WorkspacePageFrame x:Name="CatalogPageContent" Grid.Row="0" Margin="{DynamicResource CatalogPagePadding}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <controls:CommandStrip x:Name="CatalogCommandStrip" Grid.Row="0" Padding="12,8" AutomationProperties.HelpText="{StaticResource Loc.Workspace.Catalog.Description}">
                <Grid x:Name="CatalogCommandRows">
                    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                    <Grid x:Name="CatalogSearchRow">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SearchBox" MinHeight="44" Padding="14,8" FontSize="17"
                            VerticalContentAlignment="Center" Margin="0,0,12,0" ClearButtonEnabled="True" Icon="{ui:SymbolIcon Symbol=Search20}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            AutomationProperties.Name="{StaticResource Loc.View.Catalog.AutomationName.FilterAllResultColumns}"
                            PlaceholderText="{StaticResource Loc.View.Catalog.PlaceholderText.SearchAllColumnsAndFolderPaths}"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.Style><Style TargetType="ui:TextBox" BasedOn="{StaticResource FluentSearchBoxStyle}">
                            <Setter Property="IsEnabled" Value="{Binding CanTypeSearch, FallbackValue=True}" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsShowingSelectedOnly}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                        </Style></ui:TextBox.Style>
                    </ui:TextBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="CatalogScanButton" MinWidth="104" Margin="0,0,8,0" Command="{Binding ScanCommand}" Content="{Binding ScanActionText, FallbackValue={StaticResource Loc.Workspace.Scan}}"
                                Icon="{ui:SymbolIcon Symbol=ArrowSync20}" ToolTip="{StaticResource Loc.Workspace.Scan.Catalog.Help}" ToolTipService.ShowOnDisabled="True">
                                <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" /><Style.Triggers><DataTrigger Binding="{Binding HasPublishedResults}" Value="False"><Setter Property="Appearance" Value="Primary" /></DataTrigger></Style.Triggers>
                                </Style></ui:Button.Style>
                            </ui:Button>
                            <ui:Button x:Name="CatalogDataManagementButton" Appearance="Transparent" Padding="8,6" Command="{Binding ToggleDetailsCommand}" Icon="{ui:SymbolIcon Symbol=MoreHorizontal20}" AutomationProperties.Name="{StaticResource Loc.Ux.Results.DataManagement}" ToolTip="{StaticResource Loc.Ux.Results.DataManagement.Help}">
                                <ui:Button.Content><ui:TextBlock x:Name="CatalogDataManagementLabel" Text="{StaticResource Loc.Ux.Results.DataManagement}" /></ui:Button.Content>
                            </ui:Button>
                            <ui:Button x:Name="CatalogCancelButton" Width="32" Height="32" MinWidth="0" Padding="4" Margin="4,0,0,0" Appearance="Transparent" Command="{Binding CancelCommand}" Icon="{ui:SymbolIcon Symbol=Dismiss20}" AutomationProperties.Name="{StaticResource Loc.Workspace.Cancel}" ToolTip="{StaticResource Loc.Workspace.Cancel}">
                                <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Visibility" Value="Hidden" /><Style.Triggers><DataTrigger Binding="{Binding ShowCancelAction}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style></ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="CatalogContextRow" Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Label x:Name="CatalogProfileLabel" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" Content="{StaticResource Loc.Workspace.Profile.Label}" Target="{Binding ElementName=CatalogProfileComboBox}" />
                        <!-- The star slot owns this selector's width. A measured label must not hold its old minimum when the window narrows. -->
                        <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}" x:Name="CatalogProfileComboBox" Grid.Column="1" MinWidth="96" HorizontalAlignment="Stretch" AutomationProperties.Name="{StaticResource Loc.Workspace.Profile}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanEditWorkspace}" ToolTip="{StaticResource Loc.Workspace.Catalog.Profile.Help}" />
                        <ui:Button x:Name="ImportCatalogProfileButton" Grid.Column="2" Margin="4,0,8,0" Padding="8,4" Appearance="Transparent" Command="{Binding ImportProfileCommand}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" AutomationProperties.Name="{StaticResource Loc.Ux.Catalog.ImportProfile}" ToolTip="{StaticResource Loc.Ux.Catalog.ImportProfile.Help}" ToolTipService.ShowOnDisabled="True">
                            <ui:Button.Content><ui:TextBlock x:Name="ImportCatalogProfileLabel" Text="{StaticResource Loc.Ux.Catalog.ImportProfile}" /></ui:Button.Content>
                        </ui:Button>
                        <ui:Button x:Name="CatalogLocationButton" Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,4" Appearance="Transparent" Command="{Binding BrowseRootCommand}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" AutomationProperties.Name="{StaticResource Loc.Workspace.Location.Change}" ToolTipService.ShowOnDisabled="True">
                            <ui:Button.Content><DockPanel>
                                <ui:TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" Text="{StaticResource Loc.Ux.Results.Location}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <ui:TextBlock Text="{Binding RootPath, TargetNullValue={StaticResource Loc.Catalog.Root.None}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel></ui:Button.Content>
                            <ui:Button.ToolTip><StackPanel MaxWidth="480"><ui:TextBlock Text="{Binding RootPath}" TextWrapping="Wrap" /><ui:TextBlock Margin="0,4,0,0" Text="{StaticResource Loc.Workspace.Location.Change.Help}" TextWrapping="Wrap" /></StackPanel></ui:Button.ToolTip>
                        </ui:Button>
                        <controls:WorkspaceTransferPanel x:Name="CatalogWorkspaceTransferPanel" Grid.Column="4" Margin="8,0,0,0" DataContext="{Binding WorkspaceTransfer}" ExportOwner="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </Grid>
                </Grid>
            </controls:CommandStrip>
        <Grid x:Name="CatalogResultsWorkspace" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,4">
            <Grid x:Name="CatalogStatusRow" Height="32">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:TextBlock Text="{Binding FilterSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilterSummary}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <Grid x:Name="CatalogStatusSlot" Grid.Column="1" Margin="12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:ProgressRing Width="16" Height="16" HorizontalAlignment="Left" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{Binding ProgressMessage}" />
                    <ui:TextBlock x:Name="CatalogProgressCaption" Grid.Column="1" VerticalAlignment="Center" Text="{Binding BusyProgressCaption}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:TextBlock.ToolTip><StackPanel MaxWidth="480"><ui:TextBlock Text="{Binding ProgressMessage}" TextWrapping="Wrap" /><ui:TextBlock x:Name="ScanInteractionNotice" Margin="0,8,0,0" Text="{Binding ScanDisplayNotice}" TextWrapping="Wrap" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel></ui:TextBlock.ToolTip>
                    </ui:TextBlock>
                    <ui:TextBlock x:Name="CatalogStateCaption" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                        <ui:TextBlock.Style><Style TargetType="ui:TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                            <Setter Property="Text" Value="{Binding ResultProvenance}" /><Setter Property="ToolTip" Value="{Binding ResultSourceDescription}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShowingSelectedOnly}" Value="True"><Setter Property="Text" Value="{Binding SelectedOnlyDescription}" /><Setter Property="ToolTip" Value="{Binding SelectedOnlyDescription}" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsSearchPending}" Value="True"><Setter Property="Text" Value="{StaticResource Loc.Ux.Results.Applying}" /><Setter Property="ToolTip" Value="{StaticResource Loc.Ux.Results.Applying}" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsPreservingSelection}" Value="True"><Setter Property="Text" Value="{StaticResource Loc.Ux.Results.Preserving}" /><Setter Property="ToolTip" Value="{StaticResource Loc.Ux.Results.Preserving}" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style></ui:TextBlock.Style>
                    </ui:TextBlock>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="SelectedOnlyButton" Style="{StaticResource SelectedOnlyToggleStyle}" />
                    <ui:Button x:Name="SelectFromDataButton" Height="28" Margin="8,0,4,0" Padding="8,4" Appearance="Transparent"
                        Command="{Binding OpenSelectionImportCommand}" Icon="{ui:SymbolIcon Symbol=ClipboardTaskListLtr20}" AutomationProperties.Name="{StaticResource Loc.SelectionImport.Open}"
                        ToolTip="{StaticResource Loc.SelectionImport.Open.Help}" ToolTipService.ShowOnDisabled="True"><ui:Button.Content><ui:TextBlock x:Name="SelectFromDataLabel" Text="{StaticResource Loc.SelectionImport.Open}" /></ui:Button.Content></ui:Button>
                    <ui:Button Width="28" Height="24" MinWidth="0" MinHeight="0" Padding="4" Appearance="Transparent" Icon="{ui:SymbolIcon Symbol=ColumnTriple20}" Click="OnColumnsMenuClick" IsEnabled="{Binding IsResultInteractionEnabled, FallbackValue=True}" ToolTip="{StaticResource Loc.Ux.Results.Columns}" AutomationProperties.Name="{StaticResource Loc.Ux.Results.Columns}" />
                </StackPanel>
            </Grid>
            <ui:DynamicScrollViewer x:Name="CatalogFilterScroller" Style="{StaticResource FluentGutteredScrollViewerStyle}" Height="44" Margin="0,4,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Visibility="{Binding HasColumnFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                <WrapPanel x:Name="CatalogFilterBar" IsEnabled="{Binding CanTypeSearch, FallbackValue=True}" Visibility="{Binding HasColumnFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding ActiveColumnFilters}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                            <ui:Button Padding="8,4" Appearance="Transparent" Click="OnFilterChipClick" Content="{Binding Description}" ToolTip="{StaticResource Loc.Ux.Results.EditFilter}" />
                            <ui:Button Width="28" Height="28" Padding="4" Appearance="Transparent" Command="{Binding RemoveCommand}" Icon="{ui:SymbolIcon Symbol=Dismiss12}" ToolTip="{StaticResource Loc.Ux.Results.RemoveFilter}" AutomationProperties.Name="{StaticResource Loc.Ux.Results.RemoveFilter}" />
                        </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Padding="8,4" Appearance="Transparent" Command="{Binding ClearColumnFiltersCommand}" Content="{StaticResource Loc.Catalog.Filters.ClearAll}" />
                </WrapPanel>
            </ui:DynamicScrollViewer>
            </StackPanel>
            <ui:Flyout x:Name="LiveFolderFlyout" Width="0" Height="0" MinWidth="0" MinHeight="0" />

            <controls:SectionCard x:Name="CatalogResultsSurface" Grid.Row="1" Style="{StaticResource WorkspaceResultCardStyle}"
                Visibility="{Binding HasLoadedItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SectionCard.Header>
            <ui:DataGrid
                x:Name="ResultsGrid"
                IsEnabled="{Binding IsResultInteractionEnabled, FallbackValue=True}"
                Grid.Row="0"
                behaviors:DynamicProfileGrid.Fields="{Binding Fields}"
                behaviors:DynamicProfileGrid.Localizer="{Binding Localizer}"
                behaviors:DynamicProfileGrid.ProfileId="{Binding SelectedProfile.Id}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                IsReadOnly="True"
                BorderThickness="0"
                ItemsSource="{Binding Items}"
                ContextMenuOpening="OnResultsGridContextMenuOpening"
                MouseDoubleClick="OnResultsGridMouseDoubleClick"
                PreviewMouseLeftButtonDown="OnResultsGridPreviewMouseLeftButtonDown"
                PreviewMouseRightButtonDown="OnResultsGridPreviewMouseRightButtonDown"
                SelectedItem="{Binding SelectedItem}"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                RowHeight="{DynamicResource CatalogRowHeight}"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                ScrollViewer.PanningMode="Both"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Sorting="OnResultsGridSorting"
                Style="{StaticResource FluentDataGridStyle}"
                Visibility="{Binding HasLoadedItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:DataGrid.CellStyle>
                    <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                        <Setter Property="Padding" Value="{DynamicResource CatalogCellPadding}" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </ui:DataGrid.CellStyle>
                <ui:DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource FluentResultRowStyle}" TargetType="DataGridRow">
                        <Setter Property="Margin" Value="{DynamicResource CatalogRowMargin}" />
                        <Setter Property="Padding" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="IsEnabled" Value="False" /><Setter Property="Opacity" Value="0.45" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="False"><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </ui:DataGrid.RowStyle>
                <ui:DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                        <ui:MenuItem Command="{Binding DataContext.OpenItemCommand}" CommandParameter="{Binding CurrentItem}" Header="{StaticResource Loc.View.Files.Header.OpenFolder}" />
                        <ui:MenuItem Command="{Binding DataContext.CopyItemFolderPathCommand}" CommandParameter="{Binding CurrentItem}" Header="{StaticResource Loc.View.Files.Header.CopyFolderPath}" />
                        <Separator />
                        <ui:MenuItem Command="{Binding DataContext.CopySelectionCommand}" Header="{StaticResource Loc.View.Files.Header.CopySelectionUsingCurrentOutputFormat}" />
                    </ContextMenu>
                </ui:DataGrid.ContextMenu>
            </ui:DataGrid>
                </controls:SectionCard.Header>
            </controls:SectionCard>

            <controls:SectionCard x:Name="SelectionToolbar" controls:FloatingNotificationChrome.IsBottomChrome="True" Grid.Row="2" Margin="0,8,0,0" Padding="12,4"
                IsEnabled="{Binding IsResultInteractionEnabled, FallbackValue=True}"
                Style="{StaticResource WorkspaceActionCardStyle}" SizeChanged="OnSelectionToolbarSizeChanged"
                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SectionCard.Header>
                    <controls:PurposeFooterPanel>
                        <WrapPanel x:Name="SelectionManagementGroup" VerticalAlignment="Center">
                            <ui:TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                Visibility="{Binding Visibility, ElementName=SelectAllResultsButton}"
                                Text="{Binding SelectionSummary}" />
                            <ui:Button x:Name="SelectionActionsMenuButton" Margin="0,0,8,0" Padding="8,4" Click="OnFooterMenuClick"
                                Icon="{ui:SymbolIcon Symbol=ChevronDown20}"
                                AutomationProperties.Name="{StaticResource Loc.Workspace.Selection.Manage}" ToolTip="{StaticResource Loc.Workspace.Selection.Manage.Help}">
                                <ui:Button.Content>
                                    <ui:TextBlock Text="{Binding SelectionSummary}" />
                                </ui:Button.Content>
                                <ui:Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <ui:MenuItem Command="{Binding SelectAllCommand}" Header="{StaticResource Loc.Selection.All}" />
                                        <ui:MenuItem Command="{Binding ClearSelectionCommand}" Header="{StaticResource Loc.Workspace.Selection.Clear}" />
                                        <ui:MenuItem Command="{Binding InvertSelectionCommand}" Header="{StaticResource Loc.Workspace.Selection.Invert}" />
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                            <ui:Button x:Name="SelectAllResultsButton" Margin="0,0,8,0" Padding="8,4" Appearance="Transparent" Command="{Binding SelectAllCommand}"
                                Content="{StaticResource Loc.Selection.All}" AutomationProperties.Name="{StaticResource Loc.Selection.All}" ToolTip="{StaticResource Loc.Selection.All.ToolTip}" />
                            <ui:Button x:Name="ClearAllResultsButton" Margin="0,0,8,0" Padding="8,4" Appearance="Transparent" Command="{Binding ClearSelectionCommand}"
                                Content="{StaticResource Loc.Workspace.Selection.Clear}" AutomationProperties.Name="{StaticResource Loc.Workspace.Selection.Clear}" ToolTip="{StaticResource Loc.Workspace.Selection.Clear}" />
                            <ui:Button x:Name="InvertResultsSelectionButton" Padding="8,4" Appearance="Transparent" Command="{Binding InvertSelectionCommand}"
                                Content="{StaticResource Loc.Workspace.Selection.Invert}" AutomationProperties.Name="{StaticResource Loc.Workspace.Selection.Invert}" ToolTip="{StaticResource Loc.Selection.Invert.ToolTip}" />
                        </WrapPanel>
                        <WrapPanel x:Name="SelectionOutputGroup" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ui:SplitButton x:Name="CopySelectionButton" Margin="0,0,8,0" Padding="8,4" Appearance="Primary" Command="{Binding CopySelectionCommand}"
                                Content="{Binding SelectedOutputFormat.DisplayName}" ContentTemplate="{StaticResource SelectionCopyContentTemplate}" AutomationProperties.Name="{StaticResource Loc.Workspace.Selection.Copy}"
                                Icon="{ui:SymbolIcon Symbol=Copy20}">
                                <ui:SplitButton.ToolTip>
                                    <StackPanel MaxWidth="420">
                                        <ui:TextBlock Text="{StaticResource Loc.Workspace.Output.Format.Label}" FontWeight="SemiBold" />
                                        <ui:TextBlock Text="{Binding SelectedOutputFormat.DisplayName}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                        <ui:TextBlock Text="{StaticResource Loc.Ux.Results.CopyFormatHelp}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:SplitButton.ToolTip>
                                <ui:SplitButton.Flyout>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <ui:MenuItem StaysOpenOnClick="True">
                                            <ui:MenuItem.Header>
                                                <StackPanel Margin="4">
                                                    <Label x:Name="CatalogOutputFormatLabel" Padding="0" Margin="0,0,0,8"
                                                        Content="{StaticResource Loc.Workspace.Output.Format.Label}" Target="{Binding ElementName=CatalogOutputFormatComboBox}" />
                                                    <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}" x:Name="CatalogOutputFormatComboBox"
                                                        AutomationProperties.Name="{StaticResource Loc.View.Files.AutomationName.SelectionOutputFormat}" DisplayMemberPath="DisplayName"
                                                        ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding SelectedOutputFormat}" />
                                                    <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.Ux.Results.CopyFormatHint}" />
                                                </StackPanel>
                                            </ui:MenuItem.Header>
                                        </ui:MenuItem>
                                    </ContextMenu>
                                </ui:SplitButton.Flyout>
                            </ui:SplitButton>
                            <ui:Button x:Name="ExportSelectionButton" Padding="8,4" Command="{Binding ExportSelectionCommand}"
                                Content="{StaticResource Loc.Workspace.Selection.Export}" AutomationProperties.Name="{StaticResource Loc.Workspace.Selection.Export}"
                                Icon="{ui:SymbolIcon Symbol=ArrowExportUp20}" ToolTip="{StaticResource Loc.View.Catalog.ToolTip.SaveSelectedStructuredResultsToAnExcel}" />
                        </WrapPanel>
                    </controls:PurposeFooterPanel>
                </controls:SectionCard.Header>
            </controls:SectionCard>

            <controls:SectionCard Grid.Row="1" Padding="24" Style="{StaticResource FluentEmptyStateStyle}" Visibility="{Binding IsCatalogEmptyVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <controls:SectionCard.Header><StackPanel MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon FontSize="32" Symbol="TableSearch28" Margin="0,0,0,12" />
                    <ui:TextBlock Text="{Binding EmptyResultTitle}" Style="{StaticResource SectionTitleTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                    <ui:TextBlock Text="{Binding EmptyResultHelp}" Margin="0,8,0,16" Style="{StaticResource CaptionTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                    <ui:Button HorizontalAlignment="Center" Command="{Binding ResetResultFiltersCommand}" Content="{StaticResource Loc.View.Files.Content.ClearSearchAndFilters}" Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button HorizontalAlignment="Center" Command="{Binding ToggleSelectedOnlyCommand}" Content="{StaticResource Loc.Ux.Results.SelectedOnly.Exit}" Visibility="{Binding IsShowingSelectedOnly, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <WrapPanel HorizontalAlignment="Center" Visibility="{Binding CanTestEmptyProfile, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:Button Margin="0,0,8,0" Click="OnEmptyTestProfileClick" Content="{StaticResource Loc.Shell.Nav.Playground}" />
                        <ui:Button Click="OnEmptyLogClick" Content="{StaticResource Loc.Ux.Results.ViewLog}" />
                    </WrapPanel>
                </StackPanel></controls:SectionCard.Header>
            </controls:SectionCard>
        </Grid>
<controls:SectionCard x:Name="CatalogDetailsPanel" Grid.Row="1" Width="340" HorizontalAlignment="Right" Panel.ZIndex="8" Style="{StaticResource FluentSectionCardStyle}" Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
              <controls:SectionCard.Header>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <ui:Button x:Name="CloseCatalogDetailsButton" Click="OnCloseDetailsClick" DockPanel.Dock="Right" Width="28" Height="28" Padding="4" Appearance="Transparent" Command="{Binding CloseDetailsCommand}" Icon="{ui:SymbolIcon Symbol=Dismiss20}" AutomationProperties.Name="{StaticResource Loc.Common.Close}" ToolTip="{StaticResource Loc.Ux.Pane.CloseHelp}" />
                            <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" Text="{StaticResource Loc.Ux.Results.DataManagement}" />
                        </DockPanel>

                <ui:DynamicScrollViewer Grid.Row="1" Style="{StaticResource FluentGutteredScrollViewerStyle}">
                    <StackPanel>
                        <StackPanel IsEnabled="{Binding IsResultInteractionEnabled, FallbackValue=True}">
                        <ui:TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.Workspace.Catalog.Database.Help}" />
                        <ui:TextBox AutomationProperties.Name="{StaticResource Loc.Workspace.Database.Path}" LostKeyboardFocus="OnWorkspacePathLostKeyboardFocus" PlaceholderText="{StaticResource Loc.Workspace.Database.Path}" Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button Margin="0,0,8,8" Command="{Binding BrowseDatabaseCommand}" Content="{StaticResource Loc.Workspace.Database.Choose}" />
                            <ui:Button Margin="0,0,0,8" Command="{Binding LoadCommand}" Content="{StaticResource Loc.Workspace.Database.Load}" ToolTip="{StaticResource Loc.Workspace.Database.Load.Help}" ToolTipService.ShowOnDisabled="True" />
                        </WrapPanel>
                        <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding ResultSourceDescription}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ui:DynamicScrollViewer>
                </Grid>
              </controls:SectionCard.Header>
            </controls:SectionCard>
        </controls:WorkspacePageFrame>
        <Thumb x:Name="ConsoleSplitter" Grid.Row="1" Height="8" Margin="24,0,24,0" Cursor="SizeNS" Focusable="True"
            DragDelta="OnConsoleSplitterDragDelta" KeyDown="OnConsoleSplitterKeyDown"
            Visibility="{Binding Visibility, ElementName=ScanConsolePanel}" AutomationProperties.Name="{StaticResource Loc.Scan.Resize}"
            ToolTip="{StaticResource Loc.Scan.Resize}">
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Rectangle Width="44" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" /></Grid></ControlTemplate></Thumb.Template>
        </Thumb>
        <controls:ScanConsolePanel x:Name="ScanConsolePanel" controls:FloatingNotificationChrome.IsBottomChrome="True" Grid.Row="2" Height="220" Margin="24,0,24,16" DataContext="{x:Null}" Visibility="{Binding IsPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Page>
