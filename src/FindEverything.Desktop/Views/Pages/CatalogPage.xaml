<Page
    x:Class="FindEverything.Desktop.Views.Pages.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FindEverything.Desktop.Behaviors"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="clr-namespace:FindEverything.Desktop.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="구조화 보기"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnPageLoaded"
    localization:LocalizationScope.IsEnabled="True"
    PreviewKeyDown="OnPagePreviewKeyDown"
    ScrollViewer.CanContentScroll="False"
    Unloaded="OnPageUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="NeutralActionableMessageStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsStatusOpen}" Value="True" />
                        <Condition Binding="{Binding StatusSeverity}" Value="{x:Static ui:InfoBarSeverity.Warning}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsStatusOpen}" Value="True" />
                        <Condition Binding="{Binding StatusSeverity}" Value="{x:Static ui:InfoBarSeverity.Error}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid x:Name="CatalogPageLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="CatalogPageContent" Grid.Row="0" Margin="24,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,20,0,16">
            <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleTextStyle}" Text="구조화 보기" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource PageSubtitleTextStyle}"
                Text="폴더 경로의 정보를 프로필 규칙으로 추출하고, 일치 항목을 찾는 즉시 목록에 표시합니다." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,16" Style="{StaticResource FluentSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid IsEnabled="{Binding CanEditWorkspace}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="프로필" />
                        <ComboBox
                            MinWidth="180"
                            AutomationProperties.Name="구조화 프로필"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,16,0"
                        Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="검색 위치" />
                        <ui:TextBox
                            AutomationProperties.Name="검색 루트"
                            ClearButtonEnabled="True"
                            LostKeyboardFocus="OnWorkspacePathLostKeyboardFocus"
                            PlaceholderText="구조화할 폴더를 선택하세요"
                            Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,22,16,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding RootPath, TargetNullValue={StaticResource Loc.Catalog.Root.None}}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding RootPath}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ui:Button
                        Grid.Column="2"
                        MinWidth="96"
                        Margin="0,20,0,0"
                        VerticalAlignment="Top"
                        Command="{Binding BrowseRootCommand}"
                        Content="위치 변경"
                        Icon="{ui:SymbolIcon Symbol=FolderOpen20}"
                        Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:ProgressRing
                            Width="20"
                            Height="20"
                            Margin="0,0,8,0"
                            IsIndeterminate="True"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding ProgressMessage}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <WrapPanel
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Right">
                        <ui:Button
                            MinWidth="212"
                            Margin="8,8,0,0"
                            Appearance="Primary"
                            Command="{Binding ScanCommand}"
                            Content="DB에 저장하지 않고 바로 스캔"
                            Icon="{ui:SymbolIcon Symbol=Search20}"
                            ToolTip="인덱스 DB를 만들거나 변경하지 않고 폴더를 직접 탐색합니다." />
                        <ui:Button
                            MinWidth="164"
                            Margin="8,8,0,0"
                            Command="{Binding IndexAndLoadCommand}"
                            Content="인덱싱 후 불러오기"
                            Icon="{ui:SymbolIcon Symbol=DatabaseSearch20}"
                            ToolTip="선택한 위치를 DB에 새로 인덱싱한 뒤 구조화 결과를 불러옵니다." />
                        <ui:Button
                            MinWidth="84"
                            Margin="8,8,0,0"
                            Command="{Binding ToggleDetailsCommand}"
                            Content="{Binding DetailsButtonText}"
                            Icon="{ui:SymbolIcon Symbol=Settings20}" />
                        <ui:Button
                            MinWidth="72"
                            Margin="8,8,0,0"
                            Appearance="Caution"
                            Command="{Binding CancelCommand}"
                            Content="취소" />
                        <ui:Button
                            MinWidth="112"
                            Margin="8,8,0,0"
                            Command="{Binding OpenSelectedCommand}"
                            Content="선택 폴더 열기"
                            Icon="{ui:SymbolIcon Symbol=FolderOpen20}" />
                    </WrapPanel>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="'바로 스캔'은 결과를 현재 화면에만 표시하며 인덱스 DB를 만들거나 변경하지 않습니다."
                        TextWrapping="Wrap" />
                </Grid>

                <Expander
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    Header="고급: 인덱스 DB 선택 및 기존 데이터 불러오기"
                    IsEnabled="{Binding CanEditWorkspace}"
                    Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            AutomationProperties.Name="인덱스 데이터베이스 경로"
                            ClearButtonEnabled="True"
                            LostKeyboardFocus="OnWorkspacePathLostKeyboardFocus"
                            PlaceholderText="인덱스 데이터베이스 경로"
                            Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            MinWidth="96"
                            Margin="8,0,0,0"
                            Command="{Binding BrowseDatabaseCommand}"
                            Content="찾아보기" />
                        <ui:Button
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            MinWidth="180"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding LoadCommand}"
                            Content="기존 인덱스에서 불러오기"
                            Icon="{ui:SymbolIcon Symbol=DatabaseSearch20}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="DB에는 프로필 해석 결과가 아니라 파일·폴더 메타데이터가 저장되며 파일 찾기와 공유됩니다. 기존 인덱스는 인덱싱할 때 사용한 검색 위치와 현재 검색 위치가 정확히 같을 때만 불러옵니다."
                            TextWrapping="Wrap" />
                    </Grid>
                </Expander>

                <Border
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    Padding="12,8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="{Binding StatusTitle}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding StatusMessage}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding StatusMessage}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Margin="0,0,0,16"
            Padding="12,9"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Style="{StaticResource NeutralActionableMessageStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding StatusTitle}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding StatusMessage}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,8"
                Style="{StaticResource FluentToolbarSurfaceStyle}"
                Visibility="{Binding HasLoadedItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="구조화 결과" />
                    <ui:ToggleSwitch
                        Grid.Column="1"
                        Margin="16,0"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="↔ 표시가 있는 값은 프로필의 매핑표로 치환되었습니다. 켜면 저장된 원본 값을 표시하고 검색·복사·내보내기에도 같은 기준을 사용합니다."
                        AutomationProperties.Name="원본 값 보기"
                        IsChecked="{Binding ShowOriginalValues}"
                        OffContent="치환 값 표시"
                        OnContent="원본 값 표시"
                        ToolTip="↔ 표시는 원본 코드가 사람이 읽기 쉬운 값으로 치환되었음을 뜻합니다."
                        Visibility="{Binding HasValueMappings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        Grid.Column="2"
                        MinWidth="120"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding FilterSummary}"
                        TextAlignment="Right" />
                </Grid>
            </Border>

            <ui:TextBox
                Grid.Row="1"
                Margin="0,0,0,8"
                AutomationProperties.Name="모든 결과 컬럼 필터"
                ClearButtonEnabled="True"
                Icon="{ui:SymbolIcon Symbol=Search12}"
                PlaceholderText="모든 컬럼과 폴더 경로에서 검색"
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                Visibility="{Binding HasLoadedItems, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <DataGrid
                x:Name="ResultsGrid"
                Grid.Row="2"
                behaviors:DynamicProfileGrid.Fields="{Binding Fields}"
                behaviors:DynamicProfileGrid.Localizer="{Binding Localizer}"
                behaviors:DynamicProfileGrid.ProfileId="{Binding SelectedProfile.Id}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                IsReadOnly="True"
                ItemsSource="{Binding Items}"
                ContextMenuOpening="OnResultsGridContextMenuOpening"
                MouseDoubleClick="OnResultsGridMouseDoubleClick"
                PreviewMouseRightButtonDown="OnResultsGridPreviewMouseRightButtonDown"
                SelectedItem="{Binding SelectedItem}"
                SelectionChanged="OnResultsGridSelectionChanged"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Style="{StaticResource FluentDataGridStyle}"
                Visibility="{Binding HasLoadedItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                        <MenuItem Command="{Binding DataContext.OpenItemCommand}" CommandParameter="{Binding CurrentItem}" Header="폴더 경로 열기" />
                        <MenuItem Command="{Binding DataContext.CopyItemFolderPathCommand}" CommandParameter="{Binding CurrentItem}" Header="폴더 경로 복사" />
                        <Separator />
                        <MenuItem Command="{Binding DataContext.CopySelectionCommand}" Header="선택 항목을 현재 출력 형식으로 복사" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <Border
                x:Name="SelectionToolbar"
                Grid.Row="2"
                Margin="0,0,16,16"
                Padding="10,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Panel.ZIndex="5"
                Style="{StaticResource FluentToolbarSurfaceStyle}"
                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,4,0,4" Orientation="Horizontal">
                        <TextBlock
                            Margin="4,0,12,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedCount, StringFormat={StaticResource Loc.Common.SelectedCountFormat}}" />
                        <ComboBox
                            Width="220"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="선택 항목 출력 형식"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding OutputFormats}"
                            SelectedItem="{Binding SelectedOutputFormat}" />
                    </StackPanel>
                    <ui:Button
                        Margin="0,4,6,4"
                        Appearance="Primary"
                        Command="{Binding CopySelectionCommand}"
                        Content="복사"
                        Icon="{ui:SymbolIcon Symbol=Copy20}" />
                    <ui:Button
                        x:Name="ExportSelectionButton"
                        Margin="0,4,12,4"
                        Command="{Binding ExportSelectionCommand}"
                        Content="내보내기"
                        Icon="{ui:SymbolIcon Symbol=ArrowExportUp20}"
                        ToolTip="선택한 구조화 결과를 Excel 또는 CSV 파일로 저장합니다." />
                    <ui:Button
                        Margin="0,4,6,4"
                        Click="OnSelectAllClick"
                        Content="전체 선택"
                        ToolTip="현재 필터에 표시된 항목을 모두 선택합니다." />
                    <ui:Button
                        Margin="0,4,6,4"
                        Click="OnClearSelectionClick"
                        Content="선택 해제" />
                    <ui:Button
                        Margin="0,4,0,4"
                        Click="OnInvertSelectionClick"
                        Content="선택 반전"
                        ToolTip="현재 필터에 표시된 항목의 선택을 반전합니다." />
                </WrapPanel>
            </Border>

            <Border Grid.RowSpan="3" Padding="24">
                <Border.Style>
                    <Style BasedOn="{StaticResource FluentEmptyStateStyle}" TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLoadedItems}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Margin="0,0,0,12"
                        FontSize="32"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="TableSearch28" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="아직 불러온 구조화 결과가 없습니다" />
                    <TextBlock
                        MaxWidth="520"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="파일·폴더 메타데이터를 DB에 저장하려면 '인덱싱 후 불러오기'를, 한 번만 확인하려면 'DB에 저장하지 않고 바로 스캔'을 선택하세요."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        </Grid>

        <controls:ScanConsolePanel
            x:Name="ScanConsolePanel"
            Grid.Row="1"
            Height="300"
            Margin="24,0,24,24"
            DataContext="{x:Null}"
            Visibility="{Binding IsPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Page>
