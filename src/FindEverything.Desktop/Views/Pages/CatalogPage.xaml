<Page
    x:Class="FindEverything.Desktop.Views.Pages.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FindEverything.Desktop.Behaviors"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="clr-namespace:FindEverything.Desktop.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Loc.Home.Catalog.Title}"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnPageLoaded"
    localization:LocalizationScope.IsEnabled="True"
    PreviewKeyDown="OnPagePreviewKeyDown"
    ScrollViewer.CanContentScroll="False"
    Unloaded="OnPageUnloaded"
    mc:Ignorable="d">
    <Grid x:Name="CatalogPageLayout" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <controls:WorkspacePageFrame x:Name="CatalogPageContent" Grid.Row="0" Margin="24,0,24,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <controls:PageHeader Title="{DynamicResource Loc.Shell.Nav.Catalog}" Description="{DynamicResource Loc.Workspace.Catalog.Description}">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" />
                    <TextBlock MaxWidth="240" VerticalAlignment="Center" Text="{Binding ProgressMessage}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressMessage}" />
                </StackPanel>
            </controls:PageHeader>
            <controls:CommandStrip Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label x:Name="CatalogProfileLabel" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" Content="{DynamicResource Loc.Workspace.Profile.Label}" Target="{Binding ElementName=CatalogProfileComboBox}" />
                        <ComboBox x:Name="CatalogProfileComboBox" Width="140" AutomationProperties.Name="{DynamicResource Loc.Workspace.Profile}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanEditWorkspace}" ToolTip="{DynamicResource Loc.Workspace.Catalog.Profile.Help}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Text="{Binding RootPath, TargetNullValue={StaticResource Loc.Catalog.Root.None}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath}" />
                    <WrapPanel Grid.Column="2">
                        <ui:Button MinWidth="76" Margin="0,0,8,0" Command="{Binding BrowseRootCommand}" Content="{DynamicResource Loc.Workspace.Location.Change}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" ToolTip="{DynamicResource Loc.Workspace.Location.Change.Help}" ToolTipService.ShowOnDisabled="True" />
                        <ui:Button MinWidth="92" Margin="0,0,8,0" Appearance="Primary" Command="{Binding ScanCommand}" Content="{DynamicResource Loc.Workspace.Scan}" Icon="{ui:SymbolIcon Symbol=Search20}" ToolTip="{DynamicResource Loc.Workspace.Scan.Catalog.Help}" ToolTipService.ShowOnDisabled="True" />
                        <ui:Button Command="{Binding ToggleDetailsCommand}" Content="{Binding DetailsButtonText}" ToolTip="{DynamicResource Loc.Workspace.Details.Help}" />
                        <ui:Button Margin="8,0,0,0" Command="{Binding CancelCommand}" Content="{DynamicResource Loc.Workspace.Cancel}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{DynamicResource Loc.Workspace.Cancel.Help}" />
                    </WrapPanel>
                </Grid>
            </controls:CommandStrip>
        <Grid x:Name="CatalogResultsWorkspace" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="0"
                Visibility="{Binding HasLoadedItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
            <ui:TextBox
                x:Name="SearchBox"
                MinHeight="36"
                Grid.Column="0"
                Margin="0,0,12,0"
                AutomationProperties.Name="{DynamicResource Loc.View.Catalog.AutomationName.FilterAllResultColumns}"
                ClearButtonEnabled="True"
                Icon="{ui:SymbolIcon Symbol=Search12}"
                PlaceholderText="{DynamicResource Loc.View.Catalog.PlaceholderText.SearchAllColumnsAndFolderPaths}"
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                Visibility="{Binding HasLoadedItems, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:ToggleSwitch
                        Grid.Column="1"
                        Margin="16,0"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="{DynamicResource Loc.View.Catalog.AutomationHelpText.ValuesMarkedWereReplacedUsingTheProfile}"
                        AutomationProperties.Name="{DynamicResource Loc.View.Catalog.AutomationName.ShowOriginalValues}"
                        IsChecked="{Binding ShowOriginalValues}"
                        OffContent="{DynamicResource Loc.View.Catalog.OffContent.ShowMappedValues}"
                        OnContent="{DynamicResource Loc.View.Catalog.OnContent.ShowOriginalValues}"
                        ToolTip="{DynamicResource Loc.View.Catalog.ToolTip.IndicatesThatAnOriginalCodeWasReplaced}"
                        Visibility="{Binding HasValueMappings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        Grid.Column="2"
                        MinWidth="72"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding FilterSummary}"
                        TextAlignment="Right" />
                </Grid>
            </Border>



            <DataGrid
                x:Name="ResultsGrid"
                Grid.Row="2"
                behaviors:DynamicProfileGrid.Fields="{Binding Fields}"
                behaviors:DynamicProfileGrid.Localizer="{Binding Localizer}"
                behaviors:DynamicProfileGrid.ProfileId="{Binding SelectedProfile.Id}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                IsReadOnly="True"
                ItemsSource="{Binding Items}"
                ContextMenuOpening="OnResultsGridContextMenuOpening"
                MouseDoubleClick="OnResultsGridMouseDoubleClick"
                PreviewMouseLeftButtonDown="OnResultsGridPreviewMouseLeftButtonDown"
                PreviewMouseRightButtonDown="OnResultsGridPreviewMouseRightButtonDown"
                SelectedItem="{Binding SelectedItem}"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                RowHeight="44"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                ScrollViewer.PanningMode="Both"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Sorting="OnResultsGridSorting"
                Style="{StaticResource FluentDataGridStyle}"
                Visibility="{Binding HasLoadedItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid.CellStyle>
                    <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,4" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource FluentResultRowStyle}" TargetType="DataGridRow">
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Padding" Value="0,2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="IsEnabled" Value="False" /><Setter Property="Opacity" Value="0.45" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="False"><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                        <MenuItem Command="{Binding DataContext.OpenItemCommand}" CommandParameter="{Binding CurrentItem}" Header="{DynamicResource Loc.View.Files.Header.OpenFolder}" />
                        <MenuItem Command="{Binding DataContext.CopyItemFolderPathCommand}" CommandParameter="{Binding CurrentItem}" Header="{DynamicResource Loc.View.Files.Header.CopyFolderPath}" />
                        <Separator />
                        <MenuItem Command="{Binding DataContext.CopySelectionCommand}" Header="{DynamicResource Loc.View.Files.Header.CopySelectionUsingCurrentOutputFormat}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <Border
                x:Name="SelectionToolbar"
                Grid.Row="3"
                Margin="0,8,0,0"
                Padding="8,2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"

                Style="{StaticResource FluentToolbarSurfaceStyle}"
                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <TextBlock
                            Margin="4,0,12,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedCount, StringFormat={StaticResource Loc.Common.SelectedCountFormat}}" />
                        <Label x:Name="CatalogOutputFormatLabel" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" Content="{DynamicResource Loc.Workspace.Output.Format.Label}" Target="{Binding ElementName=CatalogOutputFormatComboBox}" />
                        <ComboBox
                            x:Name="CatalogOutputFormatComboBox"
                            Width="140"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="{DynamicResource Loc.View.Files.AutomationName.SelectionOutputFormat}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding OutputFormats}"
                            ToolTip="{Binding SelectedOutputFormat.DisplayName}"
                            SelectedItem="{Binding SelectedOutputFormat}" />
                    </StackPanel>
                    <ui:Button
                        x:Name="CopySelectionButton"
                        Margin="0,0,6,0"
                        Appearance="Primary"
                        Command="{Binding CopySelectionCommand}"
                        Content="{DynamicResource Loc.Workspace.Selection.Copy}"
                        AutomationProperties.Name="{DynamicResource Loc.Workspace.Selection.Copy}"
                        ToolTip="{DynamicResource Loc.Workspace.Selection.Copy.Help}"
                        Icon="{ui:SymbolIcon Symbol=Copy20}" />
                    <ui:Button
                        x:Name="ExportSelectionButton"
                        Margin="0,0,12,0"
                        Command="{Binding ExportSelectionCommand}"
                        Content="{DynamicResource Loc.Workspace.Selection.Export}"
                        AutomationProperties.Name="{DynamicResource Loc.Workspace.Selection.Export}"
                        Icon="{ui:SymbolIcon Symbol=ArrowExportUp20}"
                        ToolTip="{DynamicResource Loc.View.Catalog.ToolTip.SaveSelectedStructuredResultsToAnExcel}" />
                    <ui:Button
                        Margin="0,0,12,0"
                        Command="{Binding OpenSelectedCommand}"
                        ToolTip="{DynamicResource Loc.Workspace.Selection.Open.Help}"
                        ToolTipService.ShowOnDisabled="True"
                        Width="28" Padding="0" AutomationProperties.Name="{DynamicResource Loc.Workspace.Selection.Open}"
                        Icon="{ui:SymbolIcon Symbol=FolderOpen20}" />

                    <ui:Button
                        x:Name="SelectAllResultsButton"
                        Margin="0,0,6,4"
                        Padding="8,4"
                        Command="{Binding SelectAllCommand}"
                        Content="{DynamicResource Loc.Selection.All}"
                        Icon="{ui:SymbolIcon Symbol=CheckboxChecked20}"
                        AutomationProperties.Name="{DynamicResource Loc.Selection.All}"
                        ToolTip="{DynamicResource Loc.Selection.All.ToolTip}" />
                    <ui:Button
                        x:Name="ClearAllResultsButton"
                        Margin="0,0,6,4"
                        Command="{Binding ClearSelectionCommand}"
                        Padding="8,4"
                        Content="{DynamicResource Loc.Workspace.Selection.Clear}"
                        Icon="{ui:SymbolIcon Symbol=CheckboxUnchecked20}"
                        AutomationProperties.Name="{DynamicResource Loc.Workspace.Selection.Clear}"
                        ToolTip="{DynamicResource Loc.Workspace.Selection.Clear}" />
                    <ui:Button
                        x:Name="InvertResultsSelectionButton"
                        Margin="0,0,0,4"
                        Command="{Binding InvertSelectionCommand}"
                        Padding="8,4"
                        Content="{DynamicResource Loc.Workspace.Selection.Invert}"
                        Icon="{ui:SymbolIcon Symbol=ArrowSwap20}"
                        AutomationProperties.Name="{DynamicResource Loc.Workspace.Selection.Invert}"
                        ToolTip="{DynamicResource Loc.Selection.Invert.ToolTip}" />
                </WrapPanel>
            </Border>

            <Border Grid.RowSpan="3" Padding="24">
                <Border.Style>
                    <Style BasedOn="{StaticResource FluentEmptyStateStyle}" TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLoadedItems}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Margin="0,0,0,12"
                        FontSize="32"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="TableSearch28" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Loc.View.Catalog.Text.NoStructuredResultsLoadedYet}" />
                    <TextBlock
                        MaxWidth="520"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Loc.View.Catalog.Text.ChooseAProfileAndSearchLocationThen}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
            <Border Grid.Row="3" Padding="0,4" Background="Transparent">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Grid.Column="1" MaxWidth="260" Margin="12,0,0,0" Text="{Binding ResultSourceDescription}" Style="{StaticResource CaptionTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultSourceDescription}" AutomationProperties.Name="{DynamicResource Loc.Workspace.ResultSource}" />
                </Grid>
            </Border>
            <controls:SectionCard x:Name="CatalogDetailsPanel" Grid.Row="2" Width="340" HorizontalAlignment="Right" Panel.ZIndex="8" Style="{StaticResource FluentSectionCardStyle}" Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
              <controls:SectionCard.Header>
                <ScrollViewer Style="{StaticResource FluentGutteredScrollViewerStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.Workspace.Details}" />
                        <TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionTextStyle}" Text="{DynamicResource Loc.Workspace.Catalog.Database.Help}" />
                        <ui:TextBox AutomationProperties.Name="{DynamicResource Loc.Workspace.Database.Path}" LostKeyboardFocus="OnWorkspacePathLostKeyboardFocus" PlaceholderText="{DynamicResource Loc.Workspace.Database.Path}" Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button Margin="0,0,8,8" Command="{Binding BrowseDatabaseCommand}" Content="{DynamicResource Loc.Workspace.Database.Choose}" />
                            <ui:Button Margin="0,0,0,8" Command="{Binding LoadCommand}" Content="{DynamicResource Loc.Workspace.Database.Load}" ToolTip="{DynamicResource Loc.Workspace.Database.Load.Help}" ToolTipService.ShowOnDisabled="True" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding DatabasePath}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
              </controls:SectionCard.Header>
            </controls:SectionCard>
        </controls:WorkspacePageFrame>
        <controls:ScanConsolePanel x:Name="ScanConsolePanel" Grid.Row="1" Height="220" Margin="24,0,24,16" DataContext="{x:Null}" Visibility="{Binding IsPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Page>
