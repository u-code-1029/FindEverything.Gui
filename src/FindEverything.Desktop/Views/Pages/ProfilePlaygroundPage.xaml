<Page
    x:Class="FindEverything.Desktop.Views.Pages.ProfilePlaygroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{StaticResource Loc.Shell.Nav.Playground}"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="PlaygroundFieldCardStyle" TargetType="ui:CardControl" BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PlaygroundRegexDebugItemsStyle" TargetType="ItemsControl">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <controls:SectionCard
                            Margin="0,0,0,12"
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="3,1,1,1"
                            CornerRadius="8"><controls:SectionCard.Header>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock FontWeight="SemiBold" Text="{Binding RuleId}" />
                                    <ui:TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding MatchMode}" />
                                </Grid>
                                <ui:TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="Consolas"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Pattern}"
                                    TextWrapping="Wrap" />
                                <ui:TextBlock
                                    Margin="0,4,0,10"
                                    FontWeight="SemiBold"
                                    Text="{Binding Status}"
                                    TextWrapping="Wrap" />
                                <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}" x:Name="DebugLaneSelector" ItemsSource="{Binding Lanes}" SelectedIndex="0" DisplayMemberPath="Label"
                                    AutomationProperties.Name="{StaticResource Loc.Ux.Authoring.DebugGroup}" Margin="0,0,0,8" />
                                <ContentControl Content="{Binding SelectedItem, ElementName=DebugLaneSelector}" HorizontalContentAlignment="Stretch">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,2,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:DisplayBadge
                                                            Width="10"
                                                            Height="10"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding MarkerBrush}"
                                                            CornerRadius="2" />
                                                        <ui:TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Label}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip="{Binding Label}" />
                                                    </StackPanel>
                                                    <ui:TextBlock
                                                        Margin="16,2,0,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Detail}" />
                                                </StackPanel>
                                                <ui:DynamicScrollViewer
                                                    Grid.Column="1"
                                                    HorizontalScrollBarVisibility="Auto"
                                                    VerticalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding Segments}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <controls:DisplayBadge Background="{Binding BackgroundBrush}">
                                                                    <ui:TextBlock
                                                                        Padding="2,4"
                                                                        FontFamily="Consolas"
                                                                        Text="{Binding Text}"
                                                                        ToolTip="{Binding ToolTip}" />
                                                                </controls:DisplayBadge>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ui:DynamicScrollViewer>
                                            </Grid>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>
                        </controls:SectionCard.Header></controls:SectionCard>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <controls:WorkspacePageFrame>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <controls:CommandStrip Grid.Row="0" Padding="16" Margin="0,0,0,12" AutomationProperties.HelpText="{StaticResource Loc.Workspace.Playground.Description}">
            <StackPanel>
            <Grid x:Name="PlaygroundInputPanel" IsEnabled="{Binding IsReady}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Label x:Name="PlaygroundProfileLabel" Padding="0" Margin="0,0,12,8" VerticalAlignment="Center" Content="{StaticResource Loc.Workspace.Profile.Label}" Target="{Binding ElementName=PlaygroundProfileComboBox}" />
                <Grid Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}" x:Name="PlaygroundProfileComboBox" HorizontalAlignment="Stretch" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Description" AutomationProperties.Name="{StaticResource Loc.Workspace.Playground.Profile}" ToolTip="{StaticResource Loc.Workspace.Playground.Profile.Help}" />
                    <ui:Button x:Name="EditTestProfileButton" Grid.Column="1" Margin="8,0,0,0" Width="36" Padding="4" Appearance="Transparent" Command="{Binding EditProfileCommand}"
                        Icon="{ui:SymbolIcon Symbol=DocumentEdit20}" ToolTip="{StaticResource Loc.Ux.Authoring.EditProfile}" AutomationProperties.Name="{StaticResource Loc.Ux.Authoring.EditProfile}" />
                </Grid>
                <Label Grid.Row="1" Padding="0" Margin="0,0,12,0" VerticalAlignment="Center" Content="{StaticResource Loc.Ux.Results.Location}" Target="{Binding ElementName=PlaygroundPathTextBox}" />
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="PlaygroundPathTextBox" Margin="0,0,8,0" ClearButtonEnabled="True" PlaceholderText="{StaticResource Loc.Workspace.Playground.Path}" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{StaticResource Loc.Workspace.Playground.Path}" ToolTip="{StaticResource Loc.Workspace.Playground.Path.Help}" />
                    <ui:Button Grid.Column="1" Width="36" Padding="0" Command="{Binding BrowsePathCommand}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" AutomationProperties.Name="{StaticResource Loc.Workspace.Playground.Browse}" ToolTip="{StaticResource Loc.Workspace.Playground.Browse}" />
                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Appearance="Primary" Command="{Binding EvaluateCommand}" Content="{StaticResource Loc.Workspace.Playground.Run}" Icon="{ui:SymbolIcon Symbol=Play20}" ToolTip="{StaticResource Loc.Workspace.Playground.Run.Help}" ToolTipService.ShowOnDisabled="True" />
                </Grid>
            </Grid>
            <ui:Button x:Name="CancelPlaygroundButton" Margin="0,8,0,0" HorizontalAlignment="Right"
                Command="{Binding CancelCommand}" Content="{StaticResource Loc.Common.Cancel}"
                Icon="{ui:SymbolIcon Symbol=Dismiss20}" ToolTip="{StaticResource Loc.Playground.Cancel.Help}"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </controls:CommandStrip>
        <TabControl Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <TabItem Header="{StaticResource Loc.Profiles.Features.Playground.PathTab}">
                <ui:DynamicScrollViewer x:Name="ProfilePlaygroundScrollViewer" Style="{StaticResource FluentGutteredScrollViewerStyle}">
                    <StackPanel>
                <controls:SectionCard Margin="0" Style="{StaticResource FluentSectionCardStyle}">
                      <controls:SectionCard.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{StaticResource Loc.View.ProfilePlayground.Text.StructuredValues}" />
                        <ui:TextBlock
                            Margin="0,4,0,12"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{StaticResource Loc.Ux.Authoring.SavedDefinition}"
                            TextWrapping="Wrap" />
                        <ui:DataGrid x:Name="ProfileTestResultsGrid" ItemsSource="{Binding Rows}" Style="{StaticResource FluentDataGridStyle}"
                            MinHeight="120" MaxHeight="360" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn Header="{StaticResource Loc.Ux.Authoring.Column}" Binding="{Binding FieldName, Mode=OneWay}" Width="*" MinWidth="110" />
                                <DataGridTextColumn Header="{StaticResource Loc.Ux.Authoring.RawValue}" Binding="{Binding RawValue, Mode=OneWay}" Width="*" MinWidth="130" />
                                <DataGridTextColumn Header="{StaticResource Loc.Ux.Authoring.Value}" Binding="{Binding Value, Mode=OneWay}" Width="*" MinWidth="130" />
                                <DataGridTextColumn Header="{StaticResource Loc.Ux.Authoring.Status}" Binding="{Binding Status, Mode=OneWay}" Width="1.4*" MinWidth="170" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </StackPanel>
                      </controls:SectionCard.Header>
                </controls:SectionCard>
                <controls:SectionCard
                    x:Name="PlaygroundDirectoryExclusionResultPanel"
                    Margin="0,16,0,0"
                    AutomationProperties.Name="{StaticResource Loc.View.ProfilePlayground.AutomationName.PlaygroundFolderNameExclusionResult}"
                    Style="{StaticResource FluentSectionCardStyle}"
                    Visibility="{Binding HasDirectoryExclusionTestResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <controls:SectionCard.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{StaticResource Loc.View.ProfilePlayground.Text.FolderNameExclusionDecision}" />
                        <ui:TextBlock
                            Margin="0,4,0,10"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{StaticResource Loc.View.ProfilePlayground.Text.OnlyTheFinalFolderNameOfThe}"
                            TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontWeight="SemiBold" Text="{StaticResource Loc.View.ProfilePlayground.Text.InputLeaf}" />
                            <ui:TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                FontFamily="Consolas"
                                Text="{Binding DirectoryExclusionTestResult.AbsolutePath}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding DirectoryExclusionTestResult.AbsolutePath}" />
                        </Grid>
                        <ui:InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="{Binding DirectoryExclusionTestResult.Message}"
                            Severity="{Binding DirectoryExclusionTestResult.Severity}"
                            Title="{Binding DirectoryExclusionTestResult.Title}" />
                    </StackPanel>
                  </controls:SectionCard.Header>
                </controls:SectionCard>
                    <ui:CardExpander
                    x:Name="PlaygroundRegexDebugExpander"
                    Margin="0,12,0,0"
                    VerticalAlignment="Top"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.Name="{StaticResource Loc.View.ProfilePlayground.AutomationName.PathRegexColorDebugger}"
                    Header="{StaticResource Loc.Ux.Authoring.AdvancedDebug}"
                    IsExpanded="False"
                    Visibility="{Binding HasRegexDebugRules, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SectionCard x:Name="PlaygroundRegexDebugCard" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Style="{StaticResource FluentSectionCardStyle}">
                      <controls:SectionCard.Header>
                        <StackPanel>
                            <ui:TextBlock x:Name="PlaygroundRegexDebugCaption"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{StaticResource Loc.View.ProfilePlayground.Text.ShowsPartialCandidatesAndNamedGroupsFrom}"
                                TextWrapping="Wrap" />
                            <ui:TextBlock
                                Margin="0,8,0,12"
                                FontFamily="Consolas"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding RegexDebugInputPath}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding RegexDebugInputPath}" />
                            <ItemsControl
                                ItemsSource="{Binding RegexDebugRules}"
                                Style="{StaticResource PlaygroundRegexDebugItemsStyle}" />
                        </StackPanel>
                      </controls:SectionCard.Header>
                    </controls:SectionCard>
                </ui:CardExpander>
                <ui:CardExpander
                    x:Name="PlaygroundDirectoryExclusionRegexDebugExpander"
                    Margin="0,12,0,0"
                    VerticalAlignment="Top"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.Name="{StaticResource Loc.View.ProfilePlayground.AutomationName.FolderExclusionRegexColorDebugger}"
                    Header="{StaticResource Loc.View.ProfilePlayground.AutomationName.FolderExclusionRegexColorDebugger}"
                    Visibility="{Binding HasDirectoryExclusionRegexDebugRules, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SectionCard Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Style="{StaticResource FluentSectionCardStyle}">
                      <controls:SectionCard.Header>
                        <StackPanel>
                            <ui:TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{StaticResource Loc.View.ProfilePlayground.Text.ShowsPartialCandidatesForEachExclusionPattern}"
                                TextWrapping="Wrap" />
                            <ItemsControl
                                Margin="0,12,0,0"
                                ItemsSource="{Binding DirectoryExclusionRegexDebugRules}"
                                Style="{StaticResource PlaygroundRegexDebugItemsStyle}" />
                        </StackPanel>
                      </controls:SectionCard.Header>
                    </controls:SectionCard>
                </ui:CardExpander>
                    </StackPanel>
                </ui:DynamicScrollViewer>
        </TabItem>
        <TabItem Header="{StaticResource Loc.Profiles.Features.Playground.SelectionTab}">
            <ui:DynamicScrollViewer Style="{StaticResource FluentGutteredScrollViewerStyle}">
                <controls:SectionCard Style="{StaticResource FluentSectionCardStyle}"><controls:SectionCard.Header><StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{StaticResource Loc.Profiles.Features.Selection.Title}" />
                    <ui:TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="{StaticResource Loc.Profiles.Features.Playground.Help}" />
                    <ui:TextBlock Margin="0,0,0,4" Text="{StaticResource Loc.Profiles.Features.Selection.RuleName}" />
                    <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}" ItemsSource="{Binding SelectionRules}" SelectedItem="{Binding SelectedSelectionRule}" DisplayMemberPath="DisplayName" />
                    <ui:TextBox Margin="0,12,0,0" MinHeight="160" AcceptsReturn="True" TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" Text="{Binding SelectionInputText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{StaticResource Loc.Profiles.Features.Playground.Input}" />
                    <ui:Button Margin="0,12,0,0" HorizontalAlignment="Left" Appearance="Primary" Command="{Binding PreviewSelectionRuleCommand}"
                        Content="{StaticResource Loc.Profiles.Features.Playground.Run}" Icon="{ui:SymbolIcon Symbol=Play20}" />
                    <ui:TextBlock Margin="0,12,0,12" Text="{Binding SelectionTestSummary}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding SelectionPreviewRows}"><ItemsControl.ItemTemplate><DataTemplate>
                        <ui:TextBox Margin="0,0,0,8" IsReadOnly="True" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></controls:SectionCard.Header></controls:SectionCard>
            </ui:DynamicScrollViewer>
        </TabItem>
        </TabControl>
        <Grid x:Name="PlaygroundSummaryPanel" controls:FloatingNotificationChrome.IsBottomChrome="True" Grid.Row="2" Margin="0,8" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ui:TextBlock x:Name="PlaygroundSummaryText" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Summary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </controls:WorkspacePageFrame>
</Page>
