<Page
    x:Class="FindEverything.Desktop.Views.Pages.ProfilePlaygroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="clr-namespace:FindEverything.Desktop.Localization"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="프로필 Playground"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    localization:LocalizationScope.IsEnabled="True"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="PlaygroundFieldCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PlaygroundRegexDebugItemsStyle" TargetType="ItemsControl">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="14"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="3,1,1,1"
                            CornerRadius="7">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding RuleId}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding MatchMode}" />
                                </Grid>
                                <TextBlock
                                    Margin="0,5,0,0"
                                    FontFamily="Consolas"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Pattern}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,5,0,10"
                                    FontWeight="SemiBold"
                                    Text="{Binding Status}"
                                    TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Lanes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,1,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border
                                                            Width="10"
                                                            Height="10"
                                                            Margin="0,0,7,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding MarkerBrush}"
                                                            CornerRadius="2" />
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Label}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip="{Binding Label}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Margin="17,2,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Detail}" />
                                                </StackPanel>
                                                <ScrollViewer
                                                    Grid.Column="1"
                                                    HorizontalScrollBarVisibility="Auto"
                                                    VerticalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding Segments}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding BackgroundBrush}">
                                                                    <TextBlock
                                                                        Padding="1,3"
                                                                        FontFamily="Consolas"
                                                                        Text="{Binding Text}"
                                                                        ToolTip="{Binding ToolTip}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <controls:WorkspacePageFrame>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <controls:PageHeader Title="{DynamicResource Loc.Shell.Nav.Playground}" Description="{DynamicResource Loc.Workspace.Playground.Description}" />
        <controls:CommandStrip Grid.Row="1">
            <Grid x:Name="PlaygroundInputPanel" IsEnabled="{Binding IsReady}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Label x:Name="PlaygroundProfileLabel" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" Content="{DynamicResource Loc.Workspace.Profile.Label}" Target="{Binding ElementName=PlaygroundProfileComboBox}" />
                    <ComboBox x:Name="PlaygroundProfileComboBox" Width="140" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Description" AutomationProperties.Name="{DynamicResource Loc.Workspace.Playground.Profile}" ToolTip="{DynamicResource Loc.Workspace.Playground.Profile.Help}" />
                </StackPanel>
                <ui:TextBox Grid.Column="1" Margin="8,0" ClearButtonEnabled="True" PlaceholderText="{DynamicResource Loc.Workspace.Playground.Path}" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Playground.Path}" ToolTip="{DynamicResource Loc.Workspace.Playground.Path.Help}" />
                <ui:Button Grid.Column="2" Width="36" Padding="0" Command="{Binding BrowsePathCommand}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Playground.Browse}" ToolTip="{DynamicResource Loc.Workspace.Playground.Browse}" />
                <ui:Button Grid.Column="3" Margin="8,0,0,0" Appearance="Primary" Command="{Binding EvaluateCommand}" Content="{DynamicResource Loc.Workspace.Playground.Run}" Icon="{ui:SymbolIcon Symbol=Play20}" ToolTip="{DynamicResource Loc.Workspace.Playground.Run.Help}" ToolTipService.ShowOnDisabled="True" />
            </Grid>
        </controls:CommandStrip>
        <controls:SplitWorkspace x:Name="PlaygroundWorkspace" Grid.Row="2" PrimaryRatio="0.35" PrimaryTitle="{DynamicResource Loc.Workspace.Playground.Values}" SecondaryTitle="{DynamicResource Loc.Workspace.Playground.Debug}">
            <controls:SplitWorkspace.PrimaryContent>
                <ScrollViewer x:Name="ProfilePlaygroundScrollViewer" Style="{StaticResource FluentGutteredScrollViewerStyle}">
                    <StackPanel>                <controls:SectionCard Margin="0" Style="{StaticResource FluentSectionCardStyle}">
                      <controls:SectionCard.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.ProfilePlayground.Text.StructuredValues}" />
                        <TextBlock
                            Margin="0,4,0,12"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{DynamicResource Loc.View.ProfilePlayground.Text.TheseValuesComeFromTheSameProfile}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PlaygroundFieldCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.4*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding FieldName}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="12,0"
                                                Text="{Binding Value}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Status}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Margin="12,6,0,0"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding RawValue, StringFormat={StaticResource Loc.Playground.RawValueFormat}}"
                                                Visibility="{Binding HasMappedValue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                      </controls:SectionCard.Header>
                </controls:SectionCard>                <controls:SectionCard
                    x:Name="PlaygroundDirectoryExclusionResultPanel"
                    Margin="0,16,0,0"
                    AutomationProperties.Name="{DynamicResource Loc.View.ProfilePlayground.AutomationName.PlaygroundFolderNameExclusionResult}"
                    Style="{StaticResource FluentSectionCardStyle}"
                    Visibility="{Binding HasDirectoryExclusionTestResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <controls:SectionCard.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.View.ProfilePlayground.Text.FolderNameExclusionDecision}" />
                        <TextBlock
                            Margin="0,4,0,10"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{DynamicResource Loc.View.ProfilePlayground.Text.OnlyTheFinalFolderNameOfThe}"
                            TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource Loc.View.ProfilePlayground.Text.InputLeaf}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                FontFamily="Consolas"
                                Text="{Binding DirectoryExclusionTestResult.LeafName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding DirectoryExclusionTestResult.LeafName}" />
                        </Grid>
                        <ui:InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="{Binding DirectoryExclusionTestResult.Message}"
                            Severity="{Binding DirectoryExclusionTestResult.Severity}"
                            Title="{Binding DirectoryExclusionTestResult.Title}" />
                    </StackPanel>
                  </controls:SectionCard.Header>
                </controls:SectionCard></StackPanel>
                </ScrollViewer>
            </controls:SplitWorkspace.PrimaryContent>
            <controls:SplitWorkspace.SecondaryContent>
                <ScrollViewer x:Name="PlaygroundDebugScrollViewer" Style="{StaticResource FluentGutteredScrollViewerStyle}">
                    <StackPanel>                <Expander
                    x:Name="PlaygroundRegexDebugExpander"
                    Margin="0"
                    AutomationProperties.Name="{DynamicResource Loc.View.ProfilePlayground.AutomationName.PathRegexColorDebugger}"
                    Header="{DynamicResource Loc.View.ProfilePlayground.AutomationName.PathRegexColorDebugger}"
                    IsExpanded="True"
                    Visibility="{Binding HasRegexDebugRules, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SectionCard Margin="0,8,0,0" Style="{StaticResource FluentSectionCardStyle}">
                      <controls:SectionCard.Header>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{DynamicResource Loc.View.ProfilePlayground.Text.ShowsPartialCandidatesAndNamedGroupsFrom}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,8,0,12"
                                FontFamily="Consolas"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding RegexDebugInputPath}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding RegexDebugInputPath}" />
                            <ItemsControl
                                ItemsSource="{Binding RegexDebugRules}"
                                Style="{StaticResource PlaygroundRegexDebugItemsStyle}" />
                        </StackPanel>
                      </controls:SectionCard.Header>
                    </controls:SectionCard>
                </Expander>                <Expander
                    x:Name="PlaygroundDirectoryExclusionRegexDebugExpander"
                    Margin="0,12,0,0"
                    AutomationProperties.Name="{DynamicResource Loc.View.ProfilePlayground.AutomationName.FolderExclusionRegexColorDebugger}"
                    Header="{DynamicResource Loc.View.ProfilePlayground.AutomationName.FolderExclusionRegexColorDebugger}"
                    Visibility="{Binding HasDirectoryExclusionRegexDebugRules, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SectionCard Margin="0,8,0,0" Style="{StaticResource FluentSectionCardStyle}">
                      <controls:SectionCard.Header>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{DynamicResource Loc.View.ProfilePlayground.Text.ShowsPartialCandidatesForEachExclusionPattern}"
                                TextWrapping="Wrap" />
                            <ItemsControl
                                Margin="0,12,0,0"
                                ItemsSource="{Binding DirectoryExclusionRegexDebugRules}"
                                Style="{StaticResource PlaygroundRegexDebugItemsStyle}" />
                        </StackPanel>
                      </controls:SectionCard.Header>
                    </controls:SectionCard>
                </Expander></StackPanel>
                </ScrollViewer>
            </controls:SplitWorkspace.SecondaryContent>
        </controls:SplitWorkspace>
        <Border Grid.Row="3" Padding="0,8" Background="Transparent">
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </controls:WorkspacePageFrame>
</Page>
