<Page
    x:Class="FindEverything.Desktop.Views.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:behaviors="clr-namespace:FindEverything.Desktop.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{StaticResource Loc.Home.Files.Title}"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    PreviewKeyDown="OnPagePreviewKeyDown"
    ScrollViewer.CanContentScroll="False"
    SizeChanged="OnWorkspaceSizeChanged"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="FileMetadataCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Page.Resources>
    <controls:WorkspacePageFrame x:Name="FilePageLayout" Margin="24,0,24,8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <controls:PageHeader Title="{StaticResource Loc.Shell.Nav.Files}" Description="{StaticResource Loc.Workspace.Files.Description}">
            <controls:WorkspaceTransferPanel x:Name="FilesWorkspaceTransferPanel" DataContext="{Binding WorkspaceTransfer}" ExportOwner="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}" />
        </controls:PageHeader>
        <controls:CommandStrip Grid.Row="1">
            <StackPanel>
            <Grid x:Name="FileCommandLayout">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SearchBox" Style="{StaticResource FluentSearchBoxStyle}" MinHeight="36" Padding="12,6" FontSize="15"
                    AutomationProperties.Name="{StaticResource Loc.Workspace.Files.Search}" ClearButtonEnabled="True" Icon="{ui:SymbolIcon Symbol=Search20}"
                    PlaceholderText="{StaticResource Loc.Workspace.Files.Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="{StaticResource Loc.Workspace.Files.Search.Help}" IsEnabled="{Binding CanSearch}" />
                <WrapPanel Grid.Column="1" Margin="8,0,0,0">
                    <ui:Button MinWidth="92" Margin="0,0,8,0" Command="{Binding RefreshIndexCommand}" Content="{Binding ScanActionText}" Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                        ToolTip="{StaticResource Loc.Workspace.Scan.Files.Help}" ToolTipService.ShowOnDisabled="True">
                        <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Secondary" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasIndex}" Value="False"><Setter Property="Appearance" Value="Primary" /></DataTrigger></Style.Triggers>
                        </Style></ui:Button.Style>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" Command="{Binding ToggleDetailsCommand}" Content="{StaticResource Loc.Ux.Results.DataManagement}" ToolTip="{StaticResource Loc.Ux.Results.DataManagementHelp}" />
                    <ui:Button Margin="8,0,0,0" Command="{Binding CancelCommand}" Content="{StaticResource Loc.Workspace.Cancel}" Visibility="{Binding ShowCancelAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </WrapPanel>
            </Grid>
            <DockPanel Margin="0,8,0,0">
                <ui:Button DockPanel.Dock="Right" Padding="8,2" Appearance="Transparent" Command="{Binding BrowseRootCommand}" Content="{StaticResource Loc.Workspace.Location.Change}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" />
                <Label DockPanel.Dock="Left" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" Content="{StaticResource Loc.Ux.Results.Location}" />
                <ui:TextBlock x:Name="FileRootPathText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding RootPath, TargetNullValue={StaticResource Loc.Files.Root.None}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath}" />
            </DockPanel>
            <ui:TextBlock x:Name="ScanInteractionNotice" Margin="0,8,0,0"
                Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                Text="{Binding ScanDisplayNotice}"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.Ux.Results.PreservingSelection}" Visibility="{Binding IsPreservingSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </controls:CommandStrip>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding VisibleResultCount}" AutomationProperties.LiveSetting="Polite" />
                    <ui:Button x:Name="RetryResultCountButton" Width="28" Height="24" MinWidth="0" MinHeight="0" Padding="0" Margin="8,0"
                        Appearance="Transparent" Icon="{ui:SymbolIcon Symbol=ArrowSync20}" Command="{Binding RetryResultCountCommand}"
                        Visibility="{Binding CanRetryResultCount, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                        AutomationProperties.Name="{StaticResource Loc.Files.Count.Retry}" ToolTip="{StaticResource Loc.Files.Count.Retry.Help}" />
                </StackPanel>
                <ui:TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="{Binding ResultProvenance}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultSourceDescription}" />
                <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{StaticResource Loc.Ux.Results.SearchPending}" Style="{StaticResource CaptionTextStyle}"
                    Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
            <controls:SectionCard x:Name="FileResultsSurface" Grid.Row="1" Style="{StaticResource WorkspaceResultCardStyle}"
                Visibility="{Binding HasIndex, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SectionCard.Header>
            <ui:DataGrid
                x:Name="ResultsGrid"
                IsEnabled="{Binding IsResultInteractionEnabled, FallbackValue=True}"
                Grid.Row="1"
                Style="{StaticResource FluentDataGridStyle}"
                BorderThickness="0"
                AutomationProperties.Name="{StaticResource Loc.View.Files.AutomationName.FileSearchResults}"

                ItemsSource="{Binding Items}"
                FrozenColumnCount="2"
                ContextMenuOpening="OnResultsGridContextMenuOpening"
                MouseDoubleClick="OnResultsGridMouseDoubleClick"
                PreviewMouseLeftButtonDown="OnResultsGridPreviewMouseLeftButtonDown"
                PreviewMouseRightButtonDown="OnResultsGridPreviewMouseRightButtonDown"
                ScrollViewer.ScrollChanged="OnResultsGridScrollChanged"
                SelectedItem="{Binding SelectedItem}"
                SelectionChanged="OnResultsGridSelectionChanged"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.PanningMode="Both"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Sorting="OnResultsGridSorting"
                Visibility="{Binding HasIndex, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource FluentResultRowStyle}" TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="IsEnabled" Value="False" /><Setter Property="Opacity" Value="0.45" /></DataTrigger>
                            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.UsesQuerySelection, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" /><Condition Binding="{Binding IsSelected}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></MultiDataTrigger>
                            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.UsesQuerySelection, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" /><Condition Binding="{Binding IsSelected}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:DataGrid.RowStyle>
                <ui:DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                        <ui:MenuItem Command="{Binding DataContext.RefreshItemScopeCommand}" CommandParameter="{Binding CurrentItem}" Header="{StaticResource Loc.View.Files.Header.RefreshOnlyThisFolder}" />
                        <Separator />
                        <ui:MenuItem Command="{Binding DataContext.OpenItemFolderCommand}" CommandParameter="{Binding CurrentItem}" Header="{StaticResource Loc.View.Files.Header.OpenFolder}" />
                        <ui:MenuItem Command="{Binding DataContext.CopyItemFolderPathCommand}" CommandParameter="{Binding CurrentItem}" Header="{StaticResource Loc.View.Files.Header.CopyFolderPath}" />
                        <Separator />
                        <ui:MenuItem Command="{Binding DataContext.CopySelectionCommand}" Header="{StaticResource Loc.View.Files.Header.CopySelectionUsingCurrentOutputFormat}" />
                        <ui:MenuItem Command="{Binding DataContext.OpenItemCommand}" CommandParameter="{Binding CurrentItem}" Header="{StaticResource Loc.View.Files.Header.OpenItem}" />
                    </ContextMenu>
                </ui:DataGrid.ContextMenu>
                <ui:DataGrid.Columns>
                    <DataGridTemplateColumn Width="64" MinWidth="64" MaxWidth="64" CanUserReorder="False" CanUserResize="False" CanUserSort="False">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header><CheckBox Width="24" Height="24" Padding="0" Margin="0" IsThreeState="True"
                            IsChecked="{Binding DataContext.CurrentResultsSelectionState, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                            Command="{Binding DataContext.ToggleCurrentResultsSelectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            AutomationProperties.Name="{StaticResource Loc.Selection.CurrentResults.Toggle}" ToolTip="{StaticResource Loc.Selection.CurrentResults.Toggle.Help}" /></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=OneWay}" AutomationProperties.Name="{StaticResource Loc.Catalog.Selection.Item}" PreviewMouseLeftButtonDown="OnSelectionCheckBoxPreviewMouseLeftButtonDown" PreviewKeyDown="OnSelectionCheckBoxPreviewKeyDown" Checked="OnSelectionCheckBoxStateChanged" Unchecked="OnSelectionCheckBoxStateChanged" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="180" MinWidth="160" Header="{StaticResource Loc.Profiles.New.DefaultField}" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:TextBlock
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    behaviors:TextHighlighting.DisplayText="{Binding Name}"
                                    behaviors:TextHighlighting.HighlightText="{Binding DataContext.AppliedHighlightQuery, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*" MinWidth="240" Header="{StaticResource Loc.Files.Sort.Path}" SortMemberPath="Path">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:TextBlock
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    behaviors:TextHighlighting.DisplayText="{Binding ParentPath}"
                                    behaviors:TextHighlighting.HighlightText="{Binding DataContext.AppliedHighlightQuery, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding OriginalFullPath}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="120" MinWidth="100" ElementStyle="{StaticResource FileMetadataCellTextStyle}" Binding="{Binding KindText}" Header="{StaticResource Loc.Files.Sort.Kind}" SortMemberPath="FileType" />
                    <DataGridTextColumn Width="110" MinWidth="90" ElementStyle="{StaticResource FileMetadataCellTextStyle}" Binding="{Binding SizeText}" Header="{StaticResource Loc.Files.Sort.Size}" SortMemberPath="Size" />
                    <DataGridTextColumn Width="150" MinWidth="140" ElementStyle="{StaticResource FileMetadataCellTextStyle}" Binding="{Binding ModifiedLocal, StringFormat={}{0:g}}" Header="{StaticResource Loc.Files.Sort.Modified}" SortMemberPath="Modified" />
                    <DataGridTextColumn Width="150" MinWidth="140" ElementStyle="{StaticResource FileMetadataCellTextStyle}" Binding="{Binding CreatedLocal, StringFormat={}{0:g}}" Header="{StaticResource Loc.Files.Sort.Created}" SortMemberPath="Created" />
                    <DataGridTextColumn Width="90" MinWidth="80" ElementStyle="{StaticResource FileMetadataCellTextStyle}" Binding="{Binding StatusText}" Header="{StaticResource Loc.Catalog.Column.Status}" CanUserSort="False" />
                </ui:DataGrid.Columns>
            </ui:DataGrid>
                </controls:SectionCard.Header>
            </controls:SectionCard>

            <controls:SectionCard x:Name="SelectionToolbar" controls:FloatingNotificationChrome.IsBottomChrome="True" Grid.Row="2" Margin="0,8,0,0" Padding="12,4"
                IsEnabled="{Binding IsResultInteractionEnabled, FallbackValue=True}"
                Style="{StaticResource WorkspaceActionCardStyle}" SizeChanged="OnSelectionToolbarSizeChanged"
                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SectionCard.Header>
                    <controls:PurposeFooterPanel>
                        <WrapPanel x:Name="SelectionManagementGroup" VerticalAlignment="Center">
                            <ui:TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                Visibility="{Binding Visibility, ElementName=SelectAllResultsButton}"
                                Text="{Binding SelectionSummary}" />
                            <ui:Button x:Name="SelectionActionsMenuButton" Margin="0,0,8,0" Padding="8,4" Click="OnFooterMenuClick"
                                Icon="{ui:SymbolIcon Symbol=ChevronDown20}"
                                AutomationProperties.Name="{StaticResource Loc.Workspace.Selection.Manage}" ToolTip="{StaticResource Loc.Workspace.Selection.Manage.Help}">
                                <ui:Button.Content>
                                    <ui:TextBlock Text="{Binding SelectionSummary}" />
                                </ui:Button.Content>
                                <ui:Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <ui:MenuItem Command="{Binding SelectAllCommand}" Header="{StaticResource Loc.Selection.All}" />
                                        <ui:MenuItem Command="{Binding ClearSelectionCommand}" Header="{StaticResource Loc.Workspace.Selection.Clear}" />
                                        <ui:MenuItem Command="{Binding InvertSelectionCommand}" Header="{StaticResource Loc.Workspace.Selection.Invert}" />
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                            <ui:Button x:Name="SelectAllResultsButton" Margin="0,0,8,0" Padding="8,4" Appearance="Transparent" Command="{Binding SelectAllCommand}"
                                Content="{StaticResource Loc.Selection.All}" AutomationProperties.Name="{StaticResource Loc.Selection.All}" ToolTip="{StaticResource Loc.Selection.All.ToolTip}" />
                            <ui:Button x:Name="ClearAllResultsButton" Margin="0,0,8,0" Padding="8,4" Appearance="Transparent" Command="{Binding ClearSelectionCommand}"
                                Content="{StaticResource Loc.Workspace.Selection.Clear}" AutomationProperties.Name="{StaticResource Loc.Workspace.Selection.Clear}" ToolTip="{StaticResource Loc.Workspace.Selection.Clear}" />
                            <ui:Button x:Name="InvertResultsSelectionButton" Padding="8,4" Appearance="Transparent" Command="{Binding InvertSelectionCommand}"
                                Content="{StaticResource Loc.Workspace.Selection.Invert}" AutomationProperties.Name="{StaticResource Loc.Workspace.Selection.Invert}" ToolTip="{StaticResource Loc.Selection.Invert.ToolTip}" />
                        </WrapPanel>
                        <WrapPanel x:Name="SelectionOutputGroup" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ui:SplitButton x:Name="CopySelectionButton" Margin="0,0,8,0" Padding="8,4" Appearance="Primary" Command="{Binding CopySelectionCommand}"
                                Content="{StaticResource Loc.Workspace.Selection.Copy}" AutomationProperties.Name="{StaticResource Loc.Workspace.Selection.Copy}"
                                ToolTip="{StaticResource Loc.Ux.Results.CopyFormatHelp}" Icon="{ui:SymbolIcon Symbol=Copy20}">
                                <ui:SplitButton.Flyout>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <ui:MenuItem StaysOpenOnClick="True">
                                            <ui:MenuItem.Header>
                                                <StackPanel Margin="4">
                                                    <Label x:Name="FilesOutputFormatLabel" Padding="0" Margin="0,0,0,8"
                                                        Content="{StaticResource Loc.Workspace.Output.Format.Label}" Target="{Binding ElementName=FilesOutputFormatComboBox}" />
                                                    <ComboBox x:Name="FilesOutputFormatComboBox" Width="280" MinWidth="240"
                                                        AutomationProperties.Name="{StaticResource Loc.View.Files.AutomationName.SelectionOutputFormat}" DisplayMemberPath="DisplayName"
                                                        ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding SelectedOutputFormat}" />
                                                    <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.Ux.Results.CopyFormatHint}" />
                                                </StackPanel>
                                            </ui:MenuItem.Header>
                                        </ui:MenuItem>
                                    </ContextMenu>
                                </ui:SplitButton.Flyout>
                            </ui:SplitButton>
                        </WrapPanel>
                    </controls:PurposeFooterPanel>
                </controls:SectionCard.Header>
            </controls:SectionCard>

            <controls:SectionCard
                Grid.Row="1"
                Style="{StaticResource FluentEmptyStateStyle}"
                Visibility="{Binding IsSetupStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><controls:SectionCard.Header>
                <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="FolderSearch24" />
                    <ui:TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="{Binding IndexStatusTitle}"
                        TextAlignment="Center" />
                    <ui:TextBlock
                        Margin="0,8,0,20"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PageSubtitleTextStyle}"
                        Text="{Binding IndexStatusDetail}"
                        TextAlignment="Center" />
                    <ui:Button
                        MinWidth="160"
                        HorizontalAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding BrowseRootCommand}"
                        Content="{StaticResource Loc.Home.Setup.Location.Title}"
                        Icon="{ui:SymbolIcon Symbol=FolderOpen20}"
                        Visibility="{Binding HasNoRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button
                        MinWidth="160"
                        HorizontalAlignment="Center"
                        Command="{Binding BrowseRootCommand}"
                        Content="{StaticResource Loc.View.Files.Content.ChooseAnotherLocation}"
                        Icon="{ui:SymbolIcon Symbol=FolderOpen20}"
                        Visibility="{Binding HasRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button
                        MinWidth="160"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding RefreshIndexCommand}"
                        Content="{StaticResource Loc.View.Files.Content.CreateIndex}"
                        Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                        Visibility="{Binding HasRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </controls:SectionCard.Header></controls:SectionCard>

            <controls:SectionCard
                Grid.Row="1"
                Style="{StaticResource FluentEmptyStateStyle}"
                Visibility="{Binding IsNoResultsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><controls:SectionCard.Header>
                <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Search48" />
                    <ui:TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="{StaticResource Loc.View.Files.Text.NoMatchingItems}" />
                    <ui:TextBlock
                        Margin="0,8,0,20"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PageSubtitleTextStyle}"
                        Text="{StaticResource Loc.View.Files.Text.TryAShorterQueryOrClearThe}"
                        TextAlignment="Center" />
                    <ui:Button Command="{Binding ClearSearchAndFiltersCommand}" Content="{StaticResource Loc.View.Files.Content.ClearSearchAndFilters}" />
                </StackPanel>
            </controls:SectionCard.Header></controls:SectionCard>


        </Grid>

        <controls:SectionCard x:Name="FileDetailsPanel" Grid.Row="2" Width="340" HorizontalAlignment="Right" VerticalAlignment="Stretch" Panel.ZIndex="8" Style="{StaticResource FluentSectionCardStyle}" Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding IsResultInteractionEnabled, FallbackValue=True}">
          <controls:SectionCard.Header>
            <ui:DynamicScrollViewer x:Name="FileDetailsScrollViewer" Style="{StaticResource FluentGutteredScrollViewerStyle}">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{StaticResource Loc.Ux.Results.DataManagement}" />
                    <ui:TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionTextStyle}" Text="{Binding ResultSourceDescription}" TextWrapping="Wrap" />
                    <WrapPanel>
                        <ui:Button Command="{Binding BrowseDatabaseCommand}" Content="{StaticResource Loc.Workspace.Database.Choose}" ToolTip="{Binding DatabasePath}" Margin="0,0,8,8" />
                        <ui:Button Command="{Binding UseDefaultDatabasePathCommand}" Content="{StaticResource Loc.Workspace.Database.Default}" ToolTip="{Binding DefaultDatabasePath}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <ui:TextBlock Margin="0,8,0,4" FontWeight="SemiBold" Text="{StaticResource Loc.Workspace.Partial.Title}" />
                    <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{StaticResource Loc.Workspace.Partial.Help}" />
                    <ui:TextBox x:Name="PartialRefreshPathTextBox" Margin="0,8,0,0" MinWidth="120" ClearButtonEnabled="True" PlaceholderText="{StaticResource Loc.Workspace.Partial.Path}" Text="{Binding RefreshScopePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{StaticResource Loc.Workspace.Partial.Path}" />
                    <WrapPanel Margin="0,8,0,0">
                        <ui:Button Command="{Binding BrowseRefreshScopeCommand}" Content="{StaticResource Loc.Workspace.Folder.Choose}" Margin="0,0,8,8" />
                        <ui:Button x:Name="PartialRefreshButton" Command="{Binding RefreshScopeCommand}" Content="{StaticResource Loc.Workspace.Partial.Refresh}" ToolTip="{StaticResource Loc.Workspace.Partial.Help}" ToolTipService.ShowOnDisabled="True" Margin="0,0,0,8" />
                    </WrapPanel>
                    <Separator Margin="0,8" />
                    <Label Padding="0" Margin="0,0,0,4" Content="{StaticResource Loc.Workspace.Kind}" Target="{Binding ElementName=FileKindComboBox}" />
                    <ComboBox x:Name="FileKindComboBox" DisplayMemberPath="DisplayName" ItemsSource="{Binding KindChoices}" SelectedItem="{Binding SelectedKind}" AutomationProperties.Name="{StaticResource Loc.Workspace.Kind}" />
                    <ToggleButton x:Name="FilterButton" Margin="0,8,0,0" Content="{StaticResource Loc.Workspace.Filters}" IsChecked="{Binding IsFilterOpen, Mode=TwoWay}" AutomationProperties.Name="{StaticResource Loc.Workspace.Filters}" />
                    <Label Padding="0" Margin="0,8,0,4" Content="{StaticResource Loc.Workspace.Sort}" Target="{Binding ElementName=FileSortComboBox}" />
                    <ComboBox x:Name="FileSortComboBox" DisplayMemberPath="DisplayName" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelectedSort}" AutomationProperties.Name="{StaticResource Loc.Workspace.Sort}" />
                    <ui:Button Margin="0,8,0,0" Command="{Binding ToggleSortDirectionCommand}" Content="{Binding SortDirectionText}" Icon="{ui:SymbolIcon Symbol=ArrowSort20}" ToolTip="{StaticResource Loc.Workspace.Sort.Direction.Help}" />
            <Popup
                x:Name="FilterPopup"
                AllowsTransparency="True"
                IsOpen="{Binding IsFilterOpen, Mode=TwoWay}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=FilterButton}"
                StaysOpen="False">
                <controls:SectionCard
                    Width="460"
                    Margin="0,8,0,0"
                    DataContext="{Binding DataContext, ElementName=FilterButton}"
                    Style="{StaticResource FluentCardStyle}"><controls:SectionCard.Header>
                    <ui:DynamicScrollViewer
                        x:Name="FileFilterScrollViewer"
                        MaxHeight="560"
                        Style="{StaticResource FluentGutteredScrollViewerStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <ui:TextBlock
                                    DockPanel.Dock="Left"
                                    Style="{StaticResource SectionTitleTextStyle}"
                                    Text="{StaticResource Loc.View.Files.Text.SearchFilters}" />
                                <ui:Button
                                    HorizontalAlignment="Right"
                                    Command="{Binding ClearFiltersCommand}"
                                    Content="{StaticResource Loc.View.Files.Content.ClearAll}" />
                            </DockPanel>

                            <ui:TextBlock FontWeight="SemiBold" Text="{StaticResource Loc.View.Files.Text.FileSize}" />
                            <ui:TextBlock
                                Margin="0,2,0,8"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{StaticResource Loc.View.Files.Text.SizeFiltersApplyOnlyToFilesFolders}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ui:TextBlock Text="{StaticResource Loc.View.Files.Text.Minimum}" />
                                    <Slider
                                        Margin="0,6,0,0"
                                        AutomationProperties.Name="{StaticResource Loc.View.Files.AutomationName.MinimumFileSize}"
                                        IsSnapToTickEnabled="True"
                                        Maximum="10"
                                        Minimum="0"
                                        TickFrequency="1"
                                        Value="{Binding MinimumSizeStep}" />
                                    <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding MinimumSizeText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Text="{StaticResource Loc.View.Files.Text.Maximum}" />
                                    <Slider
                                        Margin="0,6,0,0"
                                        AutomationProperties.Name="{StaticResource Loc.View.Files.AutomationName.MaximumFileSize}"
                                        IsSnapToTickEnabled="True"
                                        Maximum="11"
                                        Minimum="1"
                                        TickFrequency="1"
                                        Value="{Binding MaximumSizeStep}" />
                                    <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding MaximumSizeText}" />
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,16" />
                            <ui:TextBlock FontWeight="SemiBold" Text="{StaticResource Loc.Files.Sort.Created}" />
                            <ComboBox
                                Margin="0,8,0,0"
                                AutomationProperties.Name="{StaticResource Loc.View.Files.AutomationName.CreatedDateFilter}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding DateFilterChoices}"
                                SelectedItem="{Binding SelectedCreatedDateFilter}" />
                            <Grid Margin="0,8,0,0" Visibility="{Binding IsCreatedCustomRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:CalendarDatePicker AutomationProperties.Name="{StaticResource Loc.View.Files.AutomationName.CreatedStartDate}" Date="{Binding CreatedFromDate}" Content="{Binding CreatedFromDate, TargetNullValue={StaticResource Loc.Ux.Results.Date.Unbounded}}" ContentStringFormat="{}{0:d}" />
                                <ui:CalendarDatePicker Grid.Column="2" AutomationProperties.Name="{StaticResource Loc.View.Files.AutomationName.CreatedEndDate}" Date="{Binding CreatedToDate}" Content="{Binding CreatedToDate, TargetNullValue={StaticResource Loc.Ux.Results.Date.Unbounded}}" ContentStringFormat="{}{0:d}" />
                            </Grid>

                            <ui:TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="{StaticResource Loc.Files.Sort.Modified}" />
                            <ComboBox
                                Margin="0,8,0,0"
                                AutomationProperties.Name="{StaticResource Loc.View.Files.AutomationName.ModifiedDateFilter}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding DateFilterChoices}"
                                SelectedItem="{Binding SelectedModifiedDateFilter}" />
                            <Grid Margin="0,8,0,0" Visibility="{Binding IsModifiedCustomRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:CalendarDatePicker AutomationProperties.Name="{StaticResource Loc.View.Files.AutomationName.ModifiedStartDate}" Date="{Binding ModifiedFromDate}" Content="{Binding ModifiedFromDate, TargetNullValue={StaticResource Loc.Ux.Results.Date.Unbounded}}" ContentStringFormat="{}{0:d}" />
                                <ui:CalendarDatePicker Grid.Column="2" AutomationProperties.Name="{StaticResource Loc.View.Files.AutomationName.ModifiedEndDate}" Date="{Binding ModifiedToDate}" Content="{Binding ModifiedToDate, TargetNullValue={StaticResource Loc.Ux.Results.Date.Unbounded}}" ContentStringFormat="{}{0:d}" />
                            </Grid>
                        </StackPanel>
                    </ui:DynamicScrollViewer>
                </controls:SectionCard.Header></controls:SectionCard>
            </Popup>
                </StackPanel>
            </ui:DynamicScrollViewer>
          </controls:SectionCard.Header>
        </controls:SectionCard>
    </controls:WorkspacePageFrame>
</Page>
