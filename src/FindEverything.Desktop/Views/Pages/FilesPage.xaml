<Page
    x:Class="FindEverything.Desktop.Views.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    xmlns:behaviors="clr-namespace:FindEverything.Desktop.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="clr-namespace:FindEverything.Desktop.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Loc.Home.Files.Title}"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    localization:LocalizationScope.IsEnabled="True"
    PreviewKeyDown="OnPagePreviewKeyDown"
    ScrollViewer.CanContentScroll="False"
    SizeChanged="OnWorkspaceSizeChanged"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="FileMetadataCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Page.Resources>
    <controls:WorkspacePageFrame x:Name="FilePageLayout">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <controls:PageHeader Title="{DynamicResource Loc.Shell.Nav.Files}" Description="{DynamicResource Loc.Workspace.Files.Description}" />
        <controls:CommandStrip Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid x:Name="FileCommandLayout">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="FileLocationColumn" Width="220" /><ColumnDefinition x:Name="FileSearchColumn" Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{Binding RootPath, TargetNullValue={StaticResource Loc.Files.Root.None}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Location.Change}" />
                <ui:TextBox x:Name="SearchBox" Grid.Column="1" Margin="12,0,0,0" MinHeight="36" AutomationProperties.Name="{DynamicResource Loc.Workspace.Files.Search}" ClearButtonEnabled="True" Icon="{ui:SymbolIcon Symbol=Search20}" PlaceholderText="{DynamicResource Loc.Workspace.Files.Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Loc.Workspace.Files.Search.Help}" IsEnabled="{Binding CanSearch}" />
                    <WrapPanel Grid.Column="2" Margin="8,0,0,0">
                        <ui:Button MinWidth="76" Margin="0,0,8,0" Command="{Binding BrowseRootCommand}" Content="{DynamicResource Loc.Workspace.Location.Change}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" ToolTip="{DynamicResource Loc.Workspace.Location.Change.Help}" ToolTipService.ShowOnDisabled="True" />
                        <ui:Button MinWidth="92" Margin="0,0,8,0" Appearance="Primary" Command="{Binding RefreshIndexCommand}" Content="{DynamicResource Loc.Workspace.Scan}" Icon="{ui:SymbolIcon Symbol=ArrowSync20}" ToolTip="{DynamicResource Loc.Workspace.Scan.Files.Help}" ToolTipService.ShowOnDisabled="True" />
                        <ui:Button Command="{Binding ToggleDetailsCommand}" Content="{Binding DetailsButtonText}" ToolTip="{DynamicResource Loc.Workspace.Details.Help}" />
                        <ui:Button Margin="8,0,0,0" Command="{Binding CancelCommand}" Content="{DynamicResource Loc.Workspace.Cancel}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{DynamicResource Loc.Workspace.Cancel.Help}" />
                    </WrapPanel>
                </Grid>

            </Grid>
        </controls:CommandStrip>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,8" Visibility="{Binding HasIndex, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    DockPanel.Dock="Left"
                    FontWeight="SemiBold"
                    Text="{Binding ResultSummary}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><ui:Button MinWidth="84" Padding="8,2" Margin="0,0,8,0" Content="{DynamicResource Loc.Selection.All}" Command="{Binding SelectAllCommand}" ToolTip="{DynamicResource Loc.Selection.All.ToolTip}" ToolTipService.ShowOnDisabled="True" />
                    <ui:ProgressRing
                        Width="18"
                        Height="18"
                        Margin="0,0,8,0"
                        IsIndeterminate="True"
                        Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="{Binding ProgressMessage}" />
                </StackPanel>
            </DockPanel>

            <DataGrid
                x:Name="ResultsGrid"
                Grid.Row="1"
                Style="{StaticResource FluentDataGridStyle}"
                AutomationProperties.Name="{DynamicResource Loc.View.Files.AutomationName.FileSearchResults}"

                ItemsSource="{Binding Items}"
                FrozenColumnCount="1"
                ContextMenuOpening="OnResultsGridContextMenuOpening"
                MouseDoubleClick="OnResultsGridMouseDoubleClick"
                PreviewMouseLeftButtonDown="OnResultsGridPreviewMouseLeftButtonDown"
                PreviewMouseRightButtonDown="OnResultsGridPreviewMouseRightButtonDown"
                ScrollViewer.ScrollChanged="OnResultsGridScrollChanged"
                SelectedItem="{Binding SelectedItem}"
                SelectionChanged="OnResultsGridSelectionChanged"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.PanningMode="Both"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Sorting="OnResultsGridSorting"
                Visibility="{Binding HasIndex, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="IsEnabled" Value="False" /><Setter Property="Opacity" Value="0.45" /></DataTrigger>
                            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.UsesQuerySelection, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" /><Condition Binding="{Binding IsSelected}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" /></MultiDataTrigger>
                            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.UsesQuerySelection, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" /><Condition Binding="{Binding IsSelected}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                        <MenuItem Command="{Binding DataContext.RefreshItemScopeCommand}" CommandParameter="{Binding CurrentItem}" Header="{DynamicResource Loc.View.Files.Header.RefreshOnlyThisFolder}" />
                        <Separator />
                        <MenuItem Command="{Binding DataContext.OpenItemFolderCommand}" CommandParameter="{Binding CurrentItem}" Header="{DynamicResource Loc.View.Files.Header.OpenFolder}" />
                        <MenuItem Command="{Binding DataContext.CopyItemFolderPathCommand}" CommandParameter="{Binding CurrentItem}" Header="{DynamicResource Loc.View.Files.Header.CopyFolderPath}" />
                        <Separator />
                        <MenuItem Command="{Binding DataContext.CopySelectionCommand}" Header="{DynamicResource Loc.View.Files.Header.CopySelectionUsingCurrentOutputFormat}" />
                        <MenuItem Command="{Binding DataContext.OpenItemCommand}" CommandParameter="{Binding CurrentItem}" Header="{DynamicResource Loc.View.Files.Header.OpenItem}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="52" MinWidth="52" CanUserReorder="False" CanUserResize="False" CanUserSort="False">
                        <DataGridTemplateColumn.Header><ui:Button Width="32" Height="28" Padding="0" Appearance="Transparent" Icon="{ui:SymbolIcon Symbol=CheckboxChecked20}" Command="{Binding DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" AutomationProperties.Name="{DynamicResource Loc.Selection.All}" ToolTip="{DynamicResource Loc.Selection.All.ToolTip}" /></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=OneWay}" AutomationProperties.Name="{DynamicResource Loc.Catalog.Selection.Item}" PreviewMouseLeftButtonDown="OnSelectionCheckBoxPreviewMouseLeftButtonDown" PreviewKeyDown="OnSelectionCheckBoxPreviewKeyDown" Checked="OnSelectionCheckBoxStateChanged" Unchecked="OnSelectionCheckBoxStateChanged" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="180" MinWidth="160" Header="{DynamicResource Loc.Profiles.New.DefaultField}" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    behaviors:TextHighlighting.DisplayText="{Binding Name}"
                                    behaviors:TextHighlighting.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*" MinWidth="240" Header="{DynamicResource Loc.Files.Sort.Path}" SortMemberPath="Path">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    behaviors:TextHighlighting.DisplayText="{Binding ParentPath}"
                                    behaviors:TextHighlighting.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding FullPath}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="120" ElementStyle="{StaticResource FileMetadataCellTextStyle}" Binding="{Binding KindText}" Header="{DynamicResource Loc.Files.Sort.Kind}" SortMemberPath="FileType" />
                    <DataGridTextColumn Width="110" ElementStyle="{StaticResource FileMetadataCellTextStyle}" Binding="{Binding SizeText}" Header="{DynamicResource Loc.Files.Sort.Size}" SortMemberPath="Size" />
                    <DataGridTextColumn Width="150" ElementStyle="{StaticResource FileMetadataCellTextStyle}" Binding="{Binding ModifiedLocal, StringFormat={}{0:g}}" Header="{DynamicResource Loc.Files.Sort.Modified}" SortMemberPath="Modified" />
                    <DataGridTextColumn Width="150" ElementStyle="{StaticResource FileMetadataCellTextStyle}" Binding="{Binding CreatedLocal, StringFormat={}{0:g}}" Header="{DynamicResource Loc.Files.Sort.Created}" SortMemberPath="Created" />
                    <DataGridTextColumn Width="90" ElementStyle="{StaticResource FileMetadataCellTextStyle}" Binding="{Binding StatusText}" Header="{DynamicResource Loc.Catalog.Column.Status}" CanUserSort="False" />
                </DataGrid.Columns>
            </DataGrid>

            <Border
                x:Name="SelectionToolbar"
                Grid.Row="2"
                Margin="0,8,0,0"
                Padding="8,4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"

                Style="{StaticResource FluentToolbarSurfaceStyle}"
                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,0,0" Orientation="Horizontal">
                        <TextBlock
                            Margin="4,0,12,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedCount, StringFormat={StaticResource Loc.Common.SelectedCountFormat}}" />
                        <ComboBox
                            Width="140"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="{DynamicResource Loc.View.Files.AutomationName.SelectionOutputFormat}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding OutputFormats}"
                            SelectedItem="{Binding SelectedOutputFormat}" />
                    </StackPanel>
                    <ui:Button
                        Margin="0,0,12,0"
                        Appearance="Primary"
                        Command="{Binding CopySelectionCommand}"
                        Content="{DynamicResource Loc.Workspace.Selection.Copy}"
                        ToolTip="{DynamicResource Loc.Workspace.Selection.Copy.Help}"
                        Icon="{ui:SymbolIcon Symbol=Copy20}" />

                    <ui:Button
                        Margin="0,0,6,0"
                        Command="{Binding ClearSelectionCommand}"
                        Width="28" Padding="0"
                        Icon="{ui:SymbolIcon Symbol=CheckboxUnchecked20}"
                        AutomationProperties.Name="{DynamicResource Loc.Workspace.Selection.Clear}"
                        ToolTip="{DynamicResource Loc.Workspace.Selection.Clear}" />
                    <ui:Button
                        Margin="0,0,0,0"
                        Command="{Binding InvertSelectionCommand}"
                        Width="28" Padding="0"
                        Icon="{ui:SymbolIcon Symbol=ArrowSwap20}"
                        AutomationProperties.Name="{DynamicResource Loc.Workspace.Selection.Invert}"
                        ToolTip="{DynamicResource Loc.Selection.Invert.ToolTip}" />
                </WrapPanel>
            </Border>

            <Border
                Grid.Row="1"
                Style="{StaticResource FluentEmptyStateStyle}"
                Visibility="{Binding IsSetupStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="FolderSearch24" />
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="{Binding IndexStatusTitle}"
                        TextAlignment="Center" />
                    <TextBlock
                        Margin="0,8,0,20"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PageSubtitleTextStyle}"
                        Text="{Binding IndexStatusDetail}"
                        TextAlignment="Center" />
                    <ui:Button
                        MinWidth="160"
                        HorizontalAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding BrowseRootCommand}"
                        Content="{DynamicResource Loc.Home.Setup.Location.Title}"
                        Icon="{ui:SymbolIcon Symbol=FolderOpen20}"
                        Visibility="{Binding HasNoRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button
                        MinWidth="160"
                        HorizontalAlignment="Center"
                        Command="{Binding BrowseRootCommand}"
                        Content="{DynamicResource Loc.View.Files.Content.ChooseAnotherLocation}"
                        Icon="{ui:SymbolIcon Symbol=FolderOpen20}"
                        Visibility="{Binding HasRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button
                        MinWidth="160"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding RefreshIndexCommand}"
                        Content="{DynamicResource Loc.View.Files.Content.CreateIndex}"
                        Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                        Visibility="{Binding HasRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="1"
                Style="{StaticResource FluentEmptyStateStyle}"
                Visibility="{Binding IsNoResultsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Search48" />
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="{DynamicResource Loc.View.Files.Text.NoMatchingItems}" />
                    <TextBlock
                        Margin="0,8,0,20"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PageSubtitleTextStyle}"
                        Text="{DynamicResource Loc.View.Files.Text.TryAShorterQueryOrClearThe}"
                        TextAlignment="Center" />
                    <ui:Button Command="{Binding ClearSearchAndFiltersCommand}" Content="{DynamicResource Loc.View.Files.Content.ClearSearchAndFilters}" />
                </StackPanel>
            </Border>


        </Grid>

        <Border Grid.Row="3" Padding="0,4" Background="Transparent">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Grid.Column="1" MaxWidth="260" Margin="12,0,0,0" Text="{Binding ResultSourceDescription}" Style="{StaticResource CaptionTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultSourceDescription}" AutomationProperties.Name="{DynamicResource Loc.Workspace.ResultSource}" />
            </Grid>
        </Border>
        <Border x:Name="FileDetailsPanel" Grid.Row="2" Width="340" HorizontalAlignment="Right" VerticalAlignment="Stretch" Panel.ZIndex="8" Style="{StaticResource FluentSurfaceStyle}" Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer x:Name="FileDetailsScrollViewer" Style="{StaticResource FluentGutteredScrollViewerStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.Workspace.Details}" />
                    <TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionTextStyle}" Text="{Binding IndexStatusDetail}" />
                    <WrapPanel>
                        <ui:Button Command="{Binding BrowseDatabaseCommand}" Content="{DynamicResource Loc.Workspace.Database.Choose}" ToolTip="{Binding DatabasePath}" Margin="0,0,8,8" />
                        <ui:Button Command="{Binding UseDefaultDatabasePathCommand}" Content="{DynamicResource Loc.Workspace.Database.Default}" ToolTip="{Binding DefaultDatabasePath}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,4" FontWeight="SemiBold" Text="{DynamicResource Loc.Workspace.Partial.Title}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{DynamicResource Loc.Workspace.Partial.Help}" />
                    <ui:TextBox x:Name="PartialRefreshPathTextBox" Margin="0,8,0,0" MinWidth="120" ClearButtonEnabled="True" PlaceholderText="{DynamicResource Loc.Workspace.Partial.Path}" Text="{Binding RefreshScopePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Partial.Path}" />
                    <WrapPanel Margin="0,8,0,0">
                        <ui:Button Command="{Binding BrowseRefreshScopeCommand}" Content="{DynamicResource Loc.Workspace.Folder.Choose}" Margin="0,0,8,8" />
                        <ui:Button x:Name="PartialRefreshButton" Command="{Binding RefreshScopeCommand}" Content="{DynamicResource Loc.Workspace.Partial.Refresh}" ToolTip="{DynamicResource Loc.Workspace.Partial.Help}" ToolTipService.ShowOnDisabled="True" Margin="0,0,0,8" />
                    </WrapPanel>
                    <Separator Margin="0,8" />
                    <ComboBox DisplayMemberPath="DisplayName" ItemsSource="{Binding KindChoices}" SelectedItem="{Binding SelectedKind}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Kind}" />
                    <ToggleButton x:Name="FilterButton" Margin="0,8,0,0" Content="{DynamicResource Loc.Workspace.Filters}" IsChecked="{Binding IsFilterOpen, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Filters}" />
                    <ComboBox Margin="0,8,0,0" DisplayMemberPath="DisplayName" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelectedSort}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Sort}" />
                    <ui:Button Margin="0,8,0,0" Command="{Binding ToggleSortDirectionCommand}" Content="{Binding SortDirectionText}" Icon="{ui:SymbolIcon Symbol=ArrowSort20}" ToolTip="{DynamicResource Loc.Workspace.Sort.Direction.Help}" />
            <Popup
                x:Name="FilterPopup"
                AllowsTransparency="True"
                IsOpen="{Binding IsFilterOpen, Mode=TwoWay}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=FilterButton}"
                StaysOpen="False">
                <Border
                    Width="460"
                    Margin="0,8,0,0"
                    DataContext="{Binding DataContext, ElementName=FilterButton}"
                    Style="{StaticResource FluentSurfaceStyle}">
                    <ScrollViewer
                        x:Name="FileFilterScrollViewer"
                        MaxHeight="560"
                        Style="{StaticResource FluentGutteredScrollViewerStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <TextBlock
                                    DockPanel.Dock="Left"
                                    Style="{StaticResource SectionTitleTextStyle}"
                                    Text="{DynamicResource Loc.View.Files.Text.SearchFilters}" />
                                <ui:Button
                                    HorizontalAlignment="Right"
                                    Command="{Binding ClearFiltersCommand}"
                                    Content="{DynamicResource Loc.View.Files.Content.ClearAll}" />
                            </DockPanel>

                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource Loc.View.Files.Text.FileSize}" />
                            <TextBlock
                                Margin="0,2,0,8"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{DynamicResource Loc.View.Files.Text.SizeFiltersApplyOnlyToFilesFolders}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.View.Files.Text.Minimum}" />
                                    <Slider
                                        Margin="0,6,0,0"
                                        AutomationProperties.Name="{DynamicResource Loc.View.Files.AutomationName.MinimumFileSize}"
                                        IsSnapToTickEnabled="True"
                                        Maximum="10"
                                        Minimum="0"
                                        TickFrequency="1"
                                        Value="{Binding MinimumSizeStep}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding MinimumSizeText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Loc.View.Files.Text.Maximum}" />
                                    <Slider
                                        Margin="0,6,0,0"
                                        AutomationProperties.Name="{DynamicResource Loc.View.Files.AutomationName.MaximumFileSize}"
                                        IsSnapToTickEnabled="True"
                                        Maximum="11"
                                        Minimum="1"
                                        TickFrequency="1"
                                        Value="{Binding MaximumSizeStep}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding MaximumSizeText}" />
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,16" />
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource Loc.Files.Sort.Created}" />
                            <ComboBox
                                Margin="0,8,0,0"
                                AutomationProperties.Name="{DynamicResource Loc.View.Files.AutomationName.CreatedDateFilter}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding DateFilterChoices}"
                                SelectedItem="{Binding SelectedCreatedDateFilter}" />
                            <Grid Margin="0,8,0,0" Visibility="{Binding IsCreatedCustomRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DatePicker AutomationProperties.Name="{DynamicResource Loc.View.Files.AutomationName.CreatedStartDate}" SelectedDate="{Binding CreatedFromDate}" />
                                <DatePicker Grid.Column="2" AutomationProperties.Name="{DynamicResource Loc.View.Files.AutomationName.CreatedEndDate}" SelectedDate="{Binding CreatedToDate}" />
                            </Grid>

                            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="{DynamicResource Loc.Files.Sort.Modified}" />
                            <ComboBox
                                Margin="0,8,0,0"
                                AutomationProperties.Name="{DynamicResource Loc.View.Files.AutomationName.ModifiedDateFilter}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding DateFilterChoices}"
                                SelectedItem="{Binding SelectedModifiedDateFilter}" />
                            <Grid Margin="0,8,0,0" Visibility="{Binding IsModifiedCustomRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DatePicker AutomationProperties.Name="{DynamicResource Loc.View.Files.AutomationName.ModifiedStartDate}" SelectedDate="{Binding ModifiedFromDate}" />
                                <DatePicker Grid.Column="2" AutomationProperties.Name="{DynamicResource Loc.View.Files.AutomationName.ModifiedEndDate}" SelectedDate="{Binding ModifiedToDate}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </controls:WorkspacePageFrame>
</Page>
