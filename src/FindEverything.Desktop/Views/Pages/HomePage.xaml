<Page x:Class="FindEverything.Desktop.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls"
    Title="{DynamicResource Loc.Home.Nav}" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:DynamicScrollViewer x:Name="HomeScrollViewer" HorizontalScrollBarVisibility="Disabled"
        Style="{StaticResource FluentGutteredScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DashboardContent" Margin="24,8,8,24" SizeChanged="OnDashboardContentSizeChanged">
            <controls:PageHeader Title="FindEverything" Description="{DynamicResource Loc.Ux.Shell.Home.Description}" />
            <ui:InfoBar Margin="0,0,12,12" AutomationProperties.LiveSetting="Polite" IsClosable="False"
                IsOpen="{Binding IsOperationRunning}" Message="{Binding OperationStatus}" Title="{DynamicResource Loc.Home.Operation.Title}" />
            <controls:SectionCard x:Name="WorkspaceOverviewCard" Margin="0,8,12,16" Padding="20" Style="{StaticResource FluentCardStyle}">
                <controls:SectionCard.Header>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <ui:TextBlock Text="{DynamicResource Loc.Ux.Shell.Home.Location}" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <ui:TextBlock Margin="0,8,0,0" Text="{Binding CurrentLocation}" TextWrapping="Wrap" ToolTip="{Binding CurrentLocation}" />
                            <ui:TextBlock Margin="0,4,0,0" Text="{Binding CurrentSourceName}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button Content="{DynamicResource Loc.Ux.Shell.Home.ChooseLocation}" Command="{Binding ChooseLocationCommand}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}"
                                ToolTip="{DynamicResource Loc.Ux.Shell.Home.ChooseLocation.Help}" ToolTipService.ShowOnDisabled="True" />
                            <ui:Button Margin="0,8,0,0" Command="{Binding UseLocalSourceCommand}" Content="{DynamicResource Loc.Transfer.Source.Local}"
                                Visibility="{Binding IsSharedSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </controls:SectionCard.Header>
            </controls:SectionCard>
            <WrapPanel x:Name="PrimaryCardsHost">
                <ui:CardAction x:Name="FilesActionCard" Command="{Binding OpenFilesCommand}" Margin="0,0,12,12" Padding="20" MinHeight="124"
                    AutomationProperties.Name="{DynamicResource Loc.Home.Files.Title}" ToolTip="{DynamicResource Loc.Home.Files.Description}">
                    <StackPanel><ui:TextBlock FontSize="20" FontWeight="SemiBold" Text="{DynamicResource Loc.Home.Files.Title}" />
                        <ui:TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{DynamicResource Loc.Ux.Shell.Home.Files}" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction x:Name="CatalogActionCard" Command="{Binding OpenCatalogCommand}" Margin="0,0,12,12" Padding="20" MinHeight="124"
                    AutomationProperties.Name="{DynamicResource Loc.Home.Catalog.Title}" ToolTip="{DynamicResource Loc.Home.Catalog.Description}">
                    <StackPanel><ui:TextBlock FontSize="20" FontWeight="SemiBold" Text="{DynamicResource Loc.Home.Catalog.Title}" />
                        <ui:TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{DynamicResource Loc.Ux.Shell.Home.Catalog}" />
                    </StackPanel>
                </ui:CardAction>
            </WrapPanel>
            <controls:SectionCard Margin="0,4,12,12" Padding="16" Style="{StaticResource FluentCardStyle}">
                <controls:SectionCard.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{DynamicResource Loc.Ux.Shell.Home.Profile}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                        <ui:TextBlock Text="{Binding ProfileName}" Margin="0,4,0,8" TextWrapping="Wrap" />
                        <WrapPanel>
                            <ui:Button Command="{Binding OpenProfilesCommand}" Content="{DynamicResource Loc.Home.Tools.Profiles}" Margin="0,0,8,8" />
                            <ui:Button Command="{Binding OpenPlaygroundCommand}" Content="{DynamicResource Loc.Home.Tools.Playground}" Margin="0,0,8,8" />
                            <ui:Button Command="{Binding OpenOutputFormatsCommand}" Content="{DynamicResource Loc.Home.Tools.OutputFormats}" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </controls:SectionCard.Header>
            </controls:SectionCard>
            <ui:CardExpander Margin="0,0,12,0" Header="{DynamicResource Loc.Ux.Shell.Home.Storage}" IsExpanded="False">
                <StackPanel>
                    <ui:TextBlock Text="{DynamicResource Loc.Home.Workspace.FileDatabase}" FontWeight="SemiBold" />
                    <ui:TextBlock Text="{Binding FileDatabasePath}" Margin="0,4,0,12" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                    <ui:TextBlock Text="{DynamicResource Loc.Home.Workspace.ProfileDatabase}" FontWeight="SemiBold" />
                    <ui:TextBlock Text="{Binding ProfileDatabasePath}" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </ui:DynamicScrollViewer>
</Page>
