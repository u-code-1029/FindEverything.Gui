<Page x:Class="FindEverything.Desktop.Views.Pages.OutputFormatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Loc.Shell.Nav.OutputFormats}" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="OutputTokenButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Appearance" Value="Transparent" /><Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>
    <controls:WorkspacePageFrame>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12" AutomationProperties.HelpText="{DynamicResource Loc.Workspace.Output.Description}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Label x:Name="OutputFormatLabel" Grid.ColumnSpan="2" Padding="0" Margin="0,0,0,4" Content="{DynamicResource Loc.Workspace.Output.Choose}" Target="{Binding ElementName=OutputFormatComboBox}" />
            <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}" x:Name="OutputFormatComboBox" Grid.Row="1" HorizontalAlignment="Stretch" IsEnabled="{Binding IsEditorReady}" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="DisplayName" AutomationProperties.Name="{DynamicResource Loc.Workspace.Output.Choose}" ToolTip="{DynamicResource Loc.Workspace.Output.Choose.Help}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <ui:Button x:Name="NewOutputFormatButton" Command="{Binding NewFormatCommand}" Content="{DynamicResource Loc.Workspace.Output.New}" Icon="{ui:SymbolIcon Symbol=AddSquare20}" ToolTip="{DynamicResource Loc.Workspace.Output.New.Help}" ToolTipService.ShowOnDisabled="True" />
                <ui:Button Margin="8,0,0,0" Appearance="Transparent" Command="{Binding DeleteCommand}" Content="{DynamicResource Loc.Workspace.Output.Delete}" Icon="{ui:SymbolIcon Symbol=Delete12}" Visibility="{Binding IsDeleteAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
        <controls:SplitWorkspace x:Name="OutputWorkspace" Grid.Row="1" PrimaryRatio="0.58" KeepSecondaryVisible="True" PrimaryTitle="{DynamicResource Loc.Workspace.Output.Edit}" SecondaryTitle="{DynamicResource Loc.Workspace.Output.Preview}">
            <controls:SplitWorkspace.PrimaryContent>
                <ui:DynamicScrollViewer x:Name="OutputFormatsScrollViewer" IsEnabled="{Binding IsEditorReady}" Style="{StaticResource FluentGutteredScrollViewerStyle}">
                    <StackPanel>
                        <controls:SectionCard Padding="16" Visibility="{Binding IsBuiltInPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <controls:SectionCard.Header><StackPanel>
                                <ui:TextBlock Text="{Binding DraftDisplayName}" Style="{StaticResource SectionTitleTextStyle}" TextWrapping="Wrap" />
                                <ui:TextBlock Margin="0,8,0,16" Text="{DynamicResource Loc.Ux.Output.BuiltIn}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <ui:TextBlock Text="{DynamicResource Loc.Workspace.Output.Template}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ui:TextBox Text="{Binding DraftTemplate, Mode=OneWay}" IsReadOnly="True" MinHeight="96" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" AutomationProperties.Name="{DynamicResource Loc.Workspace.Output.Template}" />
                            </StackPanel></controls:SectionCard.Header>
                        </controls:SectionCard>
                        <controls:SectionCard Padding="16" Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <controls:SectionCard.Header><StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <Label Padding="0" Margin="0,0,0,4" Content="{DynamicResource Loc.Workspace.Output.Name}" Target="{Binding ElementName=OutputNameTextBox}" />
                                        <ui:TextBox x:Name="OutputNameTextBox" Text="{Binding DraftDisplayName, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Loc.Workspace.Output.Name}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                        <Label x:Name="OutputProfileLabel" Padding="0" Margin="0,0,0,4" Content="{DynamicResource Loc.Workspace.Output.Profile}" Target="{Binding ElementName=OutputProfileComboBox}" />
                                        <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}" x:Name="OutputProfileComboBox" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedProfileChoice}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Output.Profile}" ToolTip="{DynamicResource Loc.Output.Profile.Choose.Help}" />
                                    </StackPanel>
                                </Grid>
                                <Label Padding="0" Margin="0,0,0,8" FontWeight="SemiBold" Content="{DynamicResource Loc.Workspace.Output.Template}" Target="{Binding ElementName=TemplateTextBox}" />
                                <ItemsControl ItemsSource="{Binding CommonTokenChoices}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><ui:Button Style="{StaticResource OutputTokenButtonStyle}" Click="OnInsertTokenClick" Content="{Binding DisplayName}" ToolTip="{Binding Description}" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding ProfileTokenChoices}" ToolTip="{Binding ProfileColumnGuidance}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><ui:Button Style="{StaticResource OutputTokenButtonStyle}" Click="OnInsertTokenClick" Content="{Binding DisplayName}" ToolTip="{Binding Description}" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:TextBox x:Name="TemplateTextBox" MinHeight="112" Padding="12" HorizontalAlignment="Stretch" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding DraftTemplate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Output.Template}" ToolTip="{DynamicResource Loc.Workspace.Output.Template.Help}" />
                                <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding PreviewValidationMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <ui:CardExpander x:Name="OutputAffixesExpander" Margin="0,12,0,0" Header="{DynamicResource Loc.Ux.Output.JoinOptions}">
                                    <StackPanel Margin="0,8,0,0">
                                        <ui:TextBlock Text="{DynamicResource Loc.Output.Affixes.Help}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                        <Label Padding="0" Margin="0,0,0,4" Content="{DynamicResource Loc.Workspace.Output.Separator}" Target="{Binding ElementName=OutputSeparatorTextBox}" />
                                        <ui:TextBox x:Name="OutputSeparatorTextBox" Text="{Binding DraftItemSeparator, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="{DynamicResource Loc.Workspace.Output.Separator}" ToolTip="{DynamicResource Loc.Workspace.Output.Separator.Help}" />
                                        <Label Padding="0" Margin="0,12,0,4" Content="{DynamicResource Loc.Output.Prefix}" Target="{Binding ElementName=OutputPrefixTextBox}" />
                                        <ui:TextBox x:Name="OutputPrefixTextBox" Text="{Binding DraftPrefix, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="{DynamicResource Loc.Output.Prefix}" ToolTip="{DynamicResource Loc.Output.Prefix.Help}" />
                                        <Label Padding="0" Margin="0,12,0,4" Content="{DynamicResource Loc.Output.Suffix}" Target="{Binding ElementName=OutputSuffixTextBox}" />
                                        <ui:TextBox x:Name="OutputSuffixTextBox" Text="{Binding DraftSuffix, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="{DynamicResource Loc.Output.Suffix}" ToolTip="{DynamicResource Loc.Output.Suffix.Help}" />
                                    </StackPanel>
                                </ui:CardExpander>
                            </StackPanel></controls:SectionCard.Header>
                        </controls:SectionCard>
                    </StackPanel>
                </ui:DynamicScrollViewer>
            </controls:SplitWorkspace.PrimaryContent>
            <controls:SplitWorkspace.SecondaryContent>
                <controls:SectionCard x:Name="OutputPreviewCard" Style="{StaticResource WorkspaceResultCardStyle}" Padding="12" VerticalContentAlignment="Stretch">
                    <controls:SectionCard.Header>
                        <Grid x:Name="OutputPreviewContent"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <WrapPanel x:Name="OutputPreviewHeading">
                                <ui:TextBlock x:Name="OutputPreviewTitle" Margin="0,2,12,2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource Loc.Workspace.Output.Preview}" />
                                <CheckBox x:Name="OutputUseTestSampleCheckBox" Margin="0,2,0,2" VerticalAlignment="Center" Content="{DynamicResource Loc.Ux.Output.UseTestSample}" IsChecked="{Binding UseTestSample}" Visibility="{Binding HasTestSample, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </WrapPanel>
                            <ui:TextBlock Grid.Row="1" Margin="0,4,0,8" Text="{Binding PreviewSourceDescription}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            <ui:TextBox x:Name="OutputPreviewTextBox" Grid.Row="2" Padding="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderThickness="0" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Loc.Workspace.Output.Preview}" ToolTip="{DynamicResource Loc.Workspace.Output.Preview.Help}" />
                        </Grid>
                    </controls:SectionCard.Header>
                </controls:SectionCard>
            </controls:SplitWorkspace.SecondaryContent>
        </controls:SplitWorkspace>
        <controls:CommandStrip x:Name="OutputActionsFooter" controls:FloatingNotificationChrome.IsBottomChrome="True" Grid.Row="2" Margin="0,12,0,0" Padding="12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
                <ui:Button x:Name="SaveFormatButton" Grid.Column="1" MinWidth="112" Appearance="Primary" Command="{Binding SaveCommand}" Content="{DynamicResource Loc.Workspace.Output.Save}" Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{DynamicResource Loc.Workspace.Output.Save.Help}" ToolTipService.ShowOnDisabled="True" Icon="{ui:SymbolIcon Symbol=Save16}" />
                <ui:Button Grid.Column="1" Appearance="Primary" Command="{Binding DuplicateFormatCommand}" Content="{DynamicResource Loc.Ux.Output.Duplicate}" Visibility="{Binding IsBuiltInPreview, Converter={StaticResource BooleanToVisibilityConverter}}" Icon="{ui:SymbolIcon Symbol=Copy20}" />
            </Grid>
        </controls:CommandStrip>
    </controls:WorkspacePageFrame>
</Page>
