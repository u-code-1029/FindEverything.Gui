<Page x:Class="FindEverything.Desktop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Loc.Shell.Nav.Settings}" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <!-- Related options share one card, rather than a separate border around every row. -->
        <Style x:Key="SettingsSectionCardStyle" TargetType="ui:CardControl" BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="Margin" Value="{StaticResource SectionGap}" />
        </Style>
        <Style x:Key="GroupedSettingRowStyle" TargetType="controls:SettingRowCard">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:SettingRowCard">
                        <Border Padding="0,12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.45*" /><ColumnDefinition Width="0.55*" /></Grid.ColumnDefinitions>
                                <StackPanel x:Name="DescriptionPanel" Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" Text="{TemplateBinding Description}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ContentPresenter x:Name="Editor" Grid.Column="1" VerticalAlignment="Center" Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsCompact" Value="True">
                                <Setter TargetName="DescriptionPanel" Property="Grid.ColumnSpan" Value="2" />
                                <Setter TargetName="DescriptionPanel" Property="Margin" Value="0,0,0,8" />
                                <Setter TargetName="Editor" Property="Grid.Column" Value="0" />
                                <Setter TargetName="Editor" Property="Grid.Row" Value="1" />
                                <Setter TargetName="Editor" Property="Grid.ColumnSpan" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <controls:WorkspacePageFrame>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <controls:PageHeader Title="{DynamicResource Loc.Shell.Nav.Settings}" Description="{DynamicResource Loc.Workspace.Settings.Description}" />
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Style="{StaticResource FluentGutteredScrollViewerStyle}">
            <StackPanel HorizontalAlignment="Stretch" IsEnabled="{Binding IsEditable}" ToolTipService.ShowOnDisabled="True">
                <controls:SectionCard x:Name="IndexingSettingsCard" Style="{StaticResource SettingsSectionCardStyle}">
                    <controls:SectionCard.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.Workspace.Settings.Indexing}" AutomationProperties.HeadingLevel="Level2" />
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" Title="{DynamicResource Loc.Workspace.Settings.PageSize}" Description="{DynamicResource Loc.Workspace.Settings.PageSize.Help}">
                            <ui:TextBox HorizontalAlignment="Stretch" Text="{Binding SearchPageSizeText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.PageSize}" ToolTip="{DynamicResource Loc.Workspace.Settings.PageSize.Help}" />
                        </controls:SettingRowCard>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" Title="{DynamicResource Loc.Workspace.Settings.ScanBatch}" Description="{DynamicResource Loc.Workspace.Settings.ScanBatch.Help}">
                            <ui:TextBox HorizontalAlignment="Stretch" Text="{Binding UiUpdateBatchSizeText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.ScanBatch}" ToolTip="{DynamicResource Loc.Workspace.Settings.ScanBatch.Help}" />
                        </controls:SettingRowCard>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" Title="{DynamicResource Loc.Workspace.Settings.Throttle}" Description="{DynamicResource Loc.Workspace.Settings.Throttle.Help}">
                            <ui:TextBox HorizontalAlignment="Stretch" Text="{Binding MaxEntriesPerSecondText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.Throttle}" ToolTip="{DynamicResource Loc.Workspace.Settings.Throttle.Help}" />
                        </controls:SettingRowCard>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" BorderThickness="0" Title="{DynamicResource Loc.Workspace.Settings.Delay}" Description="{DynamicResource Loc.Workspace.Settings.Delay.Help}">
                            <ui:TextBox HorizontalAlignment="Stretch" Text="{Binding DirectoryDelayMillisecondsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.Delay}" ToolTip="{DynamicResource Loc.Workspace.Settings.Delay.Help}" />
                        </controls:SettingRowCard>
                    </StackPanel>
                    </controls:SectionCard.Header>
                </controls:SectionCard>
                <controls:SectionCard x:Name="NotificationSettingsCard" Style="{StaticResource SettingsSectionCardStyle}">
                    <controls:SectionCard.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.Workspace.Settings.Notifications}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="{DynamicResource Loc.Workspace.Settings.Notifications.Help}" TextWrapping="Wrap" />
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" BorderThickness="0" Title="{DynamicResource Loc.Workspace.Settings.NotificationDuration}" Description="{DynamicResource Loc.Workspace.Settings.NotificationDuration.Help}">
                            <ui:TextBox HorizontalAlignment="Stretch" Text="{Binding NotificationAutoDismissSecondsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.NotificationDuration}" ToolTip="{DynamicResource Loc.Workspace.Settings.NotificationDuration.Help}" />
                        </controls:SettingRowCard>
                    </StackPanel>
                    </controls:SectionCard.Header>
                </controls:SectionCard>
                <controls:SectionCard x:Name="AppearanceSettingsCard" Style="{StaticResource SettingsSectionCardStyle}">
                    <controls:SectionCard.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.Workspace.Settings.Appearance}" AutomationProperties.HeadingLevel="Level2" />
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" Title="{DynamicResource Loc.Workspace.Settings.Theme}" Description="{DynamicResource Loc.Workspace.Settings.Theme.Help}">
                            <ComboBox HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.Theme}" />
                        </controls:SettingRowCard>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" Title="{DynamicResource Loc.Workspace.Settings.Backdrop}" Description="{DynamicResource Loc.Workspace.Settings.Backdrop.Help}">
                            <ComboBox HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" ItemsSource="{Binding BackdropChoices}" SelectedItem="{Binding SelectedBackdrop}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.Backdrop}" />
                        </controls:SettingRowCard>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" BorderThickness="0" Title="{DynamicResource Loc.Workspace.Settings.Language}" Description="{DynamicResource Loc.Workspace.Settings.Language.Help}">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{DynamicResource Loc.Workspace.Settings.Language.Action}" />
                        </controls:SettingRowCard>
                    </StackPanel>
                    </controls:SectionCard.Header>
                </controls:SectionCard>
                <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding NumericValidationMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasNumericValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <controls:SectionCard Style="{StaticResource SettingsSectionCardStyle}">
                    <controls:SectionCard.Header>
                    <Expander Header="{DynamicResource Loc.Workspace.Settings.Advanced}">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource Loc.Workspace.Settings.File}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding UserSettingsFile}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Expander>
                    </controls:SectionCard.Header>
                </controls:SectionCard>
            </StackPanel>
        </ScrollViewer>
        <controls:CommandStrip Grid.Row="2" Margin="0,8,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button MinWidth="104" Margin="0,0,8,0" Command="{Binding ResetCommand}" Content="{DynamicResource Loc.Workspace.Settings.Reset}" ToolTip="{DynamicResource Loc.Workspace.Settings.Reset.Help}" ToolTipService.ShowOnDisabled="True" />
                    <ui:Button MinWidth="104" Appearance="Primary" Command="{Binding SaveCommand}" Content="{DynamicResource Loc.Workspace.Settings.Save}" ToolTip="{DynamicResource Loc.Workspace.Settings.Save.Help}" ToolTipService.ShowOnDisabled="True" Icon="{ui:SymbolIcon Symbol=Save16}" />
                </StackPanel>
            </Grid>
        </controls:CommandStrip>
    </controls:WorkspacePageFrame>
</Page>
