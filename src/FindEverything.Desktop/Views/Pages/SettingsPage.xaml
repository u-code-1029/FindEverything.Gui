<Page x:Class="FindEverything.Desktop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Loc.Shell.Nav.Settings}" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <!-- Related options share one card, rather than a separate border around every row. -->
        <Style x:Key="SettingsSectionCardStyle" TargetType="ui:CardControl" BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="Margin" Value="{StaticResource SectionGap}" />
        </Style>
        <Style x:Key="SettingsSectionIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="GroupedSettingRowStyle" TargetType="controls:SettingRowCard">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:SettingRowCard">
                        <Border Padding="0,16" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.45*" /><ColumnDefinition Width="0.55*" /></Grid.ColumnDefinitions>
                                <StackPanel x:Name="DescriptionPanel" Margin="0,0,24,0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ui:TextBlock Margin="0,4,0,0" Text="{TemplateBinding Description}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ContentPresenter x:Name="Editor" Grid.Column="1" VerticalAlignment="Center" Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsCompact" Value="True">
                                <Setter TargetName="DescriptionPanel" Property="Grid.ColumnSpan" Value="2" />
                                <Setter TargetName="DescriptionPanel" Property="Margin" Value="0,0,0,8" />
                                <Setter TargetName="Editor" Property="Grid.Column" Value="0" />
                                <Setter TargetName="Editor" Property="Grid.Row" Value="1" />
                                <Setter TargetName="Editor" Property="Grid.ColumnSpan" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InlineNumericErrorStyle" TargetType="ui:TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
        </Style>
    </Page.Resources>
    <controls:WorkspacePageFrame>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ui:DynamicScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0" Style="{StaticResource FluentGutteredScrollViewerStyle}" AutomationProperties.HelpText="{DynamicResource Loc.Workspace.Settings.Description}">
            <StackPanel HorizontalAlignment="Stretch" IsEnabled="{Binding IsEditable}" ToolTipService.ShowOnDisabled="True">
                <controls:SectionCard x:Name="AppearanceSettingsCard" Style="{StaticResource SettingsSectionCardStyle}">
                    <controls:SectionCard.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource SettingsSectionIconStyle}" />
                            <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.Workspace.Settings.Appearance}" AutomationProperties.HeadingLevel="Level2" />
                        </StackPanel>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" Title="{DynamicResource Loc.Workspace.Settings.Theme}" Description="{DynamicResource Loc.Workspace.Settings.Theme.Help}">
                            <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.Theme}" />
                        </controls:SettingRowCard>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" Title="{DynamicResource Loc.Workspace.Settings.Backdrop}" Description="{DynamicResource Loc.Workspace.Settings.Backdrop.Help}">
                            <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" ItemsSource="{Binding BackdropChoices}" SelectedItem="{Binding SelectedBackdrop}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.Backdrop}" />
                        </controls:SettingRowCard>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" Title="{DynamicResource Loc.Settings.Density.Title}" Description="{DynamicResource Loc.Settings.Density.Help}">
                            <ComboBox Style="{StaticResource ContentAwareComboBoxStyle}" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" ItemsSource="{Binding CatalogRowDensityChoices}" SelectedItem="{Binding SelectedCatalogRowDensity}" AutomationProperties.Name="{DynamicResource Loc.Settings.Density.Title}" ToolTip="{DynamicResource Loc.Settings.Density.Help}" />
                        </controls:SettingRowCard>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" BorderThickness="0" Title="{DynamicResource Loc.Workspace.Settings.Language}" Description="{DynamicResource Loc.Workspace.Settings.Language.Help}">
                            <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{DynamicResource Loc.Workspace.Settings.Language.Action}" />
                        </controls:SettingRowCard>
                    </StackPanel>
                    </controls:SectionCard.Header>
                </controls:SectionCard>
                <controls:SectionCard x:Name="NotificationSettingsCard" Style="{StaticResource SettingsSectionCardStyle}">
                    <controls:SectionCard.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Info24" Style="{StaticResource SettingsSectionIconStyle}" />
                            <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.Workspace.Settings.Notifications}" AutomationProperties.HeadingLevel="Level2" />
                        </StackPanel>
                        <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="{DynamicResource Loc.Ux.Shell.Settings.Notifications.Help}" TextWrapping="Wrap" />
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" BorderThickness="0" Title="{DynamicResource Loc.Workspace.Settings.NotificationDuration}" Description="{DynamicResource Loc.Workspace.Settings.NotificationDuration.Help}">
                            <StackPanel><ui:TextBox HorizontalAlignment="Stretch" Text="{Binding NotificationAutoDismissSecondsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.NotificationDuration}" ToolTip="{DynamicResource Loc.Workspace.Settings.NotificationDuration.Help}" AutomationProperties.HelpText="{Binding NotificationAutoDismissSecondsError}" />
                                <ui:TextBlock Text="{Binding NotificationAutoDismissSecondsError}" Style="{StaticResource InlineNumericErrorStyle}" /></StackPanel>
                        </controls:SettingRowCard>
                    </StackPanel>
                    </controls:SectionCard.Header>
                </controls:SectionCard>
                <ui:CardExpander x:Name="AdvancedIndexingSettings" Margin="0,0,0,16" Header="{DynamicResource Loc.Ux.Shell.Settings.Advanced}" IsExpanded="False">
                    <StackPanel>
                        <ui:TextBlock Margin="0,0,0,12" Text="{DynamicResource Loc.Ux.Shell.Settings.Advanced.Help}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                <controls:SectionCard x:Name="IndexingSettingsCard" Style="{StaticResource SettingsSectionCardStyle}">
                    <controls:SectionCard.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Search24" Style="{StaticResource SettingsSectionIconStyle}" />
                            <ui:TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.Workspace.Settings.Indexing}" AutomationProperties.HeadingLevel="Level2" />
                        </StackPanel>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" Title="{DynamicResource Loc.Workspace.Settings.PageSize}" Description="{DynamicResource Loc.Workspace.Settings.PageSize.Help}">
                            <StackPanel><ui:TextBox HorizontalAlignment="Stretch" Text="{Binding SearchPageSizeText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.PageSize}" ToolTip="{DynamicResource Loc.Workspace.Settings.PageSize.Help}" AutomationProperties.HelpText="{Binding SearchPageSizeError}" />
                                <ui:TextBlock Text="{Binding SearchPageSizeError}" Style="{StaticResource InlineNumericErrorStyle}" /></StackPanel>
                        </controls:SettingRowCard>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" Title="{DynamicResource Loc.Workspace.Settings.ScanBatch}" Description="{DynamicResource Loc.Workspace.Settings.ScanBatch.Help}">
                            <StackPanel><ui:TextBox HorizontalAlignment="Stretch" Text="{Binding UiUpdateBatchSizeText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.ScanBatch}" ToolTip="{DynamicResource Loc.Workspace.Settings.ScanBatch.Help}" AutomationProperties.HelpText="{Binding UiUpdateBatchSizeError}" />
                                <ui:TextBlock Text="{Binding UiUpdateBatchSizeError}" Style="{StaticResource InlineNumericErrorStyle}" /></StackPanel>
                        </controls:SettingRowCard>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" Title="{DynamicResource Loc.Workspace.Settings.Throttle}" Description="{DynamicResource Loc.Workspace.Settings.Throttle.Help}">
                            <StackPanel><ui:TextBox HorizontalAlignment="Stretch" Text="{Binding MaxEntriesPerSecondText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.Throttle}" ToolTip="{DynamicResource Loc.Workspace.Settings.Throttle.Help}" AutomationProperties.HelpText="{Binding MaxEntriesPerSecondError}" />
                                <ui:TextBlock Text="{Binding MaxEntriesPerSecondError}" Style="{StaticResource InlineNumericErrorStyle}" /></StackPanel>
                        </controls:SettingRowCard>
                        <controls:SettingRowCard Style="{StaticResource GroupedSettingRowStyle}" BorderThickness="0" Title="{DynamicResource Loc.Workspace.Settings.Delay}" Description="{DynamicResource Loc.Workspace.Settings.Delay.Help}">
                            <StackPanel><ui:TextBox HorizontalAlignment="Stretch" Text="{Binding DirectoryDelayMillisecondsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.Delay}" ToolTip="{DynamicResource Loc.Workspace.Settings.Delay.Help}" AutomationProperties.HelpText="{Binding DirectoryDelayMillisecondsError}" />
                                <ui:TextBlock Text="{Binding DirectoryDelayMillisecondsError}" Style="{StaticResource InlineNumericErrorStyle}" /></StackPanel>
                        </controls:SettingRowCard>
                    </StackPanel>
                    </controls:SectionCard.Header>
                </controls:SectionCard>

                    </StackPanel>
                </ui:CardExpander>
                <ui:TextBlock Margin="0,0,0,12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding NumericValidationMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasNumericValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:CardExpander Margin="0,0,0,16" Header="{DynamicResource Loc.Workspace.Settings.Advanced}">
                        <StackPanel Margin="0,8,0,0">
                            <ui:TextBlock FontWeight="SemiBold" Text="{DynamicResource Loc.Workspace.Settings.File}" />
                            <ui:TextBlock Margin="0,4,0,0" Text="{Binding UserSettingsFile}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </ui:CardExpander>
            </StackPanel>
        </ui:DynamicScrollViewer>
        <controls:CommandStrip controls:FloatingNotificationChrome.IsBottomChrome="True" Grid.Row="1" Margin="0,12,0,0" Padding="12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="{Binding IsSaving}" Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button MinWidth="104" Margin="0,0,8,0" Command="{Binding ResetCommand}" Content="{DynamicResource Loc.Workspace.Settings.Reset}" ToolTip="{DynamicResource Loc.Workspace.Settings.Reset.Help}" ToolTipService.ShowOnDisabled="True" />
                    <ui:Button MinWidth="104" Appearance="Primary" Command="{Binding SaveCommand}" Content="{DynamicResource Loc.Workspace.Settings.Save}" ToolTip="{DynamicResource Loc.Workspace.Settings.Save.Help}" ToolTipService.ShowOnDisabled="True" Icon="{ui:SymbolIcon Symbol=Save16}" />
                </StackPanel>
            </Grid>
        </controls:CommandStrip>
    </controls:WorkspacePageFrame>
</Page>
