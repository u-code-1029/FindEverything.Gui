<Page x:Class="FindEverything.Desktop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Loc.Shell.Nav.Settings}" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.CanContentScroll="False">
    <controls:WorkspacePageFrame>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <controls:PageHeader Title="{DynamicResource Loc.Shell.Nav.Settings}" Description="{DynamicResource Loc.Workspace.Settings.Description}" />
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Style="{StaticResource FluentGutteredScrollViewerStyle}">
            <StackPanel HorizontalAlignment="Stretch" IsEnabled="{Binding IsEditable}" ToolTipService.ShowOnDisabled="True">
                <TextBlock Margin="0,0,0,8" Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.Workspace.Settings.Indexing}" />
                <controls:SettingRowCard Title="{DynamicResource Loc.Workspace.Settings.PageSize}" Description="{DynamicResource Loc.Workspace.Settings.PageSize.Help}">
                    <ui:TextBox HorizontalAlignment="Stretch" Text="{Binding SearchPageSizeText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.PageSize}" ToolTip="{DynamicResource Loc.Workspace.Settings.PageSize.Help}" />
                </controls:SettingRowCard>
                <controls:SettingRowCard Title="{DynamicResource Loc.Workspace.Settings.Throttle}" Description="{DynamicResource Loc.Workspace.Settings.Throttle.Help}">
                    <ui:TextBox HorizontalAlignment="Stretch" Text="{Binding MaxEntriesPerSecondText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.Throttle}" ToolTip="{DynamicResource Loc.Workspace.Settings.Throttle.Help}" />
                </controls:SettingRowCard>
                <controls:SettingRowCard Title="{DynamicResource Loc.Workspace.Settings.Delay}" Description="{DynamicResource Loc.Workspace.Settings.Delay.Help}">
                    <ui:TextBox HorizontalAlignment="Stretch" Text="{Binding DirectoryDelayMillisecondsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.Delay}" ToolTip="{DynamicResource Loc.Workspace.Settings.Delay.Help}" />
                </controls:SettingRowCard>
                <TextBlock Margin="0,4,0,12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding NumericValidationMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasNumericValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="0,8,0,8" Style="{StaticResource SectionTitleTextStyle}" Text="{DynamicResource Loc.Workspace.Settings.Appearance}" />
                <controls:SettingRowCard Title="{DynamicResource Loc.Workspace.Settings.Theme}" Description="{DynamicResource Loc.Workspace.Settings.Theme.Help}">
                    <ComboBox HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.Theme}" />
                </controls:SettingRowCard>
                <controls:SettingRowCard Title="{DynamicResource Loc.Workspace.Settings.Backdrop}" Description="{DynamicResource Loc.Workspace.Settings.Backdrop.Help}">
                    <ComboBox HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" ItemsSource="{Binding BackdropChoices}" SelectedItem="{Binding SelectedBackdrop}" AutomationProperties.Name="{DynamicResource Loc.Workspace.Settings.Backdrop}" />
                </controls:SettingRowCard>
                <controls:SettingRowCard Title="{DynamicResource Loc.Workspace.Settings.Language}" Description="{DynamicResource Loc.Workspace.Settings.Language.Help}">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{DynamicResource Loc.Workspace.Settings.Language.Action}" />
                </controls:SettingRowCard>
                <Expander Margin="0,8,0,0" Header="{DynamicResource Loc.Workspace.Settings.Advanced}">
                    <Border Margin="0,8,0,0" Style="{StaticResource FluentSurfaceStyle}">
                        <StackPanel><TextBlock FontWeight="SemiBold" Text="{DynamicResource Loc.Workspace.Settings.File}" /><TextBlock Margin="0,4,0,0" Text="{Binding UserSettingsFile}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <controls:CommandStrip Grid.Row="2" Margin="0,8,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button MinWidth="104" Margin="0,0,8,0" Command="{Binding ResetCommand}" Content="{DynamicResource Loc.Workspace.Settings.Reset}" ToolTip="{DynamicResource Loc.Workspace.Settings.Reset.Help}" ToolTipService.ShowOnDisabled="True" />
                    <ui:Button MinWidth="104" Appearance="Primary" Command="{Binding SaveCommand}" Content="{DynamicResource Loc.Workspace.Settings.Save}" ToolTip="{DynamicResource Loc.Workspace.Settings.Save.Help}" ToolTipService.ShowOnDisabled="True" Icon="{ui:SymbolIcon Symbol=Save16}" />
                </StackPanel>
            </Grid>
        </controls:CommandStrip>
    </controls:WorkspacePageFrame>
</Page>
