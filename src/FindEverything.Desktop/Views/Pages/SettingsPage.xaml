<Page
    x:Class="FindEverything.Desktop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="설정"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,0,32,32" MaxWidth="760" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:InfoBar
                Grid.Row="0"
                Margin="0,0,0,20"
                IsClosable="False"
                IsOpen="True"
                Message="{Binding StatusMessage}"
                Severity="{Binding StatusSeverity}"
                Title="사용자 설정" />

            <GroupBox Grid.Row="1" Header="인덱싱" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="검색 페이지 크기" />
                    <TextBox
                        Grid.Column="1"
                        Margin="8,4"
                        Text="{Binding SearchPageSize, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="초당 최대 항목 수" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="8,4"
                        Text="{Binding MaxEntriesPerSecond, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="디렉터리 지연 (ms)" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="8,4"
                        Text="{Binding DirectoryDelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="화면" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="테마" />
                    <ComboBox
                        Grid.Column="1"
                        Margin="8,4"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding ThemeChoices}"
                        SelectedItem="{Binding SelectedTheme}" />

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="창 배경 효과" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="8,4"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding BackdropChoices}"
                        SelectedItem="{Binding SelectedBackdrop}" />
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <TextBlock FontWeight="SemiBold" Text="사용자 설정 파일" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding UserSettingsFile}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <ui:Button
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Command="{Binding SaveCommand}"
                    Content="저장" />
                <ui:Button
                    MinWidth="96"
                    Appearance="Caution"
                    Command="{Binding ResetCommand}"
                    Content="기본값 복원" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
