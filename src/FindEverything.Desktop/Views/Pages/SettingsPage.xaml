<Page
    x:Class="FindEverything.Desktop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="설정"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingsSectionStyle" BasedOn="{StaticResource FluentSurfaceStyle}" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="ActionableInfoBarStyle" TargetType="ui:InfoBar">
            <Setter Property="IsOpen" Value="False" />
            <Setter Property="IsClosable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static ui:InfoBarSeverity.Warning}">
                    <Setter Property="IsOpen" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static ui:InfoBarSeverity.Error}">
                    <Setter Property="IsOpen" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,20,0,16">
            <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleTextStyle}" Text="설정" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource PageSubtitleTextStyle}"
                Text="파일 검색 성능과 앱의 모양을 내 환경에 맞게 조정합니다." />
        </StackPanel>

        <ui:InfoBar
            Grid.Row="1"
            Margin="0,0,0,16"
            Message="{Binding StatusMessage}"
            Severity="{Binding StatusSeverity}"
            Style="{StaticResource ActionableInfoBarStyle}"
            Title="설정을 확인해 주세요" />

        <ScrollViewer
            x:Name="SettingsScrollViewer"
            Grid.Row="2"
            Style="{StaticResource FluentGutteredScrollViewerStyle}">
            <StackPanel HorizontalAlignment="Stretch">
                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="검색과 인덱싱" />
                        <TextBlock
                            Margin="0,4,0,16"
                            Style="{StaticResource PageSubtitleTextStyle}"
                            Text="큰 디스크를 처리할 때 한 번에 읽는 양과 처리 속도를 조절합니다." />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="검색 페이지 크기" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="한 번의 검색 요청에서 읽어 올 최대 항목 수입니다." />
                        <TextBox
                            Margin="0,4,0,12"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="검색 페이지 크기"
                            Text="{Binding SearchPageSize, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="초당 최대 항목 수" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="인덱싱이 시스템 자원을 너무 많이 사용하지 않도록 처리량을 제한합니다." />
                        <TextBox
                            Margin="0,4,0,12"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="초당 최대 항목 수"
                            Text="{Binding MaxEntriesPerSecond, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="디렉터리 지연 (ms)" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="각 폴더를 읽는 사이에 적용할 지연 시간입니다." />
                        <TextBox
                            Margin="0,4,0,0"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="디렉터리 지연 시간"
                            Text="{Binding DirectoryDelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="화면" />
                        <TextBlock
                            Margin="0,4,0,16"
                            Style="{StaticResource PageSubtitleTextStyle}"
                            Text="Windows 설정과 어울리는 테마와 창 배경을 선택합니다." />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="테마" />
                        <ComboBox
                            Margin="0,4,0,12"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="앱 테마"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding ThemeChoices}"
                            SelectedItem="{Binding SelectedTheme}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="창 배경 효과" />
                        <ComboBox
                            Margin="0,4,0,0"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="창 배경 효과"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding BackdropChoices}"
                            SelectedItem="{Binding SelectedBackdrop}" />
                    </StackPanel>
                </Border>

                <Expander
                    Margin="0,0,0,16"
                    HorizontalContentAlignment="Stretch"
                    Header="고급 정보">
                    <Border Margin="0,8,0,0" Style="{StaticResource FluentSurfaceStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="사용자 설정 파일" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding UserSettingsFile}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,12,0,0"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="검색 위치와 인덱스 데이터베이스 경로는 파일 찾기 또는 구조화 보기에서 관리합니다." />
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="3"
            Margin="0,12,0,0"
            Style="{StaticResource FluentToolbarSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:ProgressRing
                        Width="20"
                        Height="20"
                        Margin="0,0,8,0"
                        IsIndeterminate="True"
                        Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding StatusMessage}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        MinWidth="104"
                        Margin="0,0,8,0"
                        Appearance="Caution"
                        Command="{Binding ResetCommand}"
                        Content="기본값 복원" />
                    <ui:Button
                        MinWidth="96"
                        Appearance="Primary"
                        Command="{Binding SaveCommand}"
                        Content="저장"
                        Icon="{ui:SymbolIcon Symbol=Save16}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
