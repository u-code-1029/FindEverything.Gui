<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(RuntimeIdentifier)' == ''">false</WindowsAppSDKSelfContained>
    <WindowsAppSDKSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</WindowsAppSDKSelfContained>
    <!-- A portable AnyCPU build has no native App SDK payload. Prevent the
         framework-dependent module initializer from terminating the process on
         machines without an installed Windows App Runtime; the hosted service
         will simply report notifications as unavailable. RID publishes bundle
         the payload and use the self-contained initializer instead. -->
    <WindowsAppSdkBootstrapInitialize Condition="'$(RuntimeIdentifier)' == ''">false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>
    <!-- This is a WPF app and is not published with NativeAOT. Disabling the
         CsWinRT AOT optimizer avoids treating every MVVM field-backed generated
         property as a WinRT ABI surface while retaining the normal projections
         used by Windows App SDK notifications. -->
    <CsWinRTAotOptimizerEnabled>false</CsWinRTAotOptimizerEnabled>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>FindEverything.Gui</AssemblyName>
    <RootNamespace>FindEverything.Desktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FindEverything.Desktop.Tests" />
    <ProjectReference Include="../FindEverything.Application/FindEverything.Application.csproj" />
    <ProjectReference Include="../FindEverything.Infrastructure.FindEverything/FindEverything.Infrastructure.FindEverything.csproj" />
    <ProjectReference Include="../FindEverything.Profile.Runtime/FindEverything.Profile.Runtime.csproj" />
    <ProjectReference Include="../../samples/FindEverything.Profiles.SampleProjects/FindEverything.Profiles.SampleProjects.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" GeneratePathProperty="true" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="WPF-UI.DependencyInjection" />
  </ItemGroup>

  <ItemGroup Condition="'$(PkgMicrosoft_WindowsAppSDK_Runtime)' != ''">
    <Content
      Include="$(PkgMicrosoft_WindowsAppSDK_Runtime)/license.txt"
      Link="WINDOWS-APP-SDK-LICENSE.txt"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
    <Content
      Include="$(PkgMicrosoft_WindowsAppSDK_Runtime)/NOTICE.txt"
      Link="WINDOWS-APP-SDK-NOTICES.txt"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Include="../../samples/SampleData/sample-projects/**/*">
      <Link>SampleData/sample-projects/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Include="../../THIRD-PARTY-NOTICES.md"
          Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopySampleProfileToDesktopOutput" AfterTargets="Build">
    <ItemGroup>
      <SampleProfilePackage Include="$(MSBuildProjectDirectory)/../../Profiles/sample-projects/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(SampleProfilePackage)"
          DestinationFiles="@(SampleProfilePackage->'$(OutDir)Profiles/sample-projects/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopySampleProfileToDesktopPublish"
          AfterTargets="Publish"
          Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <SampleProfilePublishPackage Include="$(MSBuildProjectDirectory)/../../Profiles/sample-projects/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(SampleProfilePublishPackage)"
          DestinationFiles="@(SampleProfilePublishPackage->'$(PublishDir)Profiles/sample-projects/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
