<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:FindEverything.Desktop.Views.Controls">

    <!-- WPF-UI 4.3's TabView classes are empty TabControl/TabItem subclasses.
         Its Fluent templates are keyed to the base types; explicitly bridge
         those styles so the UI namespace does not fall back to OS chrome. -->
    <Style TargetType="ui:TabView" BasedOn="{StaticResource {x:Type TabControl}}" />
    <Style TargetType="ui:TabViewItem" BasedOn="{StaticResource {x:Type TabItem}}" />
    <Style TargetType="ui:TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}" />

    <!-- Read-only grid cells retain the real TextBox text editor/automation but
         do not need an editor card, icons, placeholder, buttons or scrollbars.
         Do not base this style on DefaultUiTextBoxStyle: its template triggers
         would reinstate the wrapped editor template for selectable text.
         The native hit/focus surface remains present, but its text view is not
         measured while idle: the overlay TextBlock already renders that text. -->
    <Style x:Key="CatalogReadOnlyContentHostStyle" TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                        CanContentScroll="{TemplateBinding CanContentScroll}"
                        Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        Margin="{TemplateBinding Padding}" ClipToBounds="True"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CatalogReadOnlyTextBoxStyle" TargetType="ui:TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsUndoEnabled" Value="False" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="PlaceholderEnabled" Value="False" />
        <Setter Property="ClearButtonEnabled" Value="False" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
        <Setter Property="SelectionOpacity" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- Keep the real TextBox as the native input and automation
                     target, but do not instantiate its text view until input. -->
                <ControlTemplate TargetType="ui:TextBox">
                    <Border x:Name="PART_InputSurface" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="CatalogReadOnlyTextBoxActiveTemplate" TargetType="ui:TextBox">
        <!-- This drawing is the native editor's hit surface while its expensive
             text view is collapsed, not an editor card. -->
        <Border x:Name="PART_InputSurface" Background="{TemplateBinding Background}">
            <ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource CatalogReadOnlyContentHostStyle}"
                CanContentScroll="True" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                Visibility="Collapsed"
                Focusable="False" IsTabStop="False" Background="{TemplateBinding Background}"
                TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseCaptured" Value="True">
                <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsStylusOver" Value="True">
                <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="AreAnyTouchesOver" Value="True">
                <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="AreAnyTouchesCaptured" Value="True">
                <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Keep WPF-UI's native card template and theme states. Editor groups use
         Header (the stretching column) rather than the auto-width action slot.
         Their nested editors remain keyboard-focusable, but the passive card
         itself must not become an extra button in the tab sequence. -->
    <Style x:Key="FluentCardStyle" TargetType="ui:CardControl" BasedOn="{StaticResource DefaultUiCardControlStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource SurfaceCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <Style x:Key="FluentToolbarCardStyle" TargetType="ui:CardControl" BasedOn="{StaticResource FluentCardStyle}">
        <Setter Property="Padding" Value="{StaticResource ToolbarPadding}" />
    </Style>

    <!-- A small family of surfaces communicates purpose without adding
         effects, animation, or new visuals to each virtualized result row. -->
    <Style x:Key="WorkspaceToolbarCardStyle" TargetType="ui:CardControl" BasedOn="{StaticResource FluentCardStyle}">
        <Setter Property="Padding" Value="{StaticResource WorkspaceToolbarPadding}" />
    </Style>
    <Style x:Key="WorkspaceResultCardStyle" TargetType="ui:CardControl" BasedOn="{StaticResource FluentCardStyle}">
        <Setter Property="Padding" Value="{StaticResource WorkspaceResultPadding}" />
    </Style>
    <Style x:Key="WorkspaceActionCardStyle" TargetType="ui:CardControl" BasedOn="{StaticResource FluentCardStyle}">
        <Setter Property="Padding" Value="{StaticResource WorkspaceActionPadding}" />
    </Style>

    <Style x:Key="FluentSectionCardStyle" TargetType="ui:CardControl" BasedOn="{StaticResource FluentCardStyle}" />
    <Style TargetType="controls:SectionCard" BasedOn="{StaticResource FluentCardStyle}" />

    <Style x:Key="FluentEmptyStateStyle" TargetType="ui:CardControl" BasedOn="{StaticResource FluentCardStyle}">
        <Setter Property="MinHeight" Value="240" />
        <Setter Property="Padding" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- Use WPF-UI's keyed row base: it does not publish an implicit DataGridRow style. -->
    <Style x:Key="FluentResultRowStyle" BasedOn="{StaticResource DefaultDataGridRowStyle}" TargetType="DataGridRow">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></SelectiveScrollingGrid.ColumnDefinitions>
                            <SelectiveScrollingGrid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></SelectiveScrollingGrid.RowDefinitions>
                            <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <DataGridDetailsPresenter Grid.Row="1" Grid.Column="1" Visibility="{TemplateBinding DetailsVisibility}" SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <DataGridRowHeader Grid.RowSpan="2" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical" Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </SelectiveScrollingGrid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="FluentSearchBoxStyle"
        BasedOn="{StaticResource {x:Type ui:TextBox}}"
        TargetType="ui:TextBox">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Border.CornerRadius" Value="{StaticResource WorkspaceControlCornerRadius}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="FluentDataGridStyle"
        BasedOn="{StaticResource {x:Type DataGrid}}"
        TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="RowHeight" Value="40" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style x:Key="CatalogUserInputTextBoxStyle" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="ClearButtonEnabled" Value="True" />
        <Setter Property="MinHeight" Value="32" />
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True"><Setter Property="ClearButtonEnabled" Value="False" /></Trigger>
        </Style.Triggers>
    </Style>

    <!--
        WPF-UI renders a deliberately compact vertical scrollbar.  Give it a
        dedicated content gutter so text fields and cards never sit underneath
        the thumb, including at narrow window sizes.

        This style is intentionally keyed: DataGrid owns its own scrollbar
        column and must not receive a second gutter.
    -->
    <Style
        x:Key="FluentGutteredScrollViewerStyle"
        BasedOn="{StaticResource {x:Type ScrollViewer}}"
        TargetType="ScrollViewer">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="0,0,16,0" />
    </Style>
    <Style x:Key="WorkspacePageHeaderStyle" TargetType="controls:PageHeader">
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PageHeader">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{TemplateBinding Title}" AutomationProperties.HeadingLevel="Level1" />
                            <ui:Button x:Name="HelpButton" Margin="8,0,0,0" Width="28" Height="28" Padding="0" Appearance="Transparent" BorderThickness="0" Icon="{ui:SymbolIcon Symbol=QuestionCircle20}"
                                AutomationProperties.Name="{TemplateBinding Description}" ToolTip="{TemplateBinding Description}" ToolTipService.ShowOnDisabled="True" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WorkspaceCommandStripStyle" TargetType="controls:CommandStrip">
        <Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="{StaticResource SectionMargin}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CommandStrip">
                    <controls:SectionCard Style="{StaticResource WorkspaceToolbarCardStyle}" Padding="{TemplateBinding Padding}">
                        <controls:SectionCard.Header>
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch" />
                        </controls:SectionCard.Header>
                    </controls:SectionCard>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WorkspaceDisplayBadgeStyle" TargetType="controls:DisplayBadge">
        <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DisplayBadge">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WorkspaceSettingRowStyle" TargetType="controls:SettingRowCard">
        <Setter Property="Margin" Value="0,0,0,8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingRowCard">
                    <controls:SectionCard Style="{StaticResource FluentCardStyle}">
                        <controls:SectionCard.Header>
                          <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.45*" /><ColumnDefinition Width="0.55*" /></Grid.ColumnDefinitions>
                            <StackPanel x:Name="DescriptionPanel" Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Text="{TemplateBinding Description}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <ContentPresenter x:Name="Editor" Grid.Column="1" VerticalAlignment="Center" Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" />
                          </Grid>
                        </controls:SectionCard.Header>
                    </controls:SectionCard>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="DescriptionPanel" Property="Grid.ColumnSpan" Value="2" /><Setter TargetName="DescriptionPanel" Property="Margin" Value="0,0,0,12" />
                            <Setter TargetName="Editor" Property="Grid.Column" Value="0" /><Setter TargetName="Editor" Property="Grid.Row" Value="1" /><Setter TargetName="Editor" Property="Grid.ColumnSpan" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
