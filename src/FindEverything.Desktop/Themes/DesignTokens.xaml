<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Fluent UI React's spacing ramp, expressed in device-independent pixels.
         Size tokens are separate: density does not change the spacing policy. -->
    <sys:Double x:Key="SpacingNone">0</sys:Double>
    <sys:Double x:Key="SpacingXXS">2</sys:Double>
    <sys:Double x:Key="SpacingXS">4</sys:Double>
    <sys:Double x:Key="SpacingSNudge">6</sys:Double>
    <sys:Double x:Key="SpacingS">8</sys:Double>
    <sys:Double x:Key="SpacingMNudge">10</sys:Double>
    <sys:Double x:Key="SpacingM">12</sys:Double>
    <sys:Double x:Key="SpacingL">16</sys:Double>
    <sys:Double x:Key="SpacingXL">20</sys:Double>
    <sys:Double x:Key="SpacingXXL">24</sys:Double>
    <sys:Double x:Key="SpacingXXXL">32</sys:Double>

    <Thickness x:Key="PagePadding">24,0,24,16</Thickness>
    <Thickness x:Key="CompactPagePadding">16,0,16,16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ToolbarPadding">12</Thickness>
    <Thickness x:Key="ControlGap">0,0,8,0</Thickness>
    <Thickness x:Key="SectionGap">0,0,0,16</Thickness>
    <Thickness x:Key="SectionMargin">0,0,0,8</Thickness>
    <Thickness x:Key="LabelGap">0,0,0,4</Thickness>
    <Thickness x:Key="RelatedControlGap">0,0,0,8</Thickness>
    <Thickness x:Key="CatalogPagePadding">24,0,24,8</Thickness>
    <Thickness x:Key="CompactCatalogPagePadding">16,0,16,8</Thickness>
    <sys:Double x:Key="CatalogRowHeight">44</sys:Double>
    <Thickness x:Key="CatalogRowMargin">0,2,0,2</Thickness>
    <Thickness x:Key="CatalogCellPadding">12,4,12,4</Thickness>
    <Thickness x:Key="CatalogEditorMargin">4,2,4,2</Thickness>
    <CornerRadius x:Key="SurfaceCornerRadius">8</CornerRadius>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
