{
  "contractVersion": 2,
  "kind": "Declarative",
  "id": "text-file-metadata",
  "version": "1.0.0",
  "displayName": "Text-file metadata sample",
  "fields": [
    {
      "fieldId": "project",
      "groupName": "project",
      "header": "Project",
      "order": 10,
      "required": true,
      "kind": "String"
    }
  ],
  "textFileFields": [
    {
      "fieldId": "description",
      "header": "Description",
      "order": 20,
      "required": false,
      "fileNamePattern": "^description\\.txt$",
      "matchMode": "Full",
      "ignoreCase": true,
      "timeoutMilliseconds": 100,
      "maxBytes": 262144
    }
  ],
  "candidateKind": "Directory",
  "rules": [
    {
      "id": "project-folder",
      "pattern": "(?:^|[\\\\/])TextFileProjects[\\\\/](?<project>[^\\\\/]+)$",
      "matchMode": "Partial",
      "ignoreCase": true,
      "timeoutMilliseconds": 100
    }
  ]
}
