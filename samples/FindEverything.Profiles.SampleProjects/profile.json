{
  "contractVersion": 1,
  "id": "sample-projects",
  "version": "1.0.0",
  "displayName": "샘플 프로젝트 폴더",
  "entryAssembly": "FindEverything.Profiles.SampleProjects.dll",
  "modelType": "FindEverything.Profiles.SampleProjects.SampleProjectItem",
  "candidateKind": "Directory",
  "pathInput": "Relative",
  "rules": [
    {
      "id": "standard-project-folder",
      "pattern": "^Clients\\\\(?<customer>[^\\\\]+)\\\\Projects\\\\(?<project>[^\\\\]+)\\\\(?<year>\\d{4})(?:\\\\(?<capturedOn>\\d{8}))?(?:\\\\Rev-(?<revision>\\d+))?(?:\\\\Approved-(?<approved>true|false))?(?:\\\\Amount-(?<amount>-?\\d+(?:\\.\\d+)?))?$",
      "matchMode": "Full",
      "ignoreCase": true,
      "timeoutMilliseconds": 100
    }
  ]
}
